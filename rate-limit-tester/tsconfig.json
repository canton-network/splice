{
  "compilerOptions": {
    "target": "es2020",
    // `dom` only for the `console` global, which k6 provides but @types/k6 does not declare.
    "lib": ["es2020", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "types": ["k6", "node"]
  },
  "include": ["src/**/*.ts"]
}
