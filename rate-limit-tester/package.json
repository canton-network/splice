{
  "name": "@canton-network/splice-rate-limit-tester",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "k6 based checks that the Envoy rate limits configured in a cluster config are enforced",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --disable-warning=ExperimentalWarning 'src/*.test.ts'",
    "fix": "prettier --write .",
    "build": "tsc --noEmit",
    "start": "k6 run src/main.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/k6": "^1.3.0",
    "@types/node": "^22.20.3"
  }
}
