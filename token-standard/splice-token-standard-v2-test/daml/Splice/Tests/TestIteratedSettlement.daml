-- | Daml script testing iterated settlement directly.
module Splice.Tests.TestIteratedSettlement where

import Daml.Script

import DA.Action
import DA.Assert
import DA.Foldable (forA_)
import DA.Map qualified as Map
import DA.Time
import DA.TextMap qualified as TextMap
import DA.Text qualified as T

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as V2

import Splice.TokenStandard.Utils

import Splice.Testing.Utils
import Splice.Testing.Registries.AmuletRegistryV2 qualified as AmuletRegistryV2
import Splice.Testing.Registries.TestTokenV2_RegistryV2 qualified as TestTokenV2_RegistryV2
import Splice.Testing.Registries.TestRegistries qualified as TestRegistries
import Splice.Testing.TokenStandard.MultiRegistry qualified as MultiRegistry
import Splice.Testing.TokenStandard.RegistryApiV2 qualified as V2
import Splice.Testing.TokenStandard.WalletClientV2 qualified as WalletClientV2


-- Amulet and TestTokenV2 tests
-------------------------------

amulet_test_locked_funds : Script ()
amulet_test_locked_funds = mkAmuletTestCase >>= test_locked_funds

amulet_test_refresh_and_withdrawal : Script ()
amulet_test_refresh_and_withdrawal = mkAmuletTestCase >>= test_refresh_and_withdrawal

amulet_test_zero_funding : Script ()
amulet_test_zero_funding = mkAmuletTestCase >>= test_zero_funding False

-- | Amulet treats an empty `nextIterationFunding` map as allowing Amulet, which
-- keeps allocations working that were created before `{"Amulet": 0.0}` could be settled.
amulet_test_zero_funding_emptyMap : Script ()
amulet_test_zero_funding_emptyMap = mkAmuletTestCase >>= test_zero_funding True


testTokenV2_test_locked_funds : Script ()
testTokenV2_test_locked_funds = mkTestTokenV2TestCase >>= test_locked_funds

testTokenV2_test_refresh_and_withdrawal : Script ()
testTokenV2_test_refresh_and_withdrawal = mkTestTokenV2TestCase >>= test_refresh_and_withdrawal

testTokenV2_test_allowed_instruments : Script ()
testTokenV2_test_allowed_instruments = mkTestTokenV2TestCase >>= test_allowed_instruments

testTokenV2_test_zero_funding : Script ()
testTokenV2_test_zero_funding = mkTestTokenV2TestCase >>= test_zero_funding False

mkAmuletTestCase : Script TestCase
mkAmuletTestCase = do
  env <- TestRegistries.initialize TestRegistries.defaultConfig
  provider <- allocateParty "provider"
  alice <- allocateParty "alice"
  let instrId = env.amuletV2.instrumentId
  let admin = instrId.admin
  AmuletRegistryV2.tapFaucet env.amuletV2 alice 1000.0
  registry <- MultiRegistry.getRegistryApiV2 env.registries admin
  pure TestCase with
    admins = Map.keys env.registries
    provider
    alice
    instrIds = [instrId]
    registry
    admin
    env

mkTestTokenV2TestCase : Script TestCase
mkTestTokenV2TestCase = do
  env <- TestRegistries.initialize TestRegistries.defaultConfig
  provider <- allocateParty "provider"
  alice <- allocateParty "alice"
  let admin = env.testTokenV2.admin
  let xId = V2.InstrumentId with
        id = "X"
        admin
  let yId = V2.InstrumentId with
        id = "Y"
        admin
  TestTokenV2_RegistryV2.mint env.testTokenV2 (basicAccount alice) "X" 1000.0
  TestTokenV2_RegistryV2.mint env.testTokenV2 (basicAccount alice) "Y" 1000.0
  registry <- MultiRegistry.getRegistryApiV2 env.registries admin
  pure TestCase with
    admins = Map.keys env.registries
    provider
    alice
    instrIds = [xId, yId]
    registry
    admin
    env


-- Generic test infra
---------------------

data TestCase = TestCase with
  admins : [Party]
  provider : Party
  admin : Party
  alice : Party
  instrIds : [V2.InstrumentId]
  registry : V2.GenericRegistry
  env : TestRegistries.Env

-- | Test that an iterated allocation can be used to control locked funds.
-- The test uses a simplified billing workflow as an example.
test_locked_funds : TestCase -> Script ()
test_locked_funds TestCase {..} = do
   -- create prefunded allocation
  let settlement = V2.SettlementInfo with
        executors = [provider]
        id = "billing/<uuid>"
        cid = None
        meta = emptyMetadata
  let alloc = V2.AllocationSpecification with
        authorizer = basicAccount alice
        admin
        transferLegSides = []
        settlementDeadline = None
        nextIterationFunding = Some (TextMap.fromList [(instrId.id, 100.0) | instrId <- instrIds])
        committed = True
        meta = reasonToMeta "fund regular billing" emptyMetadata
  now <- getTime
  inputHoldingCids <- fmap concat $ forA instrIds $ \instrId -> WalletClientV2.listHoldingCids alice instrId
  enrichedChoice <- V2.getAllocationFactory registry V2.AllocationFactory_Allocate with
    settlement
    allocation = alloc
    requestedAt = now
    inputHoldingCids
    actors = [alice]
    extraArgs = emptyExtraArgs

  result <- WalletClientV2.submitAndCheckTxHistory admins (actAs alice <> discloseMany' enrichedChoice.disclosures) $
    exerciseCmd enrichedChoice.factoryCid enrichedChoice.arg
  let V2.AllocationInstructionResult_Completed aliceAllocationCid = result.output

  forA_ instrIds $ \instrId -> WalletClientV2.checkUnlockedBalance alice instrId 900.0

  -- check that allocation metadata is passed on
  Some aliceAllocView <- queryInterfaceContractId alice aliceAllocationCid
  aliceAllocView.allocation.meta === reasonToMeta "fund regular billing" emptyMetadata

  -- provider creates allocation to accept license fee payment
  let billingLegs = do
        (i, instrId) <- zip [0 .. length instrIds] instrIds
        pure V2.TransferLeg with
              transferLegId = "billing-leg-" <> show i
              sender = basicAccount alice
              receiver = basicAccount provider
              amount = 0.5
              instrumentId = instrId.id
              meta = reasonToMeta "daily license fee" emptyMetadata
  enrichedChoice <- V2.getAllocationFactory registry V2.AllocationFactory_Allocate with
    settlement
    allocation = V2.AllocationSpecification with
      authorizer = basicAccount provider
      admin
      transferLegSides = map receiverSide billingLegs
      settlementDeadline = None
      nextIterationFunding = None
      committed = False
      meta = emptyMetadata
    requestedAt = now
    inputHoldingCids = []
    actors = [provider]
    extraArgs = emptyExtraArgs
  result <- WalletClientV2.submitAndCheckTxHistory admins (actAs provider <> discloseMany' enrichedChoice.disclosures) $
    exerciseCmd enrichedChoice.factoryCid enrichedChoice.arg
  let V2.AllocationInstructionResult_Completed providerAllocationCid = result.output

  -- provider settles billing against prefunded allocation
  now <- getTime
  enrichedChoice <- V2.getSettlementFactory registry V2.SettlementFactory_SettleBatch with
    actors = [provider]
    settlement
    transferLegs = billingLegs
    allocations =
      [ nonIteratedAllocation providerAllocationCid
      , V2.FinalizedAllocation with
          allocationCid = aliceAllocationCid
          extraTransferLegSides = map senderSide billingLegs
          nextIterationFunding = Some (TextMap.fromList [(instrId.id, 99.0) | instrId <- instrIds])
      ]
    extraArgs = emptyExtraArgs

  result <- WalletClientV2.submitAndCheckTxHistory admins (actAs provider <> discloseMany' enrichedChoice.disclosures) $
    exerciseCmd enrichedChoice.factoryCid enrichedChoice.arg
  let [_, settleResult] = result.allocationSettleResults
  let Some aliceAllocationCid = WalletClientV2.extractNextIterationAllocationCid settleResult

  -- payout of 0.5 Amulet to alice, and 0.5 Amulet to the provider
  forA_ instrIds $ \instrId -> do
    WalletClientV2.checkUnlockedBalance alice instrId 900.5
    WalletClientV2.checkUnlockedBalance provider instrId 0.5

  -- test a top-up via a self-transfer
  let topupLegs = do
        (i, instrId) <- zip [0 .. length instrIds] instrIds
        pure V2.TransferLeg with
          transferLegId = "topup-leg-" <> show i
          sender = basicAccount alice
          receiver = basicAccount alice
          amount = 200.0
          instrumentId = instrId.id
          meta = reasonToMeta "topup funds for fee payments" emptyMetadata
  inputHoldingCids <- fmap concat $ forA instrIds $ \instrId ->
    WalletClientV2.listUnlockedHoldingCidsFor (basicAccount alice) alice instrId
  enrichedChoice <- V2.getAllocationFactory registry V2.AllocationFactory_Allocate with
    settlement
    allocation = V2.AllocationSpecification with
      authorizer = basicAccount alice
      admin
      transferLegSides = map senderSide topupLegs -- This is key: here we approve the sender-side, which locks the funds
      settlementDeadline = None
      nextIterationFunding = None
      committed = False
      meta = emptyMetadata
    requestedAt = now
    inputHoldingCids = inputHoldingCids
    actors = [alice]
    extraArgs = emptyExtraArgs
  result <- WalletClientV2.submitAndCheckTxHistory admins (actAs alice <> discloseMany' enrichedChoice.disclosures) $
    exerciseCmd enrichedChoice.factoryCid enrichedChoice.arg
  let V2.AllocationInstructionResult_Completed topupAllocationCid = result.output

  -- execute the top-up of alice's two allocations using batch settlement
  enrichedChoice <- V2.getSettlementFactory registry V2.SettlementFactory_SettleBatch with
    actors = [provider]
    settlement
    transferLegs = topupLegs
    allocations =
      [ nonIteratedAllocation topupAllocationCid
      , V2.FinalizedAllocation with
          allocationCid = aliceAllocationCid
          extraTransferLegSides = map receiverSide topupLegs
          nextIterationFunding = Some (TextMap.fromList [(instrId.id, 299.0) | instrId <- instrIds])
      ]
    extraArgs = emptyExtraArgs
  result <- WalletClientV2.submitAndCheckTxHistory admins (actAs provider <> discloseMany' enrichedChoice.disclosures) $
    exerciseCmd enrichedChoice.factoryCid enrichedChoice.arg
  let [_, settleResult] = result.allocationSettleResults
  let Some aliceAllocationCid = WalletClientV2.extractNextIterationAllocationCid settleResult

  -- there is exactly one allocation for alice
  [(cid, Some aliceAllocView)] <- queryInterface @V2.Allocation alice
  cid === aliceAllocationCid
  aliceAllocView.allocation.nextIterationFunding === Some (TextMap.fromList [(instrId.id, 299.0) | instrId <- instrIds])
  aliceAllocView.allocation.transferLegSides === []

  forA_ instrIds $ \instrId -> do
    -- there is one locked holding for alice
    [(_, holding)] <- WalletClientV2.listLockedHoldings alice instrId
    holding.amount === 299.0

    -- the balances are as expected
    WalletClientV2.checkBalance alice instrId 999.5
    WalletClientV2.checkBalance provider instrId 0.5

  pure ()


-- | Infrastructure for testing payments from alice to the provider, which the
-- provider receives using an iterated allocation.
data PaymentsEnv = PaymentsEnv with
  createProviderAllocation : Optional (TextMap.TextMap Decimal) -> Script (ContractId V2.Allocation, V2.AllocationView)
  allocatePayment : Text -> V2.InstrumentId -> Script (V2.TransferLeg, ContractId V2.Allocation)
    -- ^ Allocate a payment by alice with the given transfer leg id and instrument.
  settle : ContractId V2.Allocation -> [(V2.TransferLeg, ContractId V2.Allocation)] -> Optional (TextMap.TextMap Decimal) -> Script (EnrichedFactoryChoice V2.SettlementFactory V2.SettlementFactory_SettleBatch)
    -- ^ Prepare the settlement of the payments against the provider's allocation.
  settleAndGetNext : ContractId V2.Allocation -> [(V2.TransferLeg, ContractId V2.Allocation)] -> Optional (TextMap.TextMap Decimal) -> Script (ContractId V2.Allocation, V2.AllocationView)
    -- ^ Settle the payments and return the provider's allocation for the next iteration.

mkPaymentsEnv : TestCase -> Script PaymentsEnv
mkPaymentsEnv TestCase {..} = do
  now <- getTime
  let settlement = V2.SettlementInfo with
        executors = [provider]
        id = "payments/<uuid>"
        cid = None
        meta = emptyMetadata
  let createProviderAllocation nextIterationFunding = do
        enrichedChoice <- V2.getAllocationFactory registry V2.AllocationFactory_Allocate with
          settlement
          allocation = V2.AllocationSpecification with
            authorizer = basicAccount provider
            admin
            transferLegSides = []
            settlementDeadline = None
            nextIterationFunding
            committed = False
            meta = emptyMetadata
          requestedAt = now
          inputHoldingCids = []
          actors = [provider]
          extraArgs = emptyExtraArgs
        result <- WalletClientV2.submitAndCheckTxHistory admins (actAs provider <> discloseMany' enrichedChoice.disclosures) $
          exerciseCmd enrichedChoice.factoryCid enrichedChoice.arg
        let V2.AllocationInstructionResult_Completed allocationCid = result.output
        Some allocView <- queryInterfaceContractId provider allocationCid
        pure (allocationCid, allocView)
  let allocatePayment legId instrId = do
        let leg = V2.TransferLeg with
              transferLegId = legId
              sender = basicAccount alice
              receiver = basicAccount provider
              amount = 1.0
              instrumentId = instrId.id
              meta = emptyMetadata
        inputHoldingCids <- WalletClientV2.listHoldingCids alice instrId
        enrichedChoice <- V2.getAllocationFactory registry V2.AllocationFactory_Allocate with
          settlement
          allocation = V2.AllocationSpecification with
            authorizer = basicAccount alice
            admin
            transferLegSides = [senderSide leg]
            settlementDeadline = None
            nextIterationFunding = None
            committed = False
            meta = emptyMetadata
          requestedAt = now
          inputHoldingCids
          actors = [alice]
          extraArgs = emptyExtraArgs
        result <- WalletClientV2.submitAndCheckTxHistory admins (actAs alice <> discloseMany' enrichedChoice.disclosures) $
          exerciseCmd enrichedChoice.factoryCid enrichedChoice.arg
        let V2.AllocationInstructionResult_Completed allocationCid = result.output
        pure (leg, allocationCid)
  let settle providerCid payments nextIterationFunding = do
        let legs = map fst payments
        V2.getSettlementFactory registry V2.SettlementFactory_SettleBatch with
          actors = [provider]
          settlement
          transferLegs = legs
          allocations =
            V2.FinalizedAllocation with
                allocationCid = providerCid
                extraTransferLegSides = map receiverSide legs
                nextIterationFunding
            :: map (nonIteratedAllocation . snd) payments
          extraArgs = emptyExtraArgs
  let settleAndGetNext providerCid payments nextIterationFunding = do
        enrichedChoice <- settle providerCid payments nextIterationFunding
        result <- WalletClientV2.submitAndCheckTxHistory admins (actAs provider <> discloseMany' enrichedChoice.disclosures) $
          exerciseCmd enrichedChoice.factoryCid enrichedChoice.arg
        let providerSettleResult :: _ = result.allocationSettleResults
        let Some nextProviderCid = WalletClientV2.extractNextIterationAllocationCid providerSettleResult
        Some nextProviderAllocView <- queryInterfaceContractId provider nextProviderCid
        pure (nextProviderCid, nextProviderAllocView)
  pure PaymentsEnv with ..

-- | Test that the instrument ids in an allocation's `nextIterationFunding` limit
-- the instruments that the executors can use in iterated settlement, and that
-- the executors can narrow but not widen that set.
--
-- Requires a registry with two instruments.
test_allowed_instruments : TestCase -> Script ()
test_allowed_instruments testCase@TestCase {..} = do
  let [xId, yId] = instrIds
  let allowXY = Some (TextMap.fromList [(xId.id, 0.0), (yId.id, 0.0)])
  let allowX = Some (TextMap.fromList [(xId.id, 0.0)])
  PaymentsEnv {..} <- mkPaymentsEnv testCase

  -- the provider allows receiving payments in X and Y, without reserving any funds
  (providerCid, providerView) <- createProviderAllocation allowXY
  providerView.allocation.nextIterationFunding === allowXY

  -- the executors settle a payment in Y and narrow the allowed instruments to X
  paymentY1 <- allocatePayment "payment-y1" yId
  (providerCid, providerView) <- settleAndGetNext providerCid [paymentY1] allowX
  WalletClientV2.checkBalance provider yId 1.0
  providerView.allocation.nextIterationFunding === allowX

  -- payments in Y are now rejected
  paymentY2 <- allocatePayment "payment-y2" yId
  enrichedChoice <- settle providerCid [paymentY2] allowX
  submitMustFail''
    (expectMessageContains "'finalizedAllocation.extraTransferLegSides.instrumentId' is not a member of 'allowed instrument ids'")
    (actAs provider <> discloseMany' enrichedChoice.disclosures) $
      exerciseCmd enrichedChoice.factoryCid enrichedChoice.arg

  -- the executors cannot widen the allowed instruments again
  paymentX <- allocatePayment "payment-x" xId
  enrichedChoice <- settle providerCid [paymentX] allowXY
  submitMustFail''
    (expectMessageContains "'finalizedAllocation.nextIterationFunding.instrumentId' is not a member of 'allowed instrument ids'")
    (actAs provider <> discloseMany' enrichedChoice.disclosures) $
      exerciseCmd enrichedChoice.factoryCid enrichedChoice.arg

  -- payments in X still settle, and the limit is kept for the next iteration
  (_, providerView) <- settleAndGetNext providerCid [paymentX] allowX
  WalletClientV2.checkBalance provider xId 1.0
  providerView.allocation.nextIterationFunding === allowX

-- | Test that a funding amount of `0.0` allows receiving an instrument without
-- reserving funds for it.
--
-- If `useEmptyMap` is set, the authorizer uses an empty `nextIterationFunding`
-- map instead, which only single-instrument registries like Amulet treat as
-- allowing their instrument.
test_zero_funding : Bool -> TestCase -> Script ()
test_zero_funding useEmptyMap testCase@TestCase {..} = do
  let instrId :: _ = instrIds
  let allowInstr = Some (TextMap.fromList [(instrId.id, 0.0)])
  PaymentsEnv {..} <- mkPaymentsEnv testCase

  (providerCid, providerView) <- createProviderAllocation (if useEmptyMap then Some TextMap.empty else allowInstr)
  -- the allocation reports the allowed instruments explicitly
  providerView.allocation.nextIterationFunding === allowInstr

  payment <- allocatePayment "payment" instrId
  (_, providerView) <- settleAndGetNext providerCid [payment] allowInstr
  WalletClientV2.checkBalance provider instrId 1.0
  providerView.allocation.nextIterationFunding === allowInstr


-- | Test that refresh on settlement and withdrawal of iterated allocations works as expected.
test_refresh_and_withdrawal : TestCase -> Script ()
test_refresh_and_withdrawal TestCase {..} = do
  -- create an allocation for iterated settlement with a settlement deadline in one year
  now <- getTime
  let aliceSettlementDeadline = addRelTime now (days 365)
  let settlement = V2.SettlementInfo with
        executors = [provider]
        id = "billing/<uuid>"
        cid = None
        meta = emptyMetadata
  let alloc = V2.AllocationSpecification with
        authorizer = basicAccount alice
        admin
        transferLegSides = []
        settlementDeadline = Some aliceSettlementDeadline
        nextIterationFunding = Some TextMap.empty
        committed = True
        meta = reasonToMeta "fund regular billing" emptyMetadata
  inputHoldingCids <- fmap concat $ forA instrIds $ \instrId ->
    WalletClientV2.listHoldingCids alice instrId
  enrichedChoice <- V2.getAllocationFactory registry V2.AllocationFactory_Allocate with
    settlement
    allocation = alloc
    requestedAt = now
    inputHoldingCids
    actors = [alice]
    extraArgs = emptyExtraArgs
  result <- WalletClientV2.submitAndCheckTxHistory admins (actAs alice <> discloseMany' enrichedChoice.disclosures) $
    exerciseCmd enrichedChoice.factoryCid enrichedChoice.arg
  let V2.AllocationInstructionResult_Completed aliceAllocationCid0 = result.output
  Some aliceAllocView0 <- queryInterfaceContractId alice aliceAllocationCid0
  checkAllocationsAndHoldingExpiryAgree admin

  -- withdrawing Alice's allocation must fail, as it is committed until its settlement deadline
  context <- V2.getAllocation_WithdrawContext registry aliceAllocationCid0 emptyMetadata
  result <- trySubmit (actAs alice <> discloseMany' context.disclosures) $
    exerciseCmd aliceAllocationCid0 V2.Allocation_Withdraw with
      actors = [alice]
      extraArgs = ExtraArgs with
        context = context.choiceContext
        meta = emptyMetadata
  let (Left (FailureStatusError err)) = result
  err === cannotWithdrawCommittedAllocationFailure (Some aliceSettlementDeadline)

  -- cycle allocation at different times
  let refreshAllocation allocationCid = do
        enrichedChoice <- V2.getSettlementFactory registry V2.SettlementFactory_SettleBatch with
          actors = [provider]
          settlement
          transferLegs = []
          allocations =
            [ V2.FinalizedAllocation with
                allocationCid
                extraTransferLegSides = []
                nextIterationFunding = Some TextMap.empty
            ]
          extraArgs = emptyExtraArgs

        result <- WalletClientV2.submitAndCheckTxHistory admins (actAs provider <> discloseMany' enrichedChoice.disclosures) $
          exerciseCmd enrichedChoice.factoryCid enrichedChoice.arg
        let [settleResult] = result.allocationSettleResults
        let Some aliceAllocationCid = WalletClientV2.extractNextIterationAllocationCid settleResult
        Some aliceAllocView <- queryInterfaceContractId alice aliceAllocationCid
        pure (aliceAllocationCid, aliceAllocView)

  -- immediate refresh should work and bump expiry
  (aliceAllocationCid1, aliceAllocView1) <- refreshAllocation aliceAllocationCid0
  (fmap (`addRelTime` days 90) aliceAllocView0.expiresAt) === aliceAllocView1.expiresAt
  checkAllocationsAndHoldingExpiryAgree admin

  -- a refresh works even after the current expiry, as long as the new expiry is in the future.
  -- This is OK, as the only thing that matters is that the DSO party CAN expire the allocation.
  passTime (days 181)
  (aliceAllocationCid1, aliceAllocView1) <- refreshAllocation aliceAllocationCid1
  (fmap (`addRelTime` days 180) aliceAllocView0.expiresAt) === aliceAllocView1.expiresAt
  checkAllocationsAndHoldingExpiryAgree admin

  -- withdrawing Alice's allocation after the settlement deadline must succeed
  setTime (aliceSettlementDeadline `addRelTime` microseconds 1)
  context <- V2.getAllocation_WithdrawContext registry aliceAllocationCid1 emptyMetadata
  WalletClientV2.submitAndCheckTxHistory admins (actAs alice <> discloseMany' context.disclosures) $
    exerciseCmd aliceAllocationCid1 V2.Allocation_Withdraw with
      actors = [alice]
      extraArgs = ExtraArgs with
        context = context.choiceContext
        meta = emptyMetadata

  [] <- queryInterface @V2.Allocation alice

  pure ()



checkAllocationsAndHoldingExpiryAgree : Party -> Script ()
checkAllocationsAndHoldingExpiryAgree admin = do
  allocs <- queryInterface @V2.Allocation admin
  forA_ allocs $ \(_, Some allocView) -> do
    let allocationExpiry = allocView.expiresAt
    forA_ allocView.holdingCids $ \holdingCid -> do
      Some holdingView <- queryInterfaceContractId @V2.Holding admin holdingCid
      let lockExpiry = fmap (.expiresAt) holdingView.lock
      unless (lockExpiry == Some allocationExpiry) $
        fail $ T.unlines
          [ "Expected allocation and holding expiry to agree, but they differ:"
          , "  allocation: " <> show allocView
          , "  holding: " <> show holdingView
          , "  allocation expiry: " <> show allocationExpiry
          , "  holding lock expiry: " <> show lockExpiry
          ]
