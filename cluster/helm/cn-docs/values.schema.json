{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "networkName"
  ],
  "properties": {
    "securityContexts": {
      "type": "object",
      "properties": {
        "pod": {
          "type": "object"
        },
        "containers": {
          "type": "object",
          "properties": {
            "docs": {
              "type": "object"
            },
            "gcsProxy": {
              "type": "object"
            }
          },
          "required": ["docs", "gcsProxy"]
        }
      },
      "required": ["pod", "containers"]
    },
    "serviceAccountName": {
      "type": "string"
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "networkName": {
      "type": "string"
    },
    "docs": {
      "type": "object",
      "required": [
        "imageName"
      ],
      "properties": {
        "imageName": {
          "type": "string"
        }
      }
    },
    "gcsProxy": {
      "type": "object",
      "required": [
        "imageName"
      ],
      "properties": {
        "imageName": {
          "type": "string"
        }
      }
    },
    "imageRepo": {
      "type": "string"
    },
    "splice-util-lib": {
      "type": "object"
    },
    "imageDigests": {
      "type": "object"
    },
    "imagePullPolicy": {
      "type": "string"
    },
    "enableReloader": {
      "type": "boolean"
    },
    "enableGcsProxy": {
      "type": "boolean"
    },
    "affinity": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "service": {
      "type": "object"
    },
    "cluster": {
      "type": "object"
    }
  }
}
