{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "serviceAccountName": {
      "type": "string"
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "securityContexts": {
      "type": ["object", "null"],
      "properties": {
        "pod": {
          "type": ["object", "null"]
        },
        "containers": {
          "type": ["object", "null"],
          "properties": {
            "splitwell": {
              "type": ["object", "null"]
            },
            "persistence": {
              "type": ["object", "null"]
            }
          },
          "required": ["splitwell", "persistence"]
        }
      },
      "required": ["pod", "containers"]
    },
    "participantClient": {
      "type": "object",
      "description": "Configuration parameters for the participant client.",
      "properties": {
        "adminApi": {
          "type": "object",
          "properties": {
            "disableAuth": {
              "type": "boolean"
            },
            "auth": {
              "type": "object",
              "properties": {
                "secretName": {
                  "type": "string"
                },
                "secretOverrides": {
                  "type": "object",
                  "properties": {
                    "audience": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "clientId": {
                      "type": "string"
                    },
                    "clientSecret": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
