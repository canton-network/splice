{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "unevaluatedProperties": false,
  "properties": {
    "serviceAccountName": {
      "type": "string"
    },
    "imageRepo": {
      "type": "string"
    },
    "splice-util-lib": {
      "type": "object"
    },
    "imageName": {
      "type": "string"
    },
    "imageDigests": {
      "type": "object"
    },
    "imagePullPolicy": {
      "type": "string"
    },
    "defaultJvmOptions": {
      "type": "string"
    },
    "additionalJvmOptions": {
      "type": "string"
    },
    "additionalEnvVars": {
      "type": "array"
    },
    "auth": {
      "type": "object"
    },
    "cluster": {
      "type": "object"
    },
    "failOnAppVersionMismatch": {
      "type": "boolean"
    },
    "fixedTokens": {
      "type": "boolean"
    },
    "maxDarVersion": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    },
    "migration": {
      "type": "object"
    },
    "participantHost": {
      "type": "string"
    },
    "postgres": {
      "type": "string"
    },
    "scanAddress": {
      "type": "string"
    },
    "persistence": {
      "type": "object"
    },
    "pvc": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "enableReloader": {
      "type": "boolean"
    },
    "logLevel": {
      "type": "string"
    },
    "logLevelStdout": {
      "type": "string"
    },
    "apiRequestLogLevel": {
      "type": "string"
    },
    "logAsyncFlush": {
      "type": "boolean"
    },
    "affinity": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "securityContexts": {
      "type": ["object", "null"],
      "properties": {
        "pod": {
          "type": ["object", "null"]
        },
        "containers": {
          "type": ["object", "null"],
          "properties": {
            "splitwell": {
              "type": ["object", "null"]
            },
            "persistence": {
              "type": ["object", "null"]
            }
          },
          "required": ["splitwell", "persistence"]
        }
      },
      "required": ["pod", "containers"]
    }
  }
}
