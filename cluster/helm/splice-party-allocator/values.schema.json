{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "unevaluatedProperties": false,
  "properties": {
    "serviceAccountName": {
      "type": "string"
    },
    "imageRepo": {
      "type": "string"
    },
    "splice-util-lib": {
      "type": "object"
    },
    "imageName": {
      "type": "string"
    },
    "imageDigests": {
      "type": "object"
    },
    "imagePullPolicy": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "auth": {
      "type": "object"
    },
    "cluster": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "pvc": {
      "type": "object"
    },
    "enableReloader": {
      "type": "boolean"
    },
    "affinity": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "securityContexts": {
      "type": ["object", "null"],
      "properties": {
        "pod": {
          "type": ["object", "null"]
        },
        "containers": {
          "type": ["object", "null"],
          "properties": {
            "partyAllocator": {
              "type": ["object", "null"]
            }
          },
          "required": ["partyAllocator"]
        }
      },
      "required": ["pod", "containers"]
    }
  }
}
