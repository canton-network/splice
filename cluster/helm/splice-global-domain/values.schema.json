{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "serviceAccountName": {
      "type": "string"
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "securityContexts": {
      "type": "object",
      "properties": {
        "pod": {
          "type": "object"
        },
        "containers": {
          "type": "object",
          "properties": {
            "mediator": {
              "type": "object"
            },
            "sequencer": {
              "type": "object"
            },
            "persistence": {
              "type": "object"
            }
          },
          "required": ["mediator", "sequencer", "persistence"]
        }
      },
      "required": ["pod", "containers"]
    },
    "sequencer": {
      "type": "object",
      "properties": {
        "driver": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "persistence": {
              "type": "object"
            },
            "externalAddress": {
              "type": "string"
            },
            "externalPort": {
              "type": "integer"
            },
            "peerEndpoints": {
              "type": "array",
              "description": "initial set of cantonBFT peers. Should be left empty for gSync SVs, use only for dedicated synchronizers.",
              "items": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "required": [
            "type"
          ]
        }
      },
      "required": [
        "driver"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "driver": {
                "properties": {
                  "type": {
                    "const": "cantonbft"
                  }
                },
                "required": [
                  "type",
                  "externalAddress",
                  "externalPort"
                ]
              }
            },
            "required": [
              "driver"
            ]
          },
          "then": {
            "required": [
              "imageName"
            ]
          }
        }
      ]
    }
  }
}
