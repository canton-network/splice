{
  "custom": true,
  "id": "",
  "inputs": {
    "alertStrategy": {
      "autoClose": "3600s",
      "notificationChannelStrategies": [
        {
          "notificationChannelNames": [
            null
          ],
          "renotifyInterval": "14400s"
        }
      ]
    },
    "combiner": "OR",
    "conditions": [
      {
        "conditionThreshold": {
          "aggregations": [
            {
              "alignmentPeriod": "600s",
              "crossSeriesReducer": "REDUCE_SUM",
              "groupByFields": [
