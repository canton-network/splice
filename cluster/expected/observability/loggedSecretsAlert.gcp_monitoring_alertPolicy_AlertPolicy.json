              ],
              "perSeriesAligner": "ALIGN_SUM"
            }
          ],
          "comparison": "COMPARISON_GT",
          "duration": "0s",
          "filter": "resource.type=\"k8s_container\" AND metric.type = \"logging.googleapis.com/user/logged_secrets_mock\"",
          "trigger": {
            "count": 1
          }
        },
        "displayName": "Logged secrets detected in mock"
      }
    ],
    "displayName": "Logged secrets detected in mock",
    "notificationChannels": [
      null
    ]
  },
  "name": "loggedSecretsAlert",
  "provider": "",
  "type": "gcp:monitoring/alertPolicy:AlertPolicy"
}
