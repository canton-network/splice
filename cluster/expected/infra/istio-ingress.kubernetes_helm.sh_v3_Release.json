{
  "custom": true,
  "id": "",
  "inputs": {
    "chart": "gateway",
    "compat": "true",
    "maxHistory": 10,
    "name": "istio-ingress",
    "namespace": "cluster-ingress",
    "repositoryOpts": {
      "repo": "https://blob.istio.io/istio-release/charts"
    },
    "values": {
      "affinity": {
        "nodeAffinity": {
          "requiredDuringSchedulingIgnoredDuringExecution": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "cn_infra",
                    "operator": "Exists"
                  }
                ]
              }
            ]
          }
        }
      },
      "annotations": {
        "cloud.google.com/l4-rbs": "enabled"
      },
      "autoscaling": {
        "maxReplicas": 15,
        "minReplicas": 2
      },
      "lifecycle": {
        "preStop": {
          "exec": {
            "command": [
              "sleep",
              "120"
            ]
          }
        }
      },
      "podAnnotations": {
        "proxy.istio.io/config": "{\"gatewayTopology\":{\"numTrustedProxies\":2},\"terminationDrainDuration\":\"60s\"}"
      },
      "podDisruptionBudget": {
        "maxUnavailable": 1
      },
      "resources": {
        "limits": {
          "cpu": "4",
          "memory": "4096Mi"
        },
        "requests": {
          "cpu": "500m",
          "memory": "1024Mi"
        }
      },
      "service": {
        "ports": [
          {
            "name": "status-port",
            "port": 15021,
            "protocol": "TCP",
            "targetPort": 15021
          },
          {
            "appProtocol": "kubernetes.io/h2c",
            "name": "http2",
            "port": 80,
            "protocol": "TCP",
            "targetPort": 80
          },
          {
            "name": "https",
            "port": 443,
            "protocol": "TCP",
            "targetPort": 443
          },
          {
            "name": "grpc-cd-pub-api",
            "port": 5008,
            "protocol": "TCP",
            "targetPort": 5008
          },
          {
            "name": "grpc-cs-p2p-api",
            "port": 5010,
            "protocol": "TCP",
            "targetPort": 5010
          },
          {
            "name": "grpc-svcp-adm",
            "port": 5002,
            "protocol": "TCP",
            "targetPort": 5002
          },
          {
            "name": "grpc-svcp-lg",
            "port": 5001,
            "protocol": "TCP",
            "targetPort": 5001
          },
          {
            "name": "svcp-metrics",
            "port": 10013,
            "protocol": "TCP",
            "targetPort": 10013
          },
          {
            "name": "grpc-val1-adm",
            "port": 5102,
            "protocol": "TCP",
            "targetPort": 5102
          },
          {
            "name": "grpc-val1-lg",
            "port": 5101,
            "protocol": "TCP",
            "targetPort": 5101
          },
          {
            "name": "val1-metrics",
            "port": 10113,
            "protocol": "TCP",
            "targetPort": 10113
          },
          {
            "name": "val1-lg-gw",
            "port": 6101,
            "protocol": "TCP",
            "targetPort": 6101
          },
          {
            "name": "grpc-swd-pub",
            "port": 5108,
            "protocol": "TCP",
            "targetPort": 5108
          },
          {
            "name": "grpc-swd-adm",
            "port": 5109,
            "protocol": "TCP",
            "targetPort": 5109
          },
          {
            "name": "swd-metrics",
            "port": 10413,
            "protocol": "TCP",
            "targetPort": 10413
          },
          {
            "name": "grpc-sw-adm",
            "port": 5202,
            "protocol": "TCP",
            "targetPort": 5202
          },
          {
            "name": "grpc-sw-lg",
            "port": 5201,
            "protocol": "TCP",
            "targetPort": 5201
          },
          {
            "name": "sw-metrics",
            "port": 10213,
            "protocol": "TCP",
            "targetPort": 10213
          },
          {
            "name": "sw-lg-gw",
            "port": 6201,
            "protocol": "TCP",
            "targetPort": 6201
          }
        ],
        "type": "ClusterIP"
      },
      "terminationGracePeriodSeconds": 210,
      "tolerations": [
        {
          "effect": "NoSchedule",
          "key": "cn_infra",
          "operator": "Exists"
        }
      ]
    },
    "version": "1.29.2"
  },
  "name": "istio-ingress",
  "provider": "",
  "type": "kubernetes:helm.sh/v3:Release"
}
