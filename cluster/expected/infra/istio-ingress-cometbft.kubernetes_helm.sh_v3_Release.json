{
  "custom": true,
  "id": "",
  "inputs": {
    "chart": "gateway",
    "compat": "true",
    "maxHistory": 10,
    "name": "istio-ingress-cometbft",
    "namespace": "cluster-ingress",
    "repositoryOpts": {
      "repo": "https://blob.istio.io/istio-release/charts"
    },
    "values": {
      "affinity": {
        "nodeAffinity": {
          "requiredDuringSchedulingIgnoredDuringExecution": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "cn_infra",
                    "operator": "Exists"
                  }
                ]
              }
            ]
          }
        }
      },
