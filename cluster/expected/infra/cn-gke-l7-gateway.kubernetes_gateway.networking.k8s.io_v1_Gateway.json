{
  "custom": true,
  "id": "",
  "inputs": {
    "apiVersion": "gateway.networking.k8s.io/v1",
    "kind": "Gateway",
    "metadata": {
      "name": "cn-gke-l7-gateway",
      "namespace": "cluster-ingress"
    },
    "spec": {
      "addresses": [
        {
          "type": "NamedAddress",
          "value": "cn-test-stacknet-ip"
        }
      ],
      "gatewayClassName": "gke-l7-regional-external-managed",
      "listeners": [
        {
          "allowedRoutes": {
            "kinds": [
              {
                "kind": "HTTPRoute"
              }
            ]
          },
          "name": "listen-http",
          "port": 80,
          "protocol": "HTTP"
        },
        {
          "allowedRoutes": {
            "kinds": [
              {
                "kind": "HTTPRoute"
              }
            ]
          },
          "name": "listen-https",
          "port": 443,
          "protocol": "HTTPS",
          "tls": {
            "certificateRefs": [
              {
                "group": "",
                "kind": "Secret",
                "name": "cn-test-stacknet-tls"
              }
            ],
            "mode": "Terminate"
          }
        }
      ]
    }
  },
  "name": "cn-gke-l7-gateway",
  "provider": "",
  "type": "kubernetes:gateway.networking.k8s.io/v1:Gateway"
}
