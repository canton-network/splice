{
  "custom": true,
  "id": "",
  "inputs": {
    "chart": "oci://ghcr.io/digital-asset/splice-portfolio/helm/splice-portfolio",
    "compat": "true",
    "maxHistory": 10,
    "name": "portfolio",
    "namespace": "validator1",
    "timeout": 600,
    "values": {
      "affinity": {
        "nodeAffinity": {
          "requiredDuringSchedulingIgnoredDuringExecution": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "cn_apps",
                    "operator": "Exists"
                  },
                  {
                    "key": "cn_apps",
                    "operator": "In",
                    "values": [
                      "hyperdisk"
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "config": {
        "amulet": {
          "registry": "https://scan.sv-2.mock.global.canton.network.digitalasset.com",
          "validatorUrl": "https://wallet.validator1.mock.global.canton.network.digitalasset.com/api/validator"
        },
        "token": {
          "registries": [
            {
              "name": "Amulet registry",
              "url": "https://scan.sv-2.mock.global.canton.network.digitalasset.com"
            }
          ],
          "validatorUrl": "https://wallet.validator1.mock.global.canton.network.digitalasset.com/api/validator"
        }
      },
      "tolerations": [
        {
          "effect": "NoSchedule",
          "key": "cn_apps",
          "operator": "Exists"
        }
      ]
    },
    "version": "1.12.2"
  },
  "name": "validator1-portfolio",
  "provider": "",
  "type": "kubernetes:helm.sh/v3:Release"
}
