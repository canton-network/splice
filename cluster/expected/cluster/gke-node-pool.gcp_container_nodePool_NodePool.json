{
  "custom": true,
  "id": "",
  "inputs": {
    "autoscaling": {
      "maxNodeCount": 3,
      "minNodeCount": 1
    },
    "cluster": "cn-mocknet",
    "initialNodeCount": 1,
    "nodeConfig": {
      "loggingVariant": "DEFAULT",
      "machineType": "e2-standard-4",
      "taints": [
        {
          "effect": "NO_SCHEDULE",
          "key": "components.gke.io/gke-managed-components",
          "value": "true"
        }
      ]
    }
  },
  "name": "gke-node-pool",
  "provider": "",
  "type": "gcp:container/nodePool:NodePool"
}
