{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "IME_mP2Vk"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {
              "limit": 100,
              "matchAny": false,
              "tags": [],
              "type": "dashboard"
            }
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Tooltip",
    "editable": true,
    "elements": {
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Components' Status",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "builder",
                        "exemplar": false,
                        "expr": "daml_health_status{namespace=\"$namespace\", pod=~\"$pod\"}",
                        "format": "time_series",
                        "instant": false,
                        "legendFormat": "{{pod}} {{component}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "status-history",
            "version": "9.3.2",
            "spec": {
              "options": {
                "colWidth": 1,
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false
                },
                "rowHeight": 0.8,
                "showValue": "never",
                "tooltip": {
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "max": 1,
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "inactive",
                          "index": 1
                        },
                        "1": {
                          "text": "active",
                          "index": 0
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "dark-red"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "noValue": "0",
                  "custom": {
                    "fillOpacity": 71,
                    "lineWidth": 0
                  }
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 8,
              "element": {
                "kind": "ElementReference",
                "name": "panel-4"
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [],
    "timeSettings": {
      "from": "now-3h",
      "to": "now",
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Health",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "Prometheus",
            "value": "Prometheus"
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "hide": "hideVariable",
          "skipUrlSync": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "namespace",
          "current": {
            "text": "static_local",
            "value": "static_local"
          },
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${datasource}"
            },
            "spec": {
              "query": "label_values(daml_health_status, namespace)",
              "refId": "StandardVariableQuery"
            }
          },
          "regex": "",
          "sort": "disabled",
          "definition": "label_values(daml_health_status, namespace)",
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "pod",
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${datasource}"
            },
            "spec": {
              "query": "label_values(daml_health_status{namespace=\"$namespace\"}, pod)",
              "refId": "StandardVariableQuery"
            }
          },
          "regex": "",
          "sort": "disabled",
          "definition": "label_values(daml_health_status{namespace=\"$namespace\"}, pod)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": true
        }
      }
    ]
  }
}
