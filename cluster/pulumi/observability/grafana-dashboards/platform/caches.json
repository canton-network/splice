                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (cache, namespace, job) (rate(daml_cache_misses{cache=~\"$cache\", namespace=~\"$namespace\", job=~\"$job\"}[$__rate_interval])) ",
                        "format": "time_series",
                        "interval": "",
                        "legendFormat": "Hit Ratio {{ namespace }} {{ job }} {{ cache }}",
                        "range": true
