      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Discarded confirmation requests (fraction)",
          "description": "Fraction of sequenced confirmation requests that were never processed by the mediator (e.g. dropped due to CometBFT replays).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum by (namespace) (rate(daml_sequencer_block_events_total{namespace=~\"$namespace\",type=\"send-confirmation-request\"}[10m])) - sum by (namespace) (rate(daml_mediator_requests_total{namespace=~\"$namespace\"}[10m]))) / sum by (namespace) (rate(daml_sequencer_block_events_total{namespace=~\"$namespace\",type=\"send-confirmation-request\"}[10m]))",
                        "legendFormat": "__auto",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "12.1.1",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [],
