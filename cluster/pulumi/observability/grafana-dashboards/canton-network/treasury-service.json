      "panel-27": {
        "kind": "Panel",
        "spec": {
          "id": 27,
          "title": "Treasury service queue latency",
          "description": "Time operations spent in the treasury service queue before their batch started executing (average and selected quantile). Excludes the execution of the batch itself.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile($quantile, sum by (namespace, job, owner) (rate(splice_wallet_treasury_queue_latency_duration_seconds{namespace=~\"$namespace\",job=~\"$job\",owner=~\"$owner\"}[$__rate_interval])))",
                        "legendFormat": "q$quantile {{namespace}}-{{job}}-{{owner}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_avg(sum by (namespace, job, owner) (rate(splice_wallet_treasury_queue_latency_duration_seconds{namespace=~\"$namespace\",job=~\"$job\",owner=~\"$owner\"}[$__rate_interval])))",
                        "legendFormat": "avg {{namespace}}-{{job}}-{{owner}}",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
