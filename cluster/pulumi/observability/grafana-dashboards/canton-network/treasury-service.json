      "panel-30": {
        "kind": "Panel",
        "spec": {
          "id": 30,
          "title": "Treasury executor saturation",
          "description": "Estimate of how saturated the treasury batch executor is. Batches are executed strictly one at a time, so once it is busy every operation waits for the in-flight batch: average queue wait \u00d7 batches per second \u2248 0 when idle, \u2248 0.5 when batches run back-to-back, and > 1 when operations wait for more than one batch (batch size capped or queue backlog). Saturation means throughput can only grow via larger batches, at the cost of latency. Batch metrics are not labelled by owner, so they are aggregated per validator app and ignore the owner filter.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_avg(sum by (namespace, job) (rate(splice_wallet_treasury_queue_latency_duration_seconds{namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval]))) * histogram_count(sum by (namespace, job) (rate(splice_wallet_treasury_batch_size{namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval])))",
                        "legendFormat": "{{namespace}}-{{job}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "12.4.0",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 0.25,
                        "color": "yellow"
                      },
                      {
                        "value": 0.45,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "",
                    "axisPlacement": "auto",
                    "barAlignment": 0,
                    "barWidthFactor": 0.6,
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "gradientMode": "none",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "pointSize": 5,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "auto",
                    "showValues": false,
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "line+area"
                    }
                  },
                  "unit": "none",
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
