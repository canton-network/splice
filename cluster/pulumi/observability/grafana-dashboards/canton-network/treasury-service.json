      "panel-31": {
        "kind": "Panel",
        "spec": {
          "id": 31,
          "title": "Queue wait vs. batch interval",
          "description": "Average time between batch executions (1 / batches per second) compared to the average time operations wait in the queue. When the executor is saturated, the batch interval equals the batch execution time and the queue wait approaches half of it or more. Batch metrics are not labelled by owner, so they are aggregated per validator app and ignore the owner filter.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "1 / histogram_count(sum by (namespace, job) (rate(splice_wallet_treasury_batch_size{namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval])))",
                        "legendFormat": "batch interval {{namespace}}-{{job}}",
                        "range": true
