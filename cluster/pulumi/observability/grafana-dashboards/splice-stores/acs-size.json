      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "ACS size (rows in latest saved snapshot)",
          "description": "Number of rows in the latest saved ACS snapshot, as reported by the SV Scan app. This is the metric behind the 'ACS growth' alert. Note that it counts rows, not contracts: contracts with multiple stakeholders are counted multiple times. A value of -1 means the size of the last snapshot save is unknown.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "splice_history_acs_snapshots_snapshot_size{namespace=~\"$namespace\"}",
                        "instant": false,
                        "legendFormat": "{{namespace}}",
                        "range": true
