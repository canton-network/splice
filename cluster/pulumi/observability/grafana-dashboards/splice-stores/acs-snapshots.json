      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Update latency",
          "description": "Time to update an incremental snapshot, i.e., the time to update an incremental snapshot by processing ~30sec worth of update history.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "builder",
                        "expr": "histogram_avg(rate(splice_history_acs_snapshots_latency_update_duration_seconds{namespace=~\"$namespace\"}[$__rate_interval]))",
                        "legendFormat": "{{namespace}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "12.4.0",
