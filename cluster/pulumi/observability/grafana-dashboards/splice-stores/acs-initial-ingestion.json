      "panel-15": {
        "kind": "Panel",
        "spec": {
          "id": 15,
          "title": "Is the store still ingesting? (events/s, ingestions/s)",
          "description": "Shows whether each store is still making progress. events = contracts written per second, completed = ingestion steps finished per second. Both at 0 while the ACS isn't done means ingestion is stuck.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace, store_name) (rate(splice_store_event_count{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__rate_interval]))",
                        "legendFormat": "events {{namespace}} {{store_name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace, store_name) (rate(splice_store_completed_ingestions_total{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__rate_interval]))",
                        "legendFormat": "completed {{namespace}} {{store_name}}",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "completed .*"
                    },
                    "properties": [
                      {
                        "id": "custom.axisPlacement",
                        "value": "right"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
