{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "b0d0a692-555c-499a-bbc8-c97d5090afe7"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "ACS ingest rate (contracts/s)",
          "description": "Rate of contracts added per store. Bursts = initial ACS ingestion. Counter overcounts after a restart mid-ACS.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace, store_name) (rate(splice_store_acs_size_increase_total{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__rate_interval]))",
                        "legendFormat": "{{namespace}} {{store_name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Net contracts added over selected range",
          "description": "increase(inc)-increase(dec) over the dashboard range. Pick a range covering one clean ACS ingestion. Overcounts if the ACS ingestion restarted.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace, store_name) (increase(splice_store_acs_size_increase_total{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__range])) - (sum by (namespace, store_name) (increase(splice_store_acs_size_decrease_total{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__range])) or sum by (namespace, store_name) (increase(splice_store_acs_size_increase_total{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__range]) * 0))",
                        "legendFormat": "{{namespace}} {{store_name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Pod instances seen in range",
          "description": "Distinct acs-size-increase series per store = distinct pods that ingested. A replaced pod starts a new series, so each one is a fresh ingestion start (resets() would miss replaced pods).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "count by (namespace, store_name) (last_over_time(splice_store_acs_size_increase_total{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__range]))",
                        "legendFormat": "{{namespace}} {{store_name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Mean time per ACS batch (s)",
          "description": "histogram_sum/histogram_count of batch-acs-ingestion-latency (native histogram). ~0.1 means ~1k contracts/s at 100 per batch.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace, store_name) (histogram_sum(rate(splice_store_batch_acs_ingestion_latency_duration_seconds{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__rate_interval]))) / sum by (namespace, store_name) (histogram_count(rate(splice_store_batch_acs_ingestion_latency_duration_seconds{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__rate_interval])))",
                        "legendFormat": "{{namespace}} {{store_name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Batch latency p50 / p99 (s)",
          "description": "Per-batch insert latency quantiles.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.5, sum by (namespace, store_name) (rate(splice_store_batch_acs_ingestion_latency_duration_seconds{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__rate_interval])))",
                        "legendFormat": "p50 {{namespace}} {{store_name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.99, sum by (namespace, store_name) (rate(splice_store_batch_acs_ingestion_latency_duration_seconds{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__rate_interval])))",
                        "legendFormat": "p99 {{namespace}} {{store_name}}",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "DB-busy fraction (insert time per wall second)",
          "description": "rate(_sum): seconds spent inside ingestAcsBatch per second. Batches run one at a time, so ~1 = DB-bound (expected throughput limit), well below 1 = gaps waiting for the stream/network. Per-pod: select a single namespace/pod.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace, store_name) (histogram_sum(rate(splice_store_batch_acs_ingestion_latency_duration_seconds{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__rate_interval])))",
                        "legendFormat": "{{namespace}} {{store_name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Implied contracts per ACS batch",
          "description": "rate(contracts added) / rate(batches). Max 100 by default (maxBatchSize). Only meaningful during initial ACS ingestion.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace, store_name) (rate(splice_store_acs_size_increase_total{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__rate_interval])) / sum by (namespace, store_name) (histogram_count(rate(splice_store_batch_acs_ingestion_latency_duration_seconds{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__rate_interval])))",
                        "legendFormat": "{{namespace}} {{store_name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Scan-side active-contracts buffer (cap 1000)",
          "description": "Near 0 = producer/network is slow; near cap = DB is the bottleneck. Debug-qualified metric, may be missing.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace) (splice_update_ingestion_service_active_contracts_buffer_size{namespace=~\"$namespace\"})",
                        "legendFormat": "{{namespace}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Participant-side active-contracts buffer (cap 128)",
          "description": "Canton metric, other side of the stream.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace) (daml_participant_api_index_active_contracts_buffer_size{namespace=~\"$namespace\"})",
                        "legendFormat": "{{namespace}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Participant ACS sent vs store ingest rate (contracts/s)",
          "description": "Ledger API acs_sent (all clients, before Splice filtering) vs contracts added to Splice stores. Sent >> ingested = Splice side is the bottleneck; both low = participant side.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace) (rate(daml_participant_api_streams_acs_sent{namespace=~\"$namespace\"}[$__rate_interval]))",
                        "legendFormat": "sent {{namespace}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace) (rate(splice_store_acs_size_increase_total{namespace=~\"$namespace\",store_name=~\"$store_name\"}[$__rate_interval]))",
                        "legendFormat": "ingested {{namespace}}",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Participant index DB ACS query latency p95 (s)",
          "description": "Index DB queries serving GetActiveContracts on the participant. The name label is the full metric path, e.g. daml.participant.api.index.db.get_active_contract_batch.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.95, sum by (namespace, name) (rate(daml_db_query_duration_seconds{namespace=~\"$namespace\",name=~\".*(get_active_contracts|get_active_contract_batch|get_active_contract_id_ranges|get_filtered_active_contract_ids|get_achs_id_ranges|get_achs_filtered_ids)\"}[$__rate_interval])))",
                        "legendFormat": "{{namespace}} {{name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-12": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "GetActiveContracts gRPC calls by code",
          "description": "Participant-side GetActiveContracts calls started and completed by gRPC code. Non-OK completions followed by new starts = ACS stream restarts (Splice restarts the whole ACS ingestion).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace) (rate(daml_grpc_server_started_total{namespace=~\"$namespace\",grpc_method_name=\"GetActiveContracts\"}[$__rate_interval]))",
                        "legendFormat": "started {{namespace}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace, grpc_code) (rate(daml_grpc_server_handled_total{namespace=~\"$namespace\",grpc_method_name=\"GetActiveContracts\"}[$__rate_interval]))",
                        "legendFormat": "handled {{namespace}} {{grpc_code}}",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "custom": {
                    "fillOpacity": 10,
                    "lineWidth": 1
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-14": {
        "kind": "Panel",
        "spec": {
          "id": 14,
          "title": "Splice app DB executor wait p95 (s) / queued",
          "description": "DB executors (general and write pools) of the Splice apps, all queries. High wait/queue during ACS ingestion = DB connection pool contention.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.95, sum by (namespace, node_type) (rate(cn_db_storage_general_executor_waittime_duration_seconds{namespace=~\"$namespace\"}[$__rate_interval])))",
                        "legendFormat": "wait p95 general {{namespace}} {{node_type}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.95, sum by (namespace, node_type) (rate(cn_db_storage_write_executor_waittime_duration_seconds{namespace=~\"$namespace\"}[$__rate_interval])))",
                        "legendFormat": "wait p95 write {{namespace}} {{node_type}}",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace, node_type) (cn_db_storage_general_executor_queued{namespace=~\"$namespace\"})",
                        "legendFormat": "queued general {{namespace}} {{node_type}}",
                        "range": true
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace, node_type) (cn_db_storage_write_executor_queued{namespace=~\"$namespace\"})",
                        "legendFormat": "queued write {{namespace}} {{node_type}}",
                        "range": true
                      }
                    },
                    "refId": "D",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
