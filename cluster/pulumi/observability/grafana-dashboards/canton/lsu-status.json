          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "prometheus"
            },
            "spec": {
              "qryType": 1,
              "query": "label_values(daml_sequencer_public_api_handshakes_total{namespace=\"$namespace\"},job)",
