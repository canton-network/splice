            "spec": {
              "qryType": 1,
              "query": "label_values(daml_participant_lsu_status,namespace)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "",
          "regexApplyTo": "value",
          "sort": "disabled",
          "definition": "label_values(daml_participant_lsu_status,namespace)",
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": true
