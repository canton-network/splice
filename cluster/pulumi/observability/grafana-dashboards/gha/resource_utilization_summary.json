          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "max by (test_suite) (\n  max_over_time(\n    (sum(container_memory_rss{container!=\"\", image!=\"\"}) by(pod) \n    * on(pod) group_left(test_suite) \n    gha_runner_info) [24h:5m]\n  )\n)",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{test_suite}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "max by (test_suite) (\n  max_over_time(\n    (sum(rate(container_cpu_usage_seconds_total{container!=\"\", image!=\"\"}[1m])) by(pod) \n    * on(pod) group_left(test_suite) \n    gha_runner_info)[24h:1m]\n  )\n)",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{test_suite}}",
                        "range": false
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "max by (test_suite) (\n  max_over_time (\n    (kube_pod_container_resource_limits{resource=\"memory\"} \n  * on(pod) group_left(test_suite) \n  gha_runner_info)[24h:1m]\n))",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "max by (test_suite) (\n  max_over_time (  \n    (kube_pod_container_resource_limits{job=\"kube-state-metrics\", resource=\"cpu\"} * on(pod) group_left(test_suite) gha_runner_info)[24h:1m]\n    )\n    )",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "D",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "joinByField",
                  "spec": {
                    "options": {
                      "byField": "test_suite",
                      "mode": "outer"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time 1": true,
                        "Time 2": true,
                        "Time 3": true,
                        "Time 4": true
                      },
                      "includeByName": {},
                      "indexByName": {
                        "Time 1": 1,
                        "Time 2": 4,
                        "Time 3": 6,
                        "Value #A": 2,
                        "Value #B": 5,
                        "Value #C": 3,
                        "test_suite": 0
                      },
                      "renameByName": {
                        "Value #A": "Memory",
                        "Value #B": "CPU",
                        "Value #C": "Mem limit",
                        "Value #D": "CPU Limit"
                      }
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "Memory %",
                      "binary": {
                        "left": {
                          "matcher": {
                            "id": "byName",
                            "options": "Memory"
                          }
                        },
                        "operator": "/",
                        "right": {
                          "matcher": {
                            "id": "byName",
                            "options": "Mem limit"
                          }
                        }
                      },
                      "mode": "binary",
                      "reduce": {
                        "reducer": "sum"
                      }
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "CPU usage %",
                      "binary": {
                        "left": {
                          "matcher": {
                            "id": "byName",
                            "options": "CPU"
                          }
                        },
                        "operator": "/",
                        "right": {
                          "matcher": {
                            "id": "byName",
                            "options": "CPU Limit"
                          }
                        }
                      },
                      "mode": "binary",
                      "reduce": {
                        "reducer": "sum"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
