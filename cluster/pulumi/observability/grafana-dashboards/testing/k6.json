      "panel-29": {
        "kind": "Panel",
        "spec": {
          "id": 29,
          "title": "Transaction Latency",
          "description": "The time it takes for a transaction to complete successfully (recipient accepts TransferOffer)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "disableTextWrap": false,
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.99, sum(rate(k6_create_offer_latency_seconds[$__rate_interval])))",
                        "fullMetaSearch": false,
                        "includeNullMetadata": true,
                        "instant": false,
                        "legendFormat": "create",
                        "range": true,
                        "useBackend": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.99, sum(rate(k6_offer_sync_latency_seconds[$__rate_interval])))",
                        "instant": false,
                        "legendFormat": "sync",
                        "range": true
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.99, sum(rate(k6_accept_offer_latency_seconds[$__rate_interval])))",
                        "instant": false,
                        "legendFormat": "accept",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "__expr__",
                      "version": "v0",
                      "datasource": {
                        "name": "__expr__"
                      },
                      "spec": {
                        "expression": "$A + $B + $C",
                        "type": "math"
                      }
                    },
                    "refId": "Total time",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
