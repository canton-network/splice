    "title": "k6 Load Tester (custom metrics)",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "DS_PROMETHEUS",
          "pluginId": "prometheus",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "Prometheus",
            "value": "prometheus"
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Prometheus DS",
          "hide": "dontHide",
          "skipUrlSync": false,
          "description": "Choose a Prometheus Data Source",
          "allowCustomValue": true
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "testid",
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "label": "Test ID",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "description": "Filter by \"testid\" tag. Define it by tagging: k6 run --tag testid=xyz",
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${DS_PROMETHEUS}"
            },
            "spec": {
              "query": "label_values(testid)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "",
          "sort": "disabled",
          "definition": "label_values(testid)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": true
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "quantile_stat",
          "current": {
            "text": "",
            "value": ""
          },
          "label": "Trend Metrics Query",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "description": "Statistic for Trend Metrics Queries. The available options depend on the values of the K6_PROMETHEUS_RW_TREND_STATS setting.",
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${DS_PROMETHEUS}"
            },
            "spec": {
              "query": "metrics(k6_http_req_duration_)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "/http_req_duration_(min|max|count|sum|avg|med|p[0-9]+)/g",
          "sort": "alphabeticalDesc",
          "definition": "metrics(k6_http_req_duration_)",
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "AdhocVariable",
        "group": "prometheus",
        "datasource": {
          "name": "${DS_PROMETHEUS}"
        },
        "spec": {
          "name": "adhoc_filter",
          "baseFilters": [],
          "filters": [],
          "defaultKeys": [],
          "label": "AdhocFilter",
          "hide": "dontHide",
          "skipUrlSync": false,
          "description": "Adhoc filters are applied to all panels. To enable it, go to Dashboard Settings / Variables / adhoc_filter and select the target Prometheus data source.",
          "allowCustomValue": true
        }
      }
    ]
