// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`configureScanBigQuery the schema migration SQL, waiting for V082: mock Production Schema Hourly Fix 1`] = `
"DECLARE failed ARRAY<STRING> DEFAULT [];
BEGIN
  CALL \`da-cn-devnet.mock_scan_prod.sp_fix_prod_schema_scan_verdict_store\`();
EXCEPTION WHEN ERROR THEN
  SET failed = ARRAY_CONCAT(failed, [FORMAT('%s: %s', 'scan_verdict_store', @@error.message)]);
END;
BEGIN
  CALL \`da-cn-devnet.mock_scan_prod.sp_fix_prod_schema_app_activity_record_store\`();
EXCEPTION WHEN ERROR THEN
  SET failed = ARRAY_CONCAT(failed, [FORMAT('%s: %s', 'app_activity_record_store', @@error.message)]);
END;
IF ARRAY_LENGTH(failed) > 0 THEN
  RAISE USING MESSAGE = ARRAY_TO_STRING(failed, '; ');
END IF;"
`;

exports[`configureScanBigQuery the schema migration SQL, waiting for V082: sp_append_app_activity_record_store 1`] = `
"BEGIN
  DECLARE current_watermark_micros INT64;
  DECLARE current_watermark_ts TIMESTAMP;
  DECLARE max_available_timestamp TIMESTAMP;
  DECLARE max_closed_timestamp TIMESTAMP;

  -- 1. Check if production table exists; if not, create shell table
  IF NOT EXISTS (
    SELECT 1
    FROM \`da-cn-devnet.mock_scan_prod.INFORMATION_SCHEMA.TABLES\`
    WHERE table_name = 'app_activity_record_store'
  ) THEN
    CREATE TABLE \`da-cn-devnet.mock_scan_prod.app_activity_record_store\`
    PARTITION BY record_date AS
    SELECT
      staging.\`history_id\`,
      staging.\`verdict_row_id\`,
      staging.\`round_number\`,
      staging.\`app_provider_parties\`,
      staging.\`app_activity_weights\`,
      staging.\`submitting_app_provider\`,
      staging.\`asset_activity_provider_parties\`,
      staging.\`asset_activity_weights\`,
      staging.\`datastream_metadata\`,
      CAST(TIMESTAMP_MILLIS(staging.datastream_metadata.source_timestamp) AS DATE) AS record_date
    FROM \`da-cn-devnet.mock_scan_staging.scan_sv_1_app_activity_record_store\` AS staging
    WHERE 1 = 0;
  END IF;

  -- 1a. Check that production has every listed column
  CALL \`da-cn-devnet.mock_scan_prod.sp_check_prod_schema\`('scan_sv_1_app_activity_record_store', 'app_activity_record_store', ['history_id', 'verdict_row_id', 'round_number', 'app_provider_parties', 'app_activity_weights', 'submitting_app_provider', 'asset_activity_provider_parties', 'asset_activity_weights', 'datastream_metadata']);

  -- 2. Create central watermark tracking table using INT64 (microseconds)
  CREATE TABLE IF NOT EXISTS \`da-cn-devnet.mock_scan_prod.pipeline_watermarks\` (
    table_name STRING,
    last_watermark_time INT64
  );

  -- 3. Initialize watermark to epoch zero (0 micros) if missing
  IF NOT EXISTS (
    SELECT 1 
    FROM \`da-cn-devnet.mock_scan_prod.pipeline_watermarks\` 
    WHERE table_name = 'app_activity_record_store'
  ) THEN
    INSERT INTO \`da-cn-devnet.mock_scan_prod.pipeline_watermarks\` 
    VALUES ('app_activity_record_store', 0);
  END IF;

  -- 4. Get current scalar watermark in INT64 micros and convert to TIMESTAMP
  SET current_watermark_micros = (
    SELECT MAX(last_watermark_time) 
    FROM \`da-cn-devnet.mock_scan_prod.pipeline_watermarks\` 
    WHERE table_name = 'app_activity_record_store'
  );

  SET current_watermark_ts = TIMESTAMP_MICROS(current_watermark_micros);

  -- 5. Fetch max available timestamp from staging WITH PARTITION PRUNING
  SET max_available_timestamp = COALESCE(
    (
      SELECT MAX(TIMESTAMP_MILLIS(staging.datastream_metadata.source_timestamp)) 
      FROM \`da-cn-devnet.mock_scan_staging.scan_sv_1_app_activity_record_store\` AS staging
      WHERE (
          staging._PARTITIONTIME >= TIMESTAMP_SUB(current_watermark_ts, INTERVAL 3 HOUR)
          OR staging._PARTITIONTIME IS NULL
        )
    ),
    -- Fall back to current_watermark_ts if no new data arrived in the last 3 hours
    current_watermark_ts
  );

  -- Subtract 1 hour to safely close the ingestion window
  SET max_closed_timestamp = TIMESTAMP_SUB(max_available_timestamp, INTERVAL 1 HOUR);

  -- 6. Filter incremental data with Primary Key Deduplication & Partition Pruning
  CREATE TEMP TABLE temp_incremental AS (
    SELECT
      staging.\`history_id\`,
      staging.\`verdict_row_id\`,
      staging.\`round_number\`,
      staging.\`app_provider_parties\`,
      staging.\`app_activity_weights\`,
      staging.\`submitting_app_provider\`,
      staging.\`asset_activity_provider_parties\`,
      staging.\`asset_activity_weights\`,
      staging.\`datastream_metadata\`,
      CAST(TIMESTAMP_MILLIS(staging.datastream_metadata.source_timestamp) AS DATE) AS record_date
    FROM \`da-cn-devnet.mock_scan_staging.scan_sv_1_app_activity_record_store\` AS staging
    WHERE (
        -- Cost control: Scan 3-hour partition window
        staging._PARTITIONTIME >= TIMESTAMP_SUB(current_watermark_ts, INTERVAL 3 HOUR)
        -- Streaming buffer protection for recent arrivals
        OR staging._PARTITIONTIME IS NULL
      )
      AND TIMESTAMP_MILLIS(staging.datastream_metadata.source_timestamp) > current_watermark_ts
      AND TIMESTAMP_MILLIS(staging.datastream_metadata.source_timestamp) <= max_closed_timestamp
    -- Primary Key Deduplication
    QUALIFY ROW_NUMBER() OVER (
      PARTITION BY verdict_row_id
      ORDER BY 
        staging.datastream_metadata.source_timestamp DESC,
        staging.datastream_metadata.change_sequence_number DESC
    ) = 1
  );

  -- 7. Perform append and update watermark if valid new records exist
  IF EXISTS (SELECT 1 FROM temp_incremental) THEN
    
    -- by column name: columns added to production since it was
    -- created come after record_date
    INSERT INTO \`da-cn-devnet.mock_scan_prod.app_activity_record_store\` (
      \`history_id\`,
      \`verdict_row_id\`,
      \`round_number\`,
      \`app_provider_parties\`,
      \`app_activity_weights\`,
      \`submitting_app_provider\`,
      \`asset_activity_provider_parties\`,
      \`asset_activity_weights\`,
      \`datastream_metadata\`,
      record_date
    )
    SELECT
      \`history_id\`,
      \`verdict_row_id\`,
      \`round_number\`,
      \`app_provider_parties\`,
      \`app_activity_weights\`,
      \`submitting_app_provider\`,
      \`asset_activity_provider_parties\`,
      \`asset_activity_weights\`,
      \`datastream_metadata\`,
      record_date
    FROM temp_incremental;

    UPDATE \`da-cn-devnet.mock_scan_prod.pipeline_watermarks\`
    SET last_watermark_time = UNIX_MICROS(max_closed_timestamp)
    WHERE table_name = 'app_activity_record_store'
    AND last_watermark_time < UNIX_MICROS(max_closed_timestamp);

  END IF;
END;"
`;

exports[`configureScanBigQuery the schema migration SQL, waiting for V082: sp_append_scan_verdict_store 1`] = `
"BEGIN
  DECLARE current_watermark_micros INT64;
  DECLARE current_watermark_ts TIMESTAMP;
  DECLARE max_available_timestamp TIMESTAMP;
  DECLARE max_closed_timestamp TIMESTAMP;

  -- 1. Check if production table exists; if not, create shell table
  IF NOT EXISTS (
    SELECT 1
    FROM \`da-cn-devnet.mock_scan_prod.INFORMATION_SCHEMA.TABLES\`
    WHERE table_name = 'scan_verdict_store'
  ) THEN
    CREATE TABLE \`da-cn-devnet.mock_scan_prod.scan_verdict_store\`
    PARTITION BY record_date AS
    SELECT
      staging.\`row_id\`,
      staging.\`ingested_at\`,
      staging.\`migration_id\`,
      staging.\`domain_id\`,
      staging.\`record_time\`,
      staging.\`finalization_time\`,
      staging.\`submitting_participant_uid\`,
      staging.\`verdict_result\`,
      staging.\`mediator_group\`,
      staging.\`update_id\`,
      staging.\`submitting_parties\`,
      staging.\`transaction_root_views\`,
      staging.\`history_id\`,
      staging.\`total_traffic_cost\`,
      staging.\`envelope_traffic_costs\`,
      staging.\`round_number\`,
      staging.\`datastream_metadata\`,
      CAST(TIMESTAMP_MICROS(staging.record_time) AS DATE) AS record_date
    FROM \`da-cn-devnet.mock_scan_staging.scan_sv_1_scan_verdict_store\` AS staging
    WHERE 1 = 0;
  END IF;

  -- 1a. Check that production has every listed column
  CALL \`da-cn-devnet.mock_scan_prod.sp_check_prod_schema\`('scan_sv_1_scan_verdict_store', 'scan_verdict_store', ['row_id', 'ingested_at', 'migration_id', 'domain_id', 'record_time', 'finalization_time', 'submitting_participant_uid', 'verdict_result', 'mediator_group', 'update_id', 'submitting_parties', 'transaction_root_views', 'history_id', 'total_traffic_cost', 'envelope_traffic_costs', 'round_number', 'datastream_metadata']);

  -- 2. Create central watermark tracking table using INT64 (microseconds)
  CREATE TABLE IF NOT EXISTS \`da-cn-devnet.mock_scan_prod.pipeline_watermarks\` (
    table_name STRING,
    last_watermark_time INT64
  );

  -- 3. Initialize watermark to epoch zero (0 micros) if missing
  IF NOT EXISTS (
    SELECT 1 
    FROM \`da-cn-devnet.mock_scan_prod.pipeline_watermarks\` 
    WHERE table_name = 'scan_verdict_store'
  ) THEN
    INSERT INTO \`da-cn-devnet.mock_scan_prod.pipeline_watermarks\` 
    VALUES ('scan_verdict_store', 0);
  END IF;

  -- 4. Get current scalar watermark in INT64 micros and convert to TIMESTAMP
  SET current_watermark_micros = (
    SELECT MAX(last_watermark_time) 
    FROM \`da-cn-devnet.mock_scan_prod.pipeline_watermarks\` 
    WHERE table_name = 'scan_verdict_store'
  );

  SET current_watermark_ts = TIMESTAMP_MICROS(current_watermark_micros);

  -- 5. Fetch max available timestamp from staging WITH PARTITION PRUNING
  SET max_available_timestamp = COALESCE(
    (
      SELECT MAX(TIMESTAMP_MICROS(staging.record_time)) 
      FROM \`da-cn-devnet.mock_scan_staging.scan_sv_1_scan_verdict_store\` AS staging
      WHERE (
          staging._PARTITIONTIME >= TIMESTAMP_SUB(current_watermark_ts, INTERVAL 3 HOUR)
          OR staging._PARTITIONTIME IS NULL
        )
    ),
    -- Fall back to current_watermark_ts if no new data arrived in the last 3 hours
    current_watermark_ts
  );

  -- Subtract 1 hour to safely close the ingestion window
  SET max_closed_timestamp = TIMESTAMP_SUB(max_available_timestamp, INTERVAL 1 HOUR);

  -- 6. Filter incremental data with Primary Key Deduplication & Partition Pruning
  CREATE TEMP TABLE temp_incremental AS (
    SELECT
      staging.\`row_id\`,
      staging.\`ingested_at\`,
      staging.\`migration_id\`,
      staging.\`domain_id\`,
      staging.\`record_time\`,
      staging.\`finalization_time\`,
      staging.\`submitting_participant_uid\`,
      staging.\`verdict_result\`,
      staging.\`mediator_group\`,
      staging.\`update_id\`,
      staging.\`submitting_parties\`,
      staging.\`transaction_root_views\`,
      staging.\`history_id\`,
      staging.\`total_traffic_cost\`,
      staging.\`envelope_traffic_costs\`,
      staging.\`round_number\`,
      staging.\`datastream_metadata\`,
      CAST(TIMESTAMP_MICROS(staging.record_time) AS DATE) AS record_date
    FROM \`da-cn-devnet.mock_scan_staging.scan_sv_1_scan_verdict_store\` AS staging
    WHERE (
        -- Cost control: Scan 3-hour partition window
        staging._PARTITIONTIME >= TIMESTAMP_SUB(current_watermark_ts, INTERVAL 3 HOUR)
        -- Streaming buffer protection for recent arrivals
        OR staging._PARTITIONTIME IS NULL
      )
      AND TIMESTAMP_MICROS(staging.record_time) > current_watermark_ts
      AND TIMESTAMP_MICROS(staging.record_time) <= max_closed_timestamp
    -- Primary Key Deduplication
    QUALIFY ROW_NUMBER() OVER (
      PARTITION BY row_id
      ORDER BY 
        staging.datastream_metadata.source_timestamp DESC,
        staging.datastream_metadata.change_sequence_number DESC
    ) = 1
  );

  -- 7. Perform append and update watermark if valid new records exist
  IF EXISTS (SELECT 1 FROM temp_incremental) THEN
    
    -- by column name: columns added to production since it was
    -- created come after record_date
    INSERT INTO \`da-cn-devnet.mock_scan_prod.scan_verdict_store\` (
      \`row_id\`,
      \`ingested_at\`,
      \`migration_id\`,
      \`domain_id\`,
      \`record_time\`,
      \`finalization_time\`,
      \`submitting_participant_uid\`,
      \`verdict_result\`,
      \`mediator_group\`,
      \`update_id\`,
      \`submitting_parties\`,
      \`transaction_root_views\`,
      \`history_id\`,
      \`total_traffic_cost\`,
      \`envelope_traffic_costs\`,
      \`round_number\`,
      \`datastream_metadata\`,
      record_date
    )
    SELECT
      \`row_id\`,
      \`ingested_at\`,
      \`migration_id\`,
      \`domain_id\`,
      \`record_time\`,
      \`finalization_time\`,
      \`submitting_participant_uid\`,
      \`verdict_result\`,
      \`mediator_group\`,
      \`update_id\`,
      \`submitting_parties\`,
      \`transaction_root_views\`,
      \`history_id\`,
      \`total_traffic_cost\`,
      \`envelope_traffic_costs\`,
      \`round_number\`,
      \`datastream_metadata\`,
      record_date
    FROM temp_incremental;

    UPDATE \`da-cn-devnet.mock_scan_prod.pipeline_watermarks\`
    SET last_watermark_time = UNIX_MICROS(max_closed_timestamp)
    WHERE table_name = 'scan_verdict_store'
    AND last_watermark_time < UNIX_MICROS(max_closed_timestamp);

  END IF;
END;"
`;

exports[`configureScanBigQuery the schema migration SQL, waiting for V082: sp_check_prod_schema 1`] = `
"BEGIN
  DECLARE missing ARRAY<STRING>;

  -- Datastream adds a column to staging once it replicates a row
  -- that has it
  SET missing = ARRAY(
    SELECT listed FROM UNNEST(columns) AS listed
    WHERE listed NOT IN (
      SELECT column_name FROM \`da-cn-devnet.mock_scan_staging.INFORMATION_SCHEMA.COLUMNS\` AS staging_columns
      WHERE table_name = staging_table_name
    )
    ORDER BY listed
  );
  IF ARRAY_LENGTH(missing) > 0 THEN
    RAISE USING MESSAGE = FORMAT(
      'Staging %s lacks columns %s, which Datastream adds once it replicates them',
      staging_table_name, ARRAY_TO_STRING(missing, ', '));
  END IF;

  SET missing = ARRAY(
    SELECT listed FROM UNNEST(columns) AS listed
    WHERE listed NOT IN (
      SELECT column_name FROM \`da-cn-devnet.mock_scan_prod.INFORMATION_SCHEMA.COLUMNS\` AS prod_columns
      WHERE table_name = prod_table_name
    )
    ORDER BY listed
  );
  IF ARRAY_LENGTH(missing) > 0 THEN
    RAISE USING MESSAGE = FORMAT(
      'Production %s lacks columns %s; CALL \`%s.%s.%s_%s\`(), which also runs hourly, adds and fills them',
      prod_table_name, ARRAY_TO_STRING(missing, ', '), 'da-cn-devnet',
      'mock_scan_prod', 'sp_fix_prod_schema', prod_table_name);
  END IF;
END"
`;

exports[`configureScanBigQuery the schema migration SQL, waiting for V082: sp_fix_prod_schema 1`] = `
"BEGIN
  DECLARE added ARRAY<STRING>;
  DECLARE add_columns STRING;

  SET added = [];
  -- the append creates production with every listed column
  IF EXISTS (
    SELECT 1 FROM \`da-cn-devnet.mock_scan_prod.INFORMATION_SCHEMA.TABLES\` AS prod_tables
    WHERE table_name = prod_table_name
  ) THEN
    SET added = ARRAY(
      SELECT column_name FROM \`da-cn-devnet.mock_scan_staging.INFORMATION_SCHEMA.COLUMNS\` AS staging_columns
      WHERE table_name = staging_table_name
        AND column_name IN UNNEST(columns)
        AND column_name NOT IN (
          SELECT column_name FROM \`da-cn-devnet.mock_scan_prod.INFORMATION_SCHEMA.COLUMNS\` AS prod_columns
          WHERE table_name = prod_table_name
        )
      ORDER BY ordinal_position
    );
    SET add_columns = (
      SELECT STRING_AGG(
        FORMAT('ADD COLUMN IF NOT EXISTS \`%s\` %s', column_name, data_type),
        ', ' ORDER BY ordinal_position)
      FROM \`da-cn-devnet.mock_scan_staging.INFORMATION_SCHEMA.COLUMNS\` AS staging_columns
      WHERE table_name = staging_table_name
        AND column_name IN UNNEST(added)
    );
    IF add_columns IS NOT NULL THEN
      EXECUTE IMMEDIATE FORMAT(
        'ALTER TABLE \`%s.%s.%s\` %s',
        'da-cn-devnet', 'mock_scan_prod', prod_table_name, add_columns);
    END IF;
  END IF;
END"
`;

exports[`configureScanBigQuery the schema migration SQL, waiting for V082: sp_fix_prod_schema_app_activity_record_store 1`] = `
"BEGIN
  DECLARE oldest_record_date DATE;

  -- 1. Add the listed columns that production lacks
  CALL \`da-cn-devnet.mock_scan_prod.sp_fix_prod_schema\`('scan_sv_1_app_activity_record_store', 'app_activity_record_store', ['history_id', 'verdict_row_id', 'round_number', 'app_provider_parties', 'app_activity_weights', 'submitting_app_provider', 'asset_activity_provider_parties', 'asset_activity_weights', 'datastream_metadata']);

  -- 2. Production rows appended before a \`since\` column was listed lack
  -- its value: NULL, or an empty array. Fill those that staging still
  -- has, from their latest change, where that has a value; older rows
  -- keep theirs. This runs every hour, so it also fills the rows of an
  -- append that ran before the fix, and retries a fill that failed.
  -- Skipped until both staging and production have every such column.
  IF (
    SELECT COUNT(DISTINCT column_name) FROM \`da-cn-devnet.mock_scan_staging.INFORMATION_SCHEMA.COLUMNS\` AS staging_columns
    WHERE table_name = 'scan_sv_1_app_activity_record_store'
      AND column_name IN UNNEST(['submitting_app_provider', 'asset_activity_provider_parties', 'asset_activity_weights'])
  ) = ARRAY_LENGTH(['submitting_app_provider', 'asset_activity_provider_parties', 'asset_activity_weights']) AND (
    SELECT COUNT(DISTINCT column_name) FROM \`da-cn-devnet.mock_scan_prod.INFORMATION_SCHEMA.COLUMNS\` AS prod_columns
    WHERE table_name = 'app_activity_record_store'
      AND column_name IN UNNEST(['submitting_app_provider', 'asset_activity_provider_parties', 'asset_activity_weights'])
  ) = ARRAY_LENGTH(['submitting_app_provider', 'asset_activity_provider_parties', 'asset_activity_weights']) THEN
    SET oldest_record_date = (
      SELECT MIN(CAST(TIMESTAMP_MILLIS(staging.datastream_metadata.source_timestamp) AS DATE))
      FROM \`da-cn-devnet.mock_scan_staging.scan_sv_1_app_activity_record_store\` AS staging
    );
    IF EXISTS (
      SELECT 1 FROM \`da-cn-devnet.mock_scan_prod.app_activity_record_store\` AS prod
      WHERE prod.record_date >= oldest_record_date
        AND (TO_JSON_STRING(prod.\`submitting_app_provider\`) IN ('null', '[]')
  OR TO_JSON_STRING(prod.\`asset_activity_provider_parties\`) IN ('null', '[]')
  OR TO_JSON_STRING(prod.\`asset_activity_weights\`) IN ('null', '[]'))
    ) THEN
      UPDATE \`da-cn-devnet.mock_scan_prod.app_activity_record_store\` AS prod
      SET
        \`submitting_app_provider\` = IF(TO_JSON_STRING(prod.\`submitting_app_provider\`) IN ('null', '[]'), latest.\`submitting_app_provider\`, prod.\`submitting_app_provider\`),
        \`asset_activity_provider_parties\` = IF(TO_JSON_STRING(prod.\`asset_activity_provider_parties\`) IN ('null', '[]'), latest.\`asset_activity_provider_parties\`, prod.\`asset_activity_provider_parties\`),
        \`asset_activity_weights\` = IF(TO_JSON_STRING(prod.\`asset_activity_weights\`) IN ('null', '[]'), latest.\`asset_activity_weights\`, prod.\`asset_activity_weights\`)
      FROM (
        SELECT
          staging.\`verdict_row_id\`,
          staging.\`submitting_app_provider\`,
          staging.\`asset_activity_provider_parties\`,
          staging.\`asset_activity_weights\`
        FROM \`da-cn-devnet.mock_scan_staging.scan_sv_1_app_activity_record_store\` AS staging
        WHERE TRUE
        QUALIFY ROW_NUMBER() OVER (
          PARTITION BY verdict_row_id
          ORDER BY
            staging.datastream_metadata.source_timestamp DESC,
            staging.datastream_metadata.change_sequence_number DESC
        ) = 1
      ) AS latest
      WHERE prod.record_date >= oldest_record_date
        AND prod.\`verdict_row_id\` = latest.\`verdict_row_id\`
        AND ((TO_JSON_STRING(prod.\`submitting_app_provider\`) IN ('null', '[]') AND TO_JSON_STRING(latest.\`submitting_app_provider\`) NOT IN ('null', '[]'))
  OR (TO_JSON_STRING(prod.\`asset_activity_provider_parties\`) IN ('null', '[]') AND TO_JSON_STRING(latest.\`asset_activity_provider_parties\`) NOT IN ('null', '[]'))
  OR (TO_JSON_STRING(prod.\`asset_activity_weights\`) IN ('null', '[]') AND TO_JSON_STRING(latest.\`asset_activity_weights\`) NOT IN ('null', '[]')));
    END IF;
  END IF;
END;
"
`;

exports[`configureScanBigQuery the schema migration SQL, waiting for V082: sp_fix_prod_schema_scan_verdict_store 1`] = `
"BEGIN
  DECLARE oldest_record_date DATE;

  -- 1. Add the listed columns that production lacks
  CALL \`da-cn-devnet.mock_scan_prod.sp_fix_prod_schema\`('scan_sv_1_scan_verdict_store', 'scan_verdict_store', ['row_id', 'ingested_at', 'migration_id', 'domain_id', 'record_time', 'finalization_time', 'submitting_participant_uid', 'verdict_result', 'mediator_group', 'update_id', 'submitting_parties', 'transaction_root_views', 'history_id', 'total_traffic_cost', 'envelope_traffic_costs', 'round_number', 'datastream_metadata']);

  -- 2. Production rows appended before a \`since\` column was listed lack
  -- its value: NULL, or an empty array. Fill those that staging still
  -- has, from their latest change, where that has a value; older rows
  -- keep theirs. This runs every hour, so it also fills the rows of an
  -- append that ran before the fix, and retries a fill that failed.
  -- Skipped until both staging and production have every such column.
  IF (
    SELECT COUNT(DISTINCT column_name) FROM \`da-cn-devnet.mock_scan_staging.INFORMATION_SCHEMA.COLUMNS\` AS staging_columns
    WHERE table_name = 'scan_sv_1_scan_verdict_store'
      AND column_name IN UNNEST(['round_number'])
  ) = ARRAY_LENGTH(['round_number']) AND (
    SELECT COUNT(DISTINCT column_name) FROM \`da-cn-devnet.mock_scan_prod.INFORMATION_SCHEMA.COLUMNS\` AS prod_columns
    WHERE table_name = 'scan_verdict_store'
      AND column_name IN UNNEST(['round_number'])
  ) = ARRAY_LENGTH(['round_number']) THEN
    SET oldest_record_date = (
      SELECT MIN(CAST(TIMESTAMP_MICROS(staging.record_time) AS DATE))
      FROM \`da-cn-devnet.mock_scan_staging.scan_sv_1_scan_verdict_store\` AS staging
    );
    IF EXISTS (
      SELECT 1 FROM \`da-cn-devnet.mock_scan_prod.scan_verdict_store\` AS prod
      WHERE prod.record_date >= oldest_record_date
        AND (TO_JSON_STRING(prod.\`round_number\`) IN ('null', '[]'))
    ) THEN
      UPDATE \`da-cn-devnet.mock_scan_prod.scan_verdict_store\` AS prod
      SET
        \`round_number\` = IF(TO_JSON_STRING(prod.\`round_number\`) IN ('null', '[]'), latest.\`round_number\`, prod.\`round_number\`)
      FROM (
        SELECT
          staging.\`row_id\`,
          staging.\`round_number\`
        FROM \`da-cn-devnet.mock_scan_staging.scan_sv_1_scan_verdict_store\` AS staging
        WHERE TRUE
        QUALIFY ROW_NUMBER() OVER (
          PARTITION BY row_id
          ORDER BY
            staging.datastream_metadata.source_timestamp DESC,
            staging.datastream_metadata.change_sequence_number DESC
        ) = 1
      ) AS latest
      WHERE prod.record_date >= oldest_record_date
        AND prod.\`row_id\` = latest.\`row_id\`
        AND ((TO_JSON_STRING(prod.\`round_number\`) IN ('null', '[]') AND TO_JSON_STRING(latest.\`round_number\`) NOT IN ('null', '[]')));
    END IF;
  END IF;
END;
"
`;
