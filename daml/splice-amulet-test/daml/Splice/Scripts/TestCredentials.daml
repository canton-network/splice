test_create_credential : Script ()
test_create_credential = do
  env <- setupCredentialEnv
  (credentialCid, requestedAt) <- createCredential env env.issuer env.holder [exampleClaim]
  assertCredential env credentialCid [exampleClaim] None None requestedAt
    (requestedAt `addRelTime` env.config.freePeriod)

-- | A URI or a plain word is accepted as a subject.
test_create_credential_uri_subjects : Script ()
test_create_credential_uri_subjects = do
  env <- setupCredentialEnv
  let subjects =
        [ "https://example.com/alice"
        , "alice"
        , "carol"
        ]
      claims = map (\subject -> exampleClaim with subject = Some subject) subjects
  (credentialCid, requestedAt) <- createCredential env env.issuer env.holder claims
  assertCredential env credentialCid claims None None requestedAt
    (requestedAt `addRelTime` env.config.freePeriod)

test_create_credential_rejected : Script ()
test_create_credential_rejected = do
  env <- setupCredentialEnv
  start <- getTime
  passTime (days 1)
  let requestedAt = start `addRelTime` hours 1
      before = Some start
      atCreated = Some requestedAt
      after = Some (requestedAt `addRelTime` hours 1)
      long256 = T.implode (replicate 256 "a")
      long2048 = T.implode (replicate 2048 "a")
      named = exampleClaim with subject = Some "bob"
      tooMany = map (\n -> exampleClaim with property = "example.com/c" <> show n) [1 .. 33]
  -- property character and length
  createCredentialMustFail env requestedAt [exampleClaim with property = "example.com/bad name"] None None
  createCredentialMustFail env requestedAt [exampleClaim with property = long256] None None
  -- subject empty, equal to the holder, too long, or an illegal character
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some ""] None None
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some (partyToText env.holder)] None None
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some long256] None None
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some "bob<example>"] None None
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some "b\246b"] None None
  -- value length and claim count
  createCredentialMustFail env requestedAt [exampleClaim with value = long2048] None None
  createCredentialMustFail env requestedAt tooMany None None
  -- duplicate (subject, property), including two unset subjects
  createCredentialMustFail env requestedAt [exampleClaim, exampleClaim] None None
  createCredentialMustFail env requestedAt [named, named] None None
  -- validFrom is not before validUntil, or validUntil is not after createdAt
  createCredentialMustFail env requestedAt [exampleClaim] after after
  createCredentialMustFail env requestedAt [exampleClaim] before atCreated
  createCredentialMustFail env requestedAt [exampleClaim] None atCreated
  -- requestedAt older than 24 hours
  createCredentialMustFail env (requestedAt `addRelTime` days (-1)) [exampleClaim] None None
  [] <- query @CredentialRecord env.holder
  pure ()

-- | Without a registry config vote, issuance and extension use the CIP defaults:
-- 90 days of free lease and 1.0 USD per extra year.
test_registry_runs_with_default_config : Script ()
test_registry_runs_with_default_config = do
  env <- setupCredentialEnvWith None
  env.config === RegistryParams with freePeriod = days 90; extensionUsdPerYear = 1.0
  (credentialCid, createdAt) <- createCredential env env.issuer env.holder [exampleClaim]
  assertCredential env credentialCid [exampleClaim] None None createdAt
    (createdAt `addRelTime` days 90)
  -- renewing 73 days beyond the old expiry plus 90 free days costs about 0.2 USD at the default price
  holding <- tap env.app env.holderUser 3.0
  requestedAt <- pastRequestedAt
  let oldExpiresAt = createdAt `addRelTime` days 90
      newExpiresAt = oldExpiresAt `addRelTime` days (90 + 73)
      fee = max 0.0 (sum [daysAfter (requestedAt `addRelTime` days 90) newExpiresAt]
          - sum [daysAfter requestedAt oldExpiresAt])
        / 365.0 * 1.0 / env.amuletPrice
  balanceBefore <- amuletBalance env.holder
  Right result <- tryPublish env [env.holder, env.issuer] [credentialCid]
    [withExpiry newExpiresAt] requestedAt
    (paymentExtraArgs env (Some env.holder) (Some [holding]))
  balanceAfter <- amuletBalance env.holder
  balanceBefore - balanceAfter === fee
  let [renewedCid] = newRecordCids result
  assertCredential env renewedCid [exampleClaim] None None requestedAt newExpiresAt

-- | A config that sets only some fields uses the CIP defaults for the others.
test_registry_partial_config : Script ()
test_registry_partial_config = do
  env <- setupCredentialEnvWith (Some CredentialRegistryConfig with
    freePeriod = Some (days 30)
    extensionUsdPerYear = None)
  env.config === RegistryParams with freePeriod = days 30; extensionUsdPerYear = 1.0
  (credentialCid, createdAt) <- createCredential env env.issuer env.holder [exampleClaim]
  assertCredential env credentialCid [exampleClaim] None None createdAt
    (createdAt `addRelTime` days 30)

test_update_credential : Script ()
test_update_credential = do
  env <- setupCredentialEnv
  (oldCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  requestedAt <- pastRequestedAt
  let updatedClaim = exampleClaim with property = "example.com/email"; value = "alice@example.com"
  result <- submit (issuerAndHolder env) $
    updateCredentialsCmd env [oldCid] [simpleCredentialParams [updatedClaim]] requestedAt
      (registryConfigContext env.configStateCid)
  None <- queryContractId env.holder oldCid
  let [newCid] = map (fromInterfaceContractId @CredentialRecord) result.newCredentials
  assertCredential env newCid [updatedClaim] None None requestedAt
    (requestedAt `addRelTime` env.config.freePeriod)
  -- Archiving without new records needs no snapshot in the context.
  archived <- submit (issuerAndHolder env) $
    updateCredentialsCmd env [newCid] [] requestedAt (ChoiceContext with values = TextMap.empty)
  assert $ null archived.newCredentials
  None <- queryContractId env.holder newCid
  -- Held by the issuer, so it is not this holder's record.
  (otherCid, _) <- createCredential env env.issuer env.issuer [exampleClaim]
  updateCredentialMustFail env requestedAt [updatedClaim] [otherCid]
  -- Self-published by the holder, so another issuer cannot replace it.
  (selfPublishedCid, _) <- createCredential env env.holder env.holder [exampleClaim]
  updateCredentialMustFail env requestedAt [updatedClaim] [selfPublishedCid]
  Some _ <- queryContractId env.issuer otherCid
  Some _ <- queryContractId env.holder selfPublishedCid
  pure ()

test_revoke_credential : Script ()
test_revoke_credential = do
  env <- setupCredentialEnv
  outsider <- allocateParty "outsider"
  (holderCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (issuerCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (keptCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  submit env.holder $
    exerciseCmd (toInterfaceContractId @RecordV1.Credential holderCid) RecordV1.Credential_Revoke with
      actors = [env.holder]
  submit env.issuer $
    exerciseCmd (toInterfaceContractId @RecordV1.Credential issuerCid) RecordV1.Credential_Revoke with
      actors = [env.issuer]
  None <- queryContractId env.holder holderCid
  None <- queryContractId env.issuer issuerCid
  revokeMustFail env outsider keptCid
  revokeMustFail env env.dso keptCid
  Some _ <- queryContractId env.holder keptCid
  pure ()

test_expire_credential : Script ()
test_expire_credential = do
  env <- setupCredentialEnv
  outsider <- allocateParty "outsider"
  (holderCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (issuerCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (registryExpiredCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  -- an explicit expiry within the free period is free and ends the lease earlier
  shortRequestedAt <- pastRequestedAt
  Right shortResult <- tryPublish env [env.holder, env.issuer] []
    [withExpiry (shortRequestedAt `addRelTime` days 11)] shortRequestedAt
    (paymentExtraArgs env None None)
  let [shortCid] = newRecordCids shortResult
  submitMustFail env.holder $ exerciseCmd shortCid Credential_Expire with actor = env.holder
  passTime (days 12)
  submit env.holder $ exerciseCmd shortCid Credential_Expire with actor = env.holder
  submitMustFail env.holder $ exerciseCmd holderCid Credential_Expire with actor = env.holder
  passTime env.config.freePeriod
  trySubmit (actAs outsider <> readAs env.holder) (exerciseCmd holderCid Credential_Expire with actor = outsider)
    >>= mustFailWith "actor is stakeholder"
  submit env.holder $ exerciseCmd holderCid Credential_Expire with actor = env.holder
  submit env.issuer $ exerciseCmd issuerCid Credential_Expire with actor = env.issuer
  submit env.dso $ exerciseCmd registryExpiredCid Credential_Expire with actor = env.dso
  None <- queryContractId env.holder holderCid
  None <- queryContractId env.issuer issuerCid
  None <- queryContractId env.dso registryExpiredCid
  pure ()

-- | The holder pays for 146 days beyond the free period: one burn of 0.4 USD,
-- and the change stays with the holder.
test_paid_expiry_by_holder : Script ()
test_paid_expiry_by_holder = do
  env <- setupCredentialEnv
  holding <- tap env.app env.holderUser 7.0
  requestedAt <- pastRequestedAt
  let expiresAt = requestedAt `addRelTime` (env.config.freePeriod + days 146)
      fee = 146.0 / 365.0 * env.config.extensionUsdPerYear / env.amuletPrice
  balanceBefore <- amuletBalance env.holder
  Right result <- tryPublish env [env.holder, env.issuer] [] [withExpiry expiresAt] requestedAt
    (paymentExtraArgs env (Some env.holder) (Some [holding]))
  balanceAfter <- amuletBalance env.holder
  balanceBefore - balanceAfter === fee
  let [credentialCid] = newRecordCids result
  assertCredential env credentialCid [exampleClaim] None None requestedAt expiresAt
  amulets <- ownAmulets env.holder
  assert $ any (\(_, amulet) -> amulet.amount.initialAmount == 7.0 - fee) amulets

-- | A third party pays: it must be one of the actors and own the holdings.
-- The holder's and the issuer's balances stay the same.
test_paid_expiry_by_third_party : Script ()
test_paid_expiry_by_third_party = do
  env <- setupCredentialEnv
  (payerUser, _) <- setupSelfHostedUser env.app "carol"
  let payer = payerUser.primaryParty
  holding <- tap env.app payerUser 5.0
  requestedAt <- pastRequestedAt
  let expiresAt = requestedAt `addRelTime` (env.config.freePeriod + days 219)
      fee = 219.0 / 365.0 * env.config.extensionUsdPerYear / env.amuletPrice
  holderBefore <- amuletBalance env.holder
  payerBefore <- amuletBalance payer
  Right result <- tryPublish env [env.holder, env.issuer, payer] [] [withExpiry expiresAt] requestedAt
    (paymentExtraArgs env (Some payer) (Some [holding]))
  payerAfter <- amuletBalance payer
  holderAfter <- amuletBalance env.holder
  payerBefore - payerAfter === fee
  holderAfter === holderBefore
  let [credentialCid] = newRecordCids result
  assertCredential env credentialCid [exampleClaim] None None requestedAt expiresAt

-- | One call renews two records into three with different expiries and burns once:
-- each new record gets its own free period, the lease beyond it is (73 + 219) days,
-- and the lease the two archived records still have is credited against it.
test_bulk_renewal : Script ()
test_bulk_renewal = do
  env <- setupCredentialEnv
  (firstCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (secondCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  Some first <- queryContractId env.holder firstCid
  Some second <- queryContractId env.holder secondCid
  holding <- tap env.app env.holderUser 9.0
  requestedAt <- pastRequestedAt
  let freeUntil = requestedAt `addRelTime` env.config.freePeriod
      emailClaim = exampleClaim with property = "example.com/email"; value = "bob@example.com"
      params =
        [ simpleCredentialParams [exampleClaim]
        , withExpiry (freeUntil `addRelTime` days 73)
        , (simpleCredentialParams [emailClaim]) with expiresAt = Some (freeUntil `addRelTime` days 219)
        ]
      leaseToPay = sum [0.0, 73.0, 219.0]
      remainingLease = sum [daysAfter requestedAt first.expiresAt, daysAfter requestedAt second.expiresAt]
      fee = max 0.0 (leaseToPay - remainingLease) / 365.0 * env.config.extensionUsdPerYear / env.amuletPrice
  balanceBefore <- amuletBalance env.holder
  Right result <- tryPublish env [env.holder, env.issuer] [firstCid, secondCid] params requestedAt
    (paymentExtraArgs env (Some env.holder) (Some [holding]))
  balanceAfter <- amuletBalance env.holder
  balanceBefore - balanceAfter === fee
  None <- queryContractId env.holder firstCid
  None <- queryContractId env.holder secondCid
  let [defaultCid, shortCid, longCid] = newRecordCids result
  assertCredential env defaultCid [exampleClaim] None None requestedAt freeUntil
  assertCredential env shortCid [exampleClaim] None None requestedAt (freeUntil `addRelTime` days 73)
  assertCredential env longCid [emailClaim] None None requestedAt (freeUntil `addRelTime` days 219)

-- | Rejected payments and expiries. None of them burns anything or creates a record.
test_paid_expiry_rejected : Script ()
test_paid_expiry_rejected = do
  env <- setupCredentialEnv
  (payerUser, _) <- setupSelfHostedUser env.app "carol"
  let payer = payerUser.primaryParty
  holding <- tap env.app env.holderUser 3.0
  smallHolding <- tap env.app env.holderUser 0.05
  issuerHolding <- tap env.app env.issuerUser 3.0
  (oldCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  requestedAt <- pastRequestedAt
  let paid = withExpiry (requestedAt `addRelTime` (env.config.freePeriod + days 37))
      holderPays = paymentExtraArgs env (Some env.holder) (Some [holding])
      both = [env.holder, env.issuer]
  balanceBefore <- amuletBalance env.holder
  -- a fee needs a payer and holdings
  tryPublish env both [] [paid] requestedAt (paymentExtraArgs env None None)
    >>= mustFailWith expiryPaidByMetaKey
  tryPublish env both [] [paid] requestedAt (paymentExtraArgs env (Some env.holder) None)
    >>= mustFail
  tryPublish env both [] [paid] requestedAt (paymentExtraArgs env (Some env.holder) (Some [smallHolding]))
    >>= mustFail
  -- the paying party must be a valid party id
  let invalidPayer = (paymentExtraArgs env None (Some [holding])) with
        meta = Metadata with values = TextMap.fromList [(expiryPaidByMetaKey, "not a party")]
  tryPublish env both [] [paid] requestedAt invalidPayer
    >>= mustFailWith "invalid party in"
  -- no fee, or no new record, means no payment
  tryPublish env both [] [simpleCredentialParams [exampleClaim]] requestedAt holderPays
    >>= mustFailWith "no fee to pay"
  tryPublish env both [oldCid] [] requestedAt holderPays
    >>= mustFailWith "a payment needs new credentials"
  -- the payer must be one of the actors, and the holdings must be its own
  trySubmit (actAs env.holder <> actAs env.issuer <> actAs payer
      <> readAs env.dso)
    (publishCmd env both [] [paid] requestedAt
      (paymentExtraArgs env (Some payer) (Some [holding])))
    >>= mustFailWith "actors"
  tryPublish env both [] [paid] requestedAt
    (paymentExtraArgs env (Some env.holder) (Some [issuerHolding]))
    >>= mustFailWith "Contract group identifier mismatch"
  -- the actors must include both the holder and the issuer
  trySubmit (actAs env.holder <> readAs env.dso)
    (publishCmd env [env.holder] [] [simpleCredentialParams [exampleClaim]] requestedAt
      (paymentExtraArgs env None None))
    >>= mustFailWith "actors"
  -- an explicit expiry in the past, or after validUntil
  tryPublish env both [] [withExpiry (requestedAt `addRelTime` milliseconds 500)] requestedAt
    (paymentExtraArgs env None None)
    >>= mustFailWith "expiresAt"
  tryPublish env both []
    [paid with validUntil = Some (requestedAt `addRelTime` days 30)] requestedAt holderPays
    >>= mustFailWith "precondition"
  balanceAfter <- amuletBalance env.holder
  balanceAfter === balanceBefore
  Some _ <- queryContractId env.holder oldCid
  [_] <- query @CredentialRecord env.holder
  pure ()

-- | Renewing a record that has not expired yet adds the free period to its old expiry,
-- so only the lease beyond `old expiresAt + freePeriod` is paid: here 10 days and 7 hours,
-- computed at full precision.
test_renewal_pays_beyond_old_expiry_and_free_period : Script ()
test_renewal_pays_beyond_old_expiry_and_free_period = do
  env <- setupCredentialEnv
  holding <- tap env.app env.holderUser 9.0
  firstRequestedAt <- pastRequestedAt
  Right first <- tryPublish env [env.holder, env.issuer] []
    [withExpiry (firstRequestedAt `addRelTime` (env.config.freePeriod + days 292))] firstRequestedAt
    (paymentExtraArgs env (Some env.holder) (Some [holding]))
  let [paidCid] = newRecordCids first
  Some paid <- queryContractId env.holder paidCid
  change <- map fst <$> ownAmulets env.holder
  requestedAt <- pastRequestedAt
  let freeUntil = requestedAt `addRelTime` env.config.freePeriod
      newExpiresAt = paid.expiresAt `addRelTime` (env.config.freePeriod + days 10 + hours 7)
      fee = max 0.0 (sum [daysAfter freeUntil newExpiresAt] - sum [daysAfter requestedAt paid.expiresAt])
        / 365.0 * env.config.extensionUsdPerYear / env.amuletPrice
  balanceBefore <- amuletBalance env.holder
  Right renewed <- tryPublish env [env.holder, env.issuer] [paidCid] [withExpiry newExpiresAt] requestedAt
    (paymentExtraArgs env (Some env.holder) (Some change))
  balanceAfter <- amuletBalance env.holder
  balanceBefore - balanceAfter === fee
  let [renewedCid] = newRecordCids renewed
  assertCredential env renewedCid [exampleClaim] None None requestedAt newExpiresAt

-- | Renewing a record up to its old expiry plus the free period is free,
-- and the old record's createdAt bounds the requestedAt of the renewal.
test_renewal_adds_free_period : Script ()
test_renewal_adds_free_period = do
  env <- setupCredentialEnv
  holding <- tap env.app env.holderUser 4.0
  firstRequestedAt <- pastRequestedAt
  Right first <- tryPublish env [env.holder, env.issuer] []
    [withExpiry (firstRequestedAt `addRelTime` (env.config.freePeriod + days 219))] firstRequestedAt
    (paymentExtraArgs env (Some env.holder) (Some [holding]))
  let [paidCid] = newRecordCids first
  Some paid <- queryContractId env.holder paidCid
  -- requestedAt before the old record's createdAt is rejected
  tryPublish env [env.holder, env.issuer] [paidCid]
    [withExpiry paid.expiresAt] (firstRequestedAt `addRelTime` hours (-3)) (paymentExtraArgs env None None)
    >>= mustFailWith "requestedAt is not before the createdAt of an archived record"
  requestedAt <- pastRequestedAt
  let renewedExpiresAt = paid.expiresAt `addRelTime` env.config.freePeriod
  Right renewed <- tryPublish env [env.holder, env.issuer] [paidCid] [withExpiry renewedExpiresAt] requestedAt
    (paymentExtraArgs env None None)
  let [renewedCid] = newRecordCids renewed
  assertCredential env renewedCid [exampleClaim] None None requestedAt renewedExpiresAt

-- | A default expiry that is already in the past is rejected:
-- validUntil has passed, so the record would be born expired.
test_default_expiry_in_the_past_rejected : Script ()
test_default_expiry_in_the_past_rejected = do
  env <- setupCredentialEnv
  start <- getTime
  passTime (hours 23)
  let requestedAt = start `addRelTime` minutes 5
      validUntil = start `addRelTime` hours 22
  tryPublish env [env.holder, env.issuer] []
    [(simpleCredentialParams [exampleClaim]) with validUntil = Some validUntil] requestedAt
    (paymentExtraArgs env None None)
    >>= mustFailWith "expiresAt"

-- | Anyone can fetch the factory view; the registry does not restrict the actors.
test_public_fetch_factory : Script ()
test_public_fetch_factory = do
  env <- setupCredentialEnv
  outsider <- allocateParty "outsider"
  factoryView <- submit (actAs outsider <> readAs env.dso) $
    exerciseCmd (toInterfaceContractId @PublicationV1.CredentialFactory env.rulesCid)
      PublicationV1.CredentialFactory_PublicFetch with actors = [outsider]
  factoryView.admin === env.dso

-- | A SetConfig vote archives AmuletRules. Issuance and renewal against the
-- earlier snapshot still run with its free period, and the next snapshot carries the vote.
test_set_config_keeps_prepared_credential_calls : Script ()
test_set_config_keeps_prepared_credential_calls = do
  env <- setupCredentialEnv
  updateAmuletConfig env.app (\c -> c with
    credentialRegistryConfig = Some (freePeriodOnly (days 1)))
  (credentialCid, createdAt) <- createCredential env env.issuer env.holder [exampleClaim]
  assertCredential env credentialCid [exampleClaim] None None createdAt
    (createdAt `addRelTime` env.config.freePeriod)
  updateAmuletConfig env.app (\c -> c with
    credentialRegistryConfig = Some (freePeriodOnly (days 2)))
  requestedAt <- pastRequestedAt
  Right result <- tryPublish env [env.holder, env.issuer] [credentialCid]
    [simpleCredentialParams [exampleClaim]] requestedAt (paymentExtraArgs env None None)
  let [renewedCid] = newRecordCids result
  assertCredential env renewedCid [exampleClaim] None None requestedAt
    (requestedAt `addRelTime` env.config.freePeriod)
  passTime (days 2)
  updateExternalPartyConfigState env.app
  (_, newestCid) <- getExternalPartyConfigStates env.app
  Some newest <- queryContractId @ExternalPartyConfigState env.dso newestCid
  newest.credentialRegistryConfig === Some (freePeriodOnly (days 2))

-- | Parties, factory, snapshot, and the registry config used by the credential scripts.
data CredentialEnv = CredentialEnv with
    dso : Party
    issuer : Party
    holder : Party
    rulesCid : ContractId ExternalPartyAmuletRules
    issuerUser : AmuletUser
    holderUser : AmuletUser
    app : AmuletApp
    configStateCid : ContractId ExternalPartyConfigState
    config : RegistryParams
    amuletPrice : Decimal

-- | Registry parameters in effect on the snapshot, after applying the CIP defaults.
data RegistryParams = RegistryParams with
    freePeriod : RelTime
    extensionUsdPerYear : Decimal
  deriving (Eq, Show)

-- | Helper: a registry config that overrides only the free period.
freePeriodOnly : RelTime -> CredentialRegistryConfig
freePeriodOnly freePeriod = CredentialRegistryConfig with
  freePeriod = Some freePeriod
  extensionUsdPerYear = None

-- | Helper: the holder sees these fields, and the issuer sees the same record.
assertCredential
  : CredentialEnv
  -> ContractId CredentialRecord
  -> [RecordV1.Claim]
  -> Optional Time
  -> Optional Time
  -> Time
  -> Time
  -> Script ()
assertCredential env cid claims validFrom validUntil createdAt expiresAt = do
  Some record <- queryContractId env.holder cid
  record === CredentialRecord with
    dso = env.dso
    issuer = env.issuer
    holder = env.holder
    claims
    validFrom
    validUntil
    createdAt
    expiresAt
  Some issuerRecord <- queryContractId env.issuer cid
  issuerRecord === record

-- | 90 days of free registry lease and $1 per extra year.
defaultCredentialRegistryConfig : CredentialRegistryConfig
defaultCredentialRegistryConfig = CredentialRegistryConfig with
  freePeriod = Some (days 90)
  extensionUsdPerYear = Some 1.0

-- | Helper: parties, factory, and registry config copied onto the external-party snapshot.
setupCredentialEnv : Script CredentialEnv
setupCredentialEnv = setupCredentialEnvWith (Some defaultCredentialRegistryConfig)

-- | Helper: as `setupCredentialEnv`, with this registry config in AmuletConfig.
-- With `None` the snapshot carries no registry config, and `config` holds the CIP defaults.
setupCredentialEnvWith : Optional CredentialRegistryConfig -> Script CredentialEnv
setupCredentialEnvWith registryConfig = do
  app <- setupAppWithConfig $ defaultAmuletConfig with
    credentialRegistryConfig = registryConfig
  (issuerUser, _) <- setupSelfHostedUser app "alice"
  (holderUser, _) <- setupSelfHostedUser app "bob"
  let dso = app.dso
      issuer = issuerUser.primaryParty
      holder = holderUser.primaryParty
  (rulesCid, _) <- getExternalPartyAmuletRules app
  (_, configStateCid) <- getExternalPartyConfigStates app
  Some state <- queryContractId @ExternalPartyConfigState dso configStateCid
  let config = RegistryParams with
        freePeriod = credentialRegistryFreePeriod state.credentialRegistryConfig
        extensionUsdPerYear = credentialRegistryExtensionUsdPerYear state.credentialRegistryConfig
      amuletPrice = state.amuletPrice
  pure CredentialEnv with ..

-- | Context entry the factory reads.
registryConfigContext : ContractId ExternalPartyConfigState -> ChoiceContext
registryConfigContext configStateCid = ChoiceContext with
  values = TextMap.fromList
    [(externalPartyConfigStateContextKey, toAnyValue configStateCid)]

-- | One claim used by the happy-path scripts.
exampleClaim : RecordV1.Claim
exampleClaim = RecordV1.Claim with
  subject = None
  property = "example.com/name"
  value = "alice"

-- | A credential with no validity window.
simpleCredentialParams : [RecordV1.Claim] -> PublicationV1.CredentialParams
simpleCredentialParams claims = PublicationV1.CredentialParams with
  claims
  validFrom = None
  validUntil = None
  expiresAt = None

-- | The example claim with this explicit expiry.
withExpiry : Time -> PublicationV1.CredentialParams
withExpiry expiresAt = (simpleCredentialParams [exampleClaim]) with expiresAt = Some expiresAt

-- | A timestamp already behind ledger time. The factory rejects requestedAt that is not in the past.
pastRequestedAt : Script Time
pastRequestedAt = do
  requestedAt <- getTime
  passTime (seconds 1)
  pure requestedAt

-- | Helper: the issuer and holder of the env, with read access to the registry.
issuerAndHolder : CredentialEnv -> SubmitOptions
issuerAndHolder env = actAs env.holder <> actAs env.issuer <>
  readAs env.dso

-- | Helper: the env issuer and holder archive `old` and record `new`.
updateCredentialsCmd
  : CredentialEnv
  -> [ContractId CredentialRecord]
  -> [PublicationV1.CredentialParams]
  -> Time
  -> ChoiceContext
  -> Commands PublicationV1.CredentialFactory_UpdateCredentialsResult
updateCredentialsCmd env old new requestedAt context =
  publishCmd env [env.holder, env.issuer] old new requestedAt ExtraArgs with
    context
    meta = emptyMetadata

-- | Helper: the update command with these actors and extra args.
publishCmd
  : CredentialEnv
  -> [Party]
  -> [ContractId CredentialRecord]
  -> [PublicationV1.CredentialParams]
  -> Time
  -> ExtraArgs
  -> Commands PublicationV1.CredentialFactory_UpdateCredentialsResult
publishCmd env actors old new requestedAt extraArgs =
  exerciseCmd
    (toInterfaceContractId @PublicationV1.CredentialFactory env.rulesCid)
    PublicationV1.CredentialFactory_UpdateCredentials with
      admin = env.dso
      holder = env.holder
      issuer = env.issuer
      actors
      oldCredentials = map (toInterfaceContractId @RecordV1.Credential) old
      newCredentials = new
      requestedAt
      extraArgs

-- | Helper: the actors submit this update, with read access to the registry.
tryPublish
  : CredentialEnv
  -> [Party]
  -> [ContractId CredentialRecord]
  -> [PublicationV1.CredentialParams]
  -> Time
  -> ExtraArgs
  -> Script (Either SubmitError PublicationV1.CredentialFactory_UpdateCredentialsResult)
tryPublish env actors old new requestedAt extraArgs =
  trySubmit (actAs actors <> readAs env.dso) $
    publishCmd env actors old new requestedAt extraArgs

-- | Helper: extra args with the snapshot, and optionally the paying party and its holdings.
paymentExtraArgs : CredentialEnv -> Optional Party -> Optional [ContractId Amulet] -> ExtraArgs
paymentExtraArgs env payer holdings =
  let configEntry = (externalPartyConfigStateContextKey, toAnyValue env.configStateCid)
      fundingEntries = case holdings of
        None -> []
        Some cids -> [(expiryFundingContextKey, toAnyValue (map (toInterfaceContractId @HoldingV1.Holding) cids))]
      payerEntries = case payer of
        None -> []
        Some party -> [(expiryPaidByMetaKey, partyToText party)]
  in ExtraArgs with
    context = ChoiceContext with
      values = TextMap.fromList (configEntry :: fundingEntries)
    meta = Metadata with
      values = TextMap.fromList payerEntries

-- | Helper: the records created by an update, in order.
newRecordCids : PublicationV1.CredentialFactory_UpdateCredentialsResult -> [ContractId CredentialRecord]
newRecordCids result = map (fromInterfaceContractId @CredentialRecord) result.newCredentials

-- | Helper: issuer and holder create one record.
createCredential
  : CredentialEnv
  -> Party
  -> Party
  -> [RecordV1.Claim]
  -> Script (ContractId CredentialRecord, Time)
createCredential env issuer holder claims =
  createCredentialWith (env with issuer; holder) (simpleCredentialParams claims)

-- | Helper: the env issuer and holder create the example claim, valid for `validity` from requestedAt.
createCredentialUntil : CredentialEnv -> RelTime -> Script (ContractId CredentialRecord, Time)
createCredentialUntil env validity = do
  requestedAt <- getTime
  createCredentialWith env (simpleCredentialParams [exampleClaim]) with
    validUntil = Some (requestedAt `addRelTime` validity)

createCredentialWith : CredentialEnv -> PublicationV1.CredentialParams -> Script (ContractId CredentialRecord, Time)
createCredentialWith env params = do
  requestedAt <- pastRequestedAt
  result <- submit (issuerAndHolder env) $
    updateCredentialsCmd env [] [params] requestedAt (registryConfigContext env.configStateCid)
  let [cid] = map (fromInterfaceContractId @CredentialRecord) result.newCredentials
  pure (cid, requestedAt)

-- | Helper: the factory rejects this new record.
createCredentialMustFail
  : CredentialEnv
  -> Time
  -> [RecordV1.Claim]
  -> Optional Time
  -> Optional Time
  -> Script ()
createCredentialMustFail env requestedAt claims validFrom validUntil =
  submitMustFail (issuerAndHolder env) $
    updateCredentialsCmd env [] [PublicationV1.CredentialParams with claims; validFrom; validUntil; expiresAt = None]
      requestedAt (registryConfigContext env.configStateCid)

-- | Helper: the factory rejects this update of an old record.
updateCredentialMustFail
  : CredentialEnv
  -> Time
  -> [RecordV1.Claim]
  -> [ContractId CredentialRecord]
  -> Script ()
updateCredentialMustFail env requestedAt claims oldCredentials =
  submitMustFail (issuerAndHolder env) $
    updateCredentialsCmd env oldCredentials [simpleCredentialParams claims] requestedAt
      (registryConfigContext env.configStateCid)

-- | Helper: this actor cannot revoke the record.
revokeMustFail : CredentialEnv -> Party -> ContractId CredentialRecord -> Script ()
revokeMustFail env actor cid =
  submitMustFail (actAs actor <> readAs env.dso) $
    exerciseCmd (toInterfaceContractId @RecordV1.Credential cid) RecordV1.Credential_Revoke with
      actors = [actor]

-- | Helper: the lease from `start` to `end` in days, as the registry computes it.
daysAfter : Time -> Time -> Decimal
daysAfter start end = relTimeToDays (max (seconds 0) (subTime end start))

-- | Helper: the Amulet holdings this party owns.
ownAmulets : Party -> Script [(ContractId Amulet, Amulet)]
ownAmulets owner = do
  amulets <- query @Amulet owner
  pure [(cid, amulet) | (cid, amulet) <- amulets, amulet.owner == owner]

-- | Helper: total initial amount of the Amulet holdings this party owns.
amuletBalance : Party -> Script Decimal
amuletBalance owner = do
  amulets <- query @Amulet owner
  pure $ sum [amulet.amount.initialAmount | (_, amulet) <- amulets, amulet.owner == owner]

-- | Helper: the submission failed.
mustFail : Either SubmitError a -> Script ()
mustFail (Right _) = fail "Expected a failure, but the submission succeeded"
mustFail (Left _) = pure ()

-- | Helper: the submission failed, and its error mentions this text.
mustFailWith : Text -> Either SubmitError a -> Script ()
mustFailWith needle (Right _) =
  fail $ "Expected a failure containing '" <> needle <> "', but the submission succeeded"
mustFailWith needle (Left err) =
  unless (needle `T.isInfixOf` show err) $
    fail $ "Expected a failure containing '" <> needle <> "', got: " <> show err
