module Splice.Scripts.TestCredentials where

import DA.Text qualified as T
import qualified DA.TextMap as TextMap
import DA.Time
import Daml.Script

import Splice.Api.Credential.RecordV1 qualified as RecordV1
import Splice.Api.Credential.RegistryPublicationV1 qualified as PublicationV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1 qualified as TransferV1
import Splice.Api.Token.TransferInstructionV2 qualified as TransferV2

import Splice.Amulet.TokenApiUtils (ToAnyValue(..), amuletInstrumentId, amuletInstrumentIdV2, reasonMetaKey)
import Splice.CredentialRegistryConfig
import Splice.Credentials
import Splice.Scripts.Util

test_create_credential : Script ()
test_create_credential = do
  env <- setupCredentialEnv
  requestedAt <- pastRequestedAt
  result <- submit (actAs env.holder <> actAs env.issuer <> readAs env.dso) $
    exerciseCmd
      (toInterfaceContractId @PublicationV1.CredentialFactory env.registryCid)
      PublicationV1.CredentialFactory_UpdateCredentials with
        admin = env.dso
        holder = env.holder
        issuer = env.issuer
        oldCredentials = []
        newCredentials = [simpleCredentialParams [exampleClaim]]
        requestedAt
        extraArgs = ExtraArgs with
          context = registryConfigContext env.configCid
          meta = emptyMetadata
  let [credentialCid] = map (fromInterfaceContractId @CredentialRecord) result.newCredentials
  assertCredential env credentialCid [exampleClaim] None None requestedAt
    (requestedAt `addRelTime` env.config.freePeriod)

test_create_credential_rejected : Script ()
test_create_credential_rejected = do
  env <- setupCredentialEnv
  start <- getTime
  passTime (days 1)
  let requestedAt = start `addRelTime` hours 1
      before = Some start
      atCreated = Some requestedAt
      after = Some (requestedAt `addRelTime` hours 1)
      long256 = T.implode (replicate 256 "a")
      long2048 = T.implode (replicate 2048 "a")
      named = exampleClaim with subject = Some "bob"
      tooMany = map (\n -> exampleClaim with property = "example.com/c" <> show n) [1 .. 33]
  -- property character and length
  createCredentialMustFail env requestedAt [exampleClaim with property = "example.com/bad name"] None None
  createCredentialMustFail env requestedAt [exampleClaim with property = long256] None None
  -- subject empty, equal to the holder, too long, or an illegal character
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some ""] None None
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some (partyToText env.holder)] None None
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some long256] None None
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some "bob@example"] None None
  -- value length and claim count
  createCredentialMustFail env requestedAt [exampleClaim with value = long2048] None None
  createCredentialMustFail env requestedAt tooMany None None
  -- duplicate (subject, property), including two unset subjects
  createCredentialMustFail env requestedAt [exampleClaim, exampleClaim] None None
  createCredentialMustFail env requestedAt [named, named] None None
  -- validFrom is not before validUntil, or validUntil is not after createdAt
  createCredentialMustFail env requestedAt [exampleClaim] after after
  createCredentialMustFail env requestedAt [exampleClaim] before atCreated
  createCredentialMustFail env requestedAt [exampleClaim] None atCreated
  [] <- query @CredentialRecord env.holder
  pure ()

test_update_credential : Script ()
test_update_credential = do
  env <- setupCredentialEnv
  (oldCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  requestedAt <- pastRequestedAt
  let updatedClaim = exampleClaim with property = "example.com/email"; value = "alice@example.com"
  result <- submit (actAs env.holder <> actAs env.issuer <> readAs env.dso) $
    exerciseCmd
      (toInterfaceContractId @PublicationV1.CredentialFactory env.registryCid)
      PublicationV1.CredentialFactory_UpdateCredentials with
        admin = env.dso
        holder = env.holder
        issuer = env.issuer
        oldCredentials = [toInterfaceContractId @RecordV1.Credential oldCid]
        newCredentials = [simpleCredentialParams [updatedClaim]]
        requestedAt
        extraArgs = ExtraArgs with
          context = registryConfigContext env.configCid
          meta = emptyMetadata
  None <- queryContractId env.holder oldCid
  let [newCid] = map (fromInterfaceContractId @CredentialRecord) result.newCredentials
  assertCredential env newCid [updatedClaim] None None requestedAt
    (requestedAt `addRelTime` env.config.freePeriod)
  -- Held by the issuer, so it is not this holder's record.
  (otherCid, _) <- createCredential env env.issuer env.issuer [exampleClaim]
  updateCredentialMustFail env requestedAt [updatedClaim] [otherCid]
  Some _ <- queryContractId env.issuer otherCid
  pure ()

test_revoke_credential : Script ()
test_revoke_credential = do
  env <- setupCredentialEnv
  outsider <- allocateParty "outsider"
  (holderCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (issuerCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (keptCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  submit env.holder $
    exerciseCmd (toInterfaceContractId @RecordV1.Credential holderCid) RecordV1.Credential_Revoke with
      actors = [env.holder]
  submit env.issuer $
    exerciseCmd (toInterfaceContractId @RecordV1.Credential issuerCid) RecordV1.Credential_Revoke with
      actors = [env.issuer]
  None <- queryContractId env.holder holderCid
  None <- queryContractId env.issuer issuerCid
  revokeMustFail env outsider keptCid
  revokeMustFail env env.dso keptCid
  Some _ <- queryContractId env.holder keptCid
  pure ()

test_expire_credential : Script ()
test_expire_credential = do
  env <- setupCredentialEnv
  (holderCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (issuerCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (dsoCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  submitMustFail env.holder $ exerciseCmd holderCid Credential_Expire with actor = env.holder
  passTime env.config.freePeriod
  passTime (days 1)
  submit env.holder $ exerciseCmd holderCid Credential_Expire with actor = env.holder
  submit env.issuer $ exerciseCmd issuerCid Credential_Expire with actor = env.issuer
  submit env.dso $ exerciseCmd dsoCid Credential_Expire with actor = env.dso
  None <- queryContractId env.holder holderCid
  None <- queryContractId env.issuer issuerCid
  None <- queryContractId env.dso dsoCid
  pure ()

test_extend_credential : Script ()
test_extend_credential = do
  env <- setupCredentialEnv
  (holderCid, holderCreatedAt) <- createCredential env env.issuer env.holder [exampleClaim]
  holderRequestedAt <- pastRequestedAt
  holderNow <- getTime
  submit (actAs env.holder <> readAs env.dso) $
    exerciseCmd
      (toInterfaceContractId @TransferV1.TransferFactory env.registryCid)
      TransferV1.TransferFactory_Transfer with
        expectedAdmin = env.dso
        transfer = expiryTransfer env env.holder holderRequestedAt (holderNow `addRelTime` days 1)
        extraArgs = ExtraArgs with
          context = expiryChoiceContext env.configCid holderCid
          meta = emptyMetadata
  None <- queryContractId env.holder holderCid
  let holderExpiresAt = holderCreatedAt `addRelTime` env.config.freePeriod `addRelTime` env.config.freePeriod
  [(extendedHolderCid, _)] <- query @CredentialRecord env.holder
  assertCredential env extendedHolderCid [exampleClaim] None None holderCreatedAt holderExpiresAt
  (issuerCid, issuerCreatedAt) <- createCredential env env.issuer env.holder [exampleClaim]
  issuerRequestedAt <- pastRequestedAt
  issuerNow <- getTime
  submit (actAs env.issuer <> readAs env.dso) $
    exerciseCmd
      (toInterfaceContractId @TransferV2.TransferFactory env.registryCid)
      TransferV2.TransferFactory_Transfer with
        transfer = expiryTransferV2 env env.issuer issuerRequestedAt (issuerNow `addRelTime` days 1)
        actors = [env.issuer]
        extraArgs = ExtraArgs with
          context = expiryChoiceContext env.configCid issuerCid
          meta = emptyMetadata
  None <- queryContractId env.holder issuerCid
  let issuerExpiresAt = issuerCreatedAt `addRelTime` env.config.freePeriod `addRelTime` env.config.freePeriod
  [(extendedIssuerCid, _)] <- queryFilter @CredentialRecord env.holder
    (\record -> record.createdAt == issuerCreatedAt)
  assertCredential env extendedIssuerCid [exampleClaim] None None issuerCreatedAt issuerExpiresAt

test_extend_credential_rejected : Script ()
test_extend_credential_rejected = do
  env <- setupCredentialEnv
  outsider <- allocateParty "outsider"
  (credentialCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  requestedAt <- pastRequestedAt
  now <- getTime
  let executeBefore = now `addRelTime` days 1
      context = expiryChoiceContext env.configCid credentialCid
      valid = expiryTransfer env env.holder requestedAt executeBefore
      notAmulet = (amuletInstrumentId env.dso) with id = "NotAmulet"
      hostedSender = (basicAccount env.holder) with provider = Some env.issuer
  -- receiver, memo, and instrument
  extendCredentialMustFail env env.dso env.holder (valid with receiver = env.holder) context
  extendCredentialMustFail env env.dso env.holder (valid with meta = emptyMetadata) context
  extendCredentialMustFail env env.dso env.holder (valid with instrumentId = notAmulet) context
  -- admin, sender, amount, and deadlines
  extendCredentialMustFail env outsider env.holder valid context
  extendCredentialMustFail env env.dso outsider (valid with sender = outsider) context
  extendCredentialMustFail env env.dso env.holder (valid with amount = 1.0) context
  extendCredentialMustFail env env.dso env.holder (valid with amount = -1.0) context
  extendCredentialMustFail env env.dso env.holder (valid with executeBefore = requestedAt) context
  extendCredentialMustFail env env.dso env.holder
    (valid with requestedAt = now `addRelTime` hours 1; executeBefore = now `addRelTime` days 2) context
  -- credential cid missing from the context
  extendCredentialMustFail env env.dso env.holder valid (registryConfigContext env.configCid)
  -- v2 account is not basic, or the actor is not the sender
  extendCredentialV2MustFail env env.holder
    ((expiryTransferV2 env env.holder requestedAt executeBefore) with sender = hostedSender)
    context
  extendCredentialV2MustFail env env.issuer (expiryTransferV2 env env.holder requestedAt executeBefore) context
  Some _ <- queryContractId env.holder credentialCid
  pure ()

-- | Parties, factory, and the registry config used by the credential scripts.
data CredentialEnv = CredentialEnv with
    dso : Party
    issuer : Party
    holder : Party
    registryCid : ContractId CredentialRegistry
    configCid : ContractId CredentialRegistryConfig
    config : CredentialRegistryConfig

-- | Helper: the holder sees these fields, and the issuer sees the same record.
assertCredential
  : CredentialEnv
  -> ContractId CredentialRecord
  -> [RecordV1.Claim]
  -> Optional Time
  -> Optional Time
  -> Time
  -> Time
  -> Script ()
assertCredential env cid claims validFrom validUntil createdAt expiresAt = do
  Some record <- queryContractId env.holder cid
  assert $ record.dso == env.dso
  assert $ record.issuer == env.issuer
  assert $ record.holder == env.holder
  assert $ record.claims == claims
  assert $ record.validFrom == validFrom
  assert $ record.validUntil == validUntil
  assert $ record.createdAt == createdAt
  assert $ record.expiresAt == expiresAt
  Some issuerRecord <- queryContractId env.issuer cid
  assert $ issuerRecord == record

-- | Helper: parties, factory, and registry config.
setupCredentialEnv : Script CredentialEnv
setupCredentialEnv = do
  DefaultAppWithUsers {app, alice, bob} <- setupDefaultAppWithUsers
  let dso = app.dso
      issuer = alice.primaryParty
      holder = bob.primaryParty
  registryCid <- submit dso $ createCmd CredentialRegistry with dso
  configCid <- submit dso $ createCmd CredentialRegistryConfig with
    dso
    freePeriod = days 90
    extensionUsdPerYear = 1.0
  Some config <- queryContractId dso configCid
  pure CredentialEnv with ..

-- | Context entry the factory and the expiry transfer read.
registryConfigContext : ContractId CredentialRegistryConfig -> ChoiceContext
registryConfigContext configCid = ChoiceContext with
  values = TextMap.fromList
    [(credentialRegistryConfigContextKey, toAnyValue configCid)]

-- | One claim used by the happy-path scripts.
exampleClaim : RecordV1.Claim
exampleClaim = RecordV1.Claim with
  subject = None
  property = "example.com/name"
  value = "alice"

-- | A credential with no validity window.
simpleCredentialParams : [RecordV1.Claim] -> PublicationV1.CredentialParams
simpleCredentialParams claims = PublicationV1.CredentialParams with
  claims
  validFrom = None
  validUntil = None

-- | Helper: the factory rejects this new record.
createCredentialMustFail
  : CredentialEnv
  -> Time
  -> [RecordV1.Claim]
  -> Optional Time
  -> Optional Time
  -> Script ()
createCredentialMustFail env requestedAt claims validFrom validUntil =
  submitMustFail (actAs env.holder <> actAs env.issuer <> readAs env.dso) $
    exerciseCmd
      (toInterfaceContractId @PublicationV1.CredentialFactory env.registryCid)
      PublicationV1.CredentialFactory_UpdateCredentials with
        admin = env.dso
        holder = env.holder
        issuer = env.issuer
        oldCredentials = []
        newCredentials = [PublicationV1.CredentialParams with claims; validFrom; validUntil]
        requestedAt
        extraArgs = ExtraArgs with
          context = registryConfigContext env.configCid
          meta = emptyMetadata

-- | A timestamp already behind ledger time. The factory rejects requestedAt that is not in the past.
pastRequestedAt : Script Time
pastRequestedAt = do
  requestedAt <- getTime
  passTime (seconds 1)
  pure requestedAt

-- | Helper: issuer and holder create one record.
createCredential
  : CredentialEnv
  -> Party
  -> Party
  -> [RecordV1.Claim]
  -> Script (ContractId CredentialRecord, Time)
createCredential env issuer holder claims = do
  requestedAt <- pastRequestedAt
  result <- submit (actAs holder <> actAs issuer <> readAs env.dso) $
    exerciseCmd
      (toInterfaceContractId @PublicationV1.CredentialFactory env.registryCid)
      PublicationV1.CredentialFactory_UpdateCredentials with
        admin = env.dso
        holder
        issuer
        oldCredentials = []
        newCredentials = [simpleCredentialParams claims]
        requestedAt
        extraArgs = ExtraArgs with
          context = registryConfigContext env.configCid
          meta = emptyMetadata
  let [cid] = map (fromInterfaceContractId @CredentialRecord) result.newCredentials
  pure (cid, requestedAt)

-- | Helper: the factory rejects this update of an old record.
updateCredentialMustFail
  : CredentialEnv
  -> Time
  -> [RecordV1.Claim]
  -> [ContractId CredentialRecord]
  -> Script ()
updateCredentialMustFail env requestedAt claims oldCredentials =
  submitMustFail (actAs env.holder <> actAs env.issuer <> readAs env.dso) $
    exerciseCmd
      (toInterfaceContractId @PublicationV1.CredentialFactory env.registryCid)
      PublicationV1.CredentialFactory_UpdateCredentials with
        admin = env.dso
        holder = env.holder
        issuer = env.issuer
        oldCredentials = map (toInterfaceContractId @RecordV1.Credential) oldCredentials
        newCredentials = [simpleCredentialParams claims]
        requestedAt
        extraArgs = ExtraArgs with
          context = registryConfigContext env.configCid
          meta = emptyMetadata

-- | Helper: this actor cannot revoke the record.
revokeMustFail : CredentialEnv -> Party -> ContractId CredentialRecord -> Script ()
revokeMustFail env actor cid =
  submitMustFail (actAs actor <> readAs env.dso) $
    exerciseCmd (toInterfaceContractId @RecordV1.Credential cid) RecordV1.Credential_Revoke with
      actors = [actor]

-- | Helper: context entries the expiry transfer reads.
expiryChoiceContext
  : ContractId CredentialRegistryConfig
  -> ContractId CredentialRecord
  -> ChoiceContext
expiryChoiceContext configCid credentialCid = ChoiceContext with
  values = TextMap.fromList
    [ (credentialRegistryConfigContextKey, toAnyValue configCid)
    , (credentialCidContextKey, toAnyValue credentialCid)
    ]

-- | Helper: wallet reason that selects a credential expiry extension.
expiryMemo : Metadata
expiryMemo = Metadata with
  values = TextMap.fromList [(reasonMetaKey, credentialExpiryMemo)]

-- | Helper: account with an owner and no provider or id.
basicAccount : Party -> HoldingV2.Account
basicAccount owner = HoldingV2.Account with
  owner = Some owner
  provider = None
  id = ""

-- | Helper: zero-amount v1 transfer. It adds only the free period.
expiryTransfer : CredentialEnv -> Party -> Time -> Time -> TransferV1.Transfer
expiryTransfer env sender requestedAt executeBefore = TransferV1.Transfer with
  sender
  receiver = credentialExpiryReceiver
  amount = 0.0
  instrumentId = amuletInstrumentId env.dso
  requestedAt
  executeBefore
  inputHoldingCids = []
  meta = expiryMemo

-- | Helper: zero-amount v2 transfer. The sender account stays basic.
expiryTransferV2 : CredentialEnv -> Party -> Time -> Time -> TransferV2.Transfer
expiryTransferV2 env sender requestedAt executeBefore = TransferV2.Transfer with
  sender = basicAccount sender
  receiver = credentialExpiryAccount
  amount = 0.0
  instrumentId = amuletInstrumentIdV2 env.dso
  requestedAt
  executeBefore
  inputHoldingCids = []
  meta = expiryMemo

-- | Helper: this v1 expiry transfer is rejected.
extendCredentialMustFail
  : CredentialEnv
  -> Party
  -> Party
  -> TransferV1.Transfer
  -> ChoiceContext
  -> Script ()
extendCredentialMustFail env expectedAdmin sender transfer context =
  submitMustFail (actAs sender <> readAs env.dso) $
    exerciseCmd
      (toInterfaceContractId @TransferV1.TransferFactory env.registryCid)
      TransferV1.TransferFactory_Transfer with
        expectedAdmin
        transfer
        extraArgs = ExtraArgs with
          context
          meta = emptyMetadata

-- | Helper: this v2 expiry transfer is rejected.
extendCredentialV2MustFail
  : CredentialEnv
  -> Party
  -> TransferV2.Transfer
  -> ChoiceContext
  -> Script ()
extendCredentialV2MustFail env actor transfer context =
  submitMustFail (actAs actor <> readAs env.dso) $
    exerciseCmd
      (toInterfaceContractId @TransferV2.TransferFactory env.registryCid)
      TransferV2.TransferFactory_Transfer with
        transfer
        actors = [actor]
        extraArgs = ExtraArgs with
          context
          meta = emptyMetadata
