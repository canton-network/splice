test_create_credential : Script ()
test_create_credential = do
  env <- setupCredentialEnv
  (credentialCid, requestedAt) <- createCredential env env.issuer env.holder [exampleClaim]
  assertCredential env credentialCid [exampleClaim] None None requestedAt
    (requestedAt `addRelTime` env.config.freePeriod)

-- | A URI or a plain word is accepted as a subject.
test_create_credential_uri_subjects : Script ()
test_create_credential_uri_subjects = do
  env <- setupCredentialEnv
  let subjects =
        [ "https://example.com/alice"
        , "alice"
        , "carol"
        ]
      claims = map (\subject -> exampleClaim with subject = Some subject) subjects
  (credentialCid, requestedAt) <- createCredential env env.issuer env.holder claims
  assertCredential env credentialCid claims None None requestedAt
    (requestedAt `addRelTime` env.config.freePeriod)

test_create_credential_rejected : Script ()
test_create_credential_rejected = do
  env <- setupCredentialEnv
  start <- getTime
  passTime (days 1)
  let requestedAt = start `addRelTime` hours 1
      before = Some start
      atCreated = Some requestedAt
      after = Some (requestedAt `addRelTime` hours 1)
      long256 = T.implode (replicate 256 "a")
      long2048 = T.implode (replicate 2048 "a")
      named = exampleClaim with subject = Some "bob"
      tooMany = map (\n -> exampleClaim with property = "example.com/c" <> show n) [1 .. 33]
  -- property character and length
  createCredentialMustFail env requestedAt [exampleClaim with property = "example.com/bad name"] None None
  createCredentialMustFail env requestedAt [exampleClaim with property = long256] None None
  -- subject empty, equal to the holder, too long, or an illegal character
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some ""] None None
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some (partyToText env.holder)] None None
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some long256] None None
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some "bob<example>"] None None
  createCredentialMustFail env requestedAt [exampleClaim with subject = Some "b\246b"] None None
  -- value length and claim count
  createCredentialMustFail env requestedAt [exampleClaim with value = long2048] None None
  createCredentialMustFail env requestedAt tooMany None None
  -- duplicate (subject, property), including two unset subjects
  createCredentialMustFail env requestedAt [exampleClaim, exampleClaim] None None
  createCredentialMustFail env requestedAt [named, named] None None
  -- validFrom is not before validUntil, or validUntil is not after createdAt
  createCredentialMustFail env requestedAt [exampleClaim] after after
  createCredentialMustFail env requestedAt [exampleClaim] before atCreated
  createCredentialMustFail env requestedAt [exampleClaim] None atCreated
  -- requestedAt older than 24 hours
  createCredentialMustFail env (requestedAt `addRelTime` days (-1)) [exampleClaim] None None
  [] <- query @CredentialRecord env.holder
  pure ()

-- | Without a registry config on the snapshot, issuance fails.
test_create_credential_registry_not_configured : Script ()
test_create_credential_registry_not_configured = do
  env <- setupCredentialEnvWith None
  requestedAt <- pastRequestedAt
  createCredentialMustFail env requestedAt [exampleClaim] None None

-- | After a vote removes the registry config, issuance and extension fail,
-- but holders and issuers can still revoke and expire their records.
test_registry_disabled_by_vote : Script ()
test_registry_disabled_by_vote = do
  env <- setupCredentialEnv
  (toExtendCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (toRevokeCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (toExpireCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  updateAmuletConfig env.app (\c -> c with credentialRegistryConfig = None)
  passTime (days 2)
  updateExternalPartyConfigState env.app
  (_, disabledStateCid) <- getExternalPartyConfigStates env.app
  let disabled = env with configStateCid = disabledStateCid
  tryExtendBy disabled env.holder toExtendCid 0.0 []
    >>= mustFailWith "credential registry is not configured"
  requestedAt <- pastRequestedAt
  createCredentialMustFail disabled requestedAt [exampleClaim] None None
  submit env.holder $
    exerciseCmd (toInterfaceContractId @RecordV1.Credential toRevokeCid) RecordV1.Credential_Revoke with
      actors = [env.holder]
  None <- queryContractId env.holder toRevokeCid
  passTime env.config.freePeriod
  submit env.holder $ exerciseCmd toExpireCid Credential_Expire with actor = env.holder
  None <- queryContractId env.holder toExpireCid
  pure ()

test_update_credential : Script ()
test_update_credential = do
  env <- setupCredentialEnv
  (oldCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  requestedAt <- pastRequestedAt
  let updatedClaim = exampleClaim with property = "example.com/email"; value = "alice@example.com"
  result <- submit (issuerAndHolder env) $
    updateCredentialsCmd env [oldCid] [simpleCredentialParams [updatedClaim]] requestedAt
      (registryConfigContext env.configStateCid)
  None <- queryContractId env.holder oldCid
  let [newCid] = map (fromInterfaceContractId @CredentialRecord) result.newCredentials
  assertCredential env newCid [updatedClaim] None None requestedAt
    (requestedAt `addRelTime` env.config.freePeriod)
  -- Archiving without new records needs no snapshot in the context.
  archived <- submit (issuerAndHolder env) $
    updateCredentialsCmd env [newCid] [] requestedAt (ChoiceContext with values = TextMap.empty)
  assert $ null archived.newCredentials
  None <- queryContractId env.holder newCid
  -- Held by the issuer, so it is not this holder's record.
  (otherCid, _) <- createCredential env env.issuer env.issuer [exampleClaim]
  updateCredentialMustFail env requestedAt [updatedClaim] [otherCid]
  -- Self-published by the holder, so another issuer cannot replace it.
  (selfPublishedCid, _) <- createCredential env env.holder env.holder [exampleClaim]
  updateCredentialMustFail env requestedAt [updatedClaim] [selfPublishedCid]
  Some _ <- queryContractId env.issuer otherCid
  Some _ <- queryContractId env.holder selfPublishedCid
  pure ()

test_revoke_credential : Script ()
test_revoke_credential = do
  env <- setupCredentialEnv
  outsider <- allocateParty "outsider"
  (holderCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (issuerCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (keptCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  submit env.holder $
    exerciseCmd (toInterfaceContractId @RecordV1.Credential holderCid) RecordV1.Credential_Revoke with
      actors = [env.holder]
  submit env.issuer $
    exerciseCmd (toInterfaceContractId @RecordV1.Credential issuerCid) RecordV1.Credential_Revoke with
      actors = [env.issuer]
  None <- queryContractId env.holder holderCid
  None <- queryContractId env.issuer issuerCid
  revokeMustFail env outsider keptCid
  revokeMustFail env env.dso keptCid
  Some _ <- queryContractId env.holder keptCid
  pure ()

test_expire_credential : Script ()
test_expire_credential = do
  env <- setupCredentialEnv
  outsider <- allocateParty "outsider"
  (holderCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (issuerCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  (dsoCid, _) <- createCredential env
    env.issuer env.holder [exampleClaim]
  (toExtendCid, toExtendCreatedAt) <- createCredential env env.issuer env.holder [exampleClaim]
  Right _ <- tryExtendBy env env.holder toExtendCid 0.0 []
  (extendedCid, _) <- recordCreatedAt env toExtendCreatedAt
  submitMustFail env.holder $ exerciseCmd holderCid Credential_Expire with actor = env.holder
  passTime (env.config.freePeriod + days 1)
  trySubmit (actAs outsider <> readAs env.holder) (exerciseCmd holderCid Credential_Expire with actor = outsider)
    >>= mustFailWith "actor is stakeholder"
  -- The extended record runs until its new expiresAt.
  submitMustFail env.holder $ exerciseCmd extendedCid Credential_Expire with actor = env.holder
  submit env.holder $ exerciseCmd holderCid Credential_Expire with actor = env.holder
  submit env.issuer $ exerciseCmd issuerCid Credential_Expire with actor = env.issuer
  submit env.dso $ exerciseCmd dsoCid Credential_Expire with actor = env.dso
  None <- queryContractId env.holder holderCid
  None <- queryContractId env.issuer issuerCid
  None <- queryContractId env.dso dsoCid
  pure ()

test_extend_credential : Script ()
test_extend_credential = do
  env <- setupCredentialEnv
  let twoFreePeriods createdAt = createdAt `addRelTime` (env.config.freePeriod + env.config.freePeriod)
  -- the holder through the v1 factory
  (holderCid, holderCreatedAt) <- createCredential env env.issuer env.holder [exampleClaim]
  Right _ <- tryExtendBy env env.holder holderCid 0.0 []
  None <- queryContractId env.holder holderCid
  (extendedHolderCid, _) <- recordCreatedAt env holderCreatedAt
  assertCredential env extendedHolderCid [exampleClaim] None None holderCreatedAt (twoFreePeriods holderCreatedAt)
  -- the issuer through the v2 factory
  (issuerCid, issuerCreatedAt) <- createCredential env env.issuer env.holder [exampleClaim]
  requestedAt <- pastRequestedAt
  now <- getTime
  submit (actAs env.issuer <>
    readAs env.dso) $
    exerciseCmd
      (toInterfaceContractId @TransferV2.TransferFactory env.rulesCid)
      TransferV2.TransferFactory_Transfer with
        transfer = expiryTransferV2 env env.issuer requestedAt (now `addRelTime` days 1)
        actors = [env.issuer]
        extraArgs = ExtraArgs with
          context = expiryChoiceContext env.configStateCid issuerCid
          meta = emptyMetadata
  (extendedIssuerCid, _) <- recordCreatedAt env issuerCreatedAt
  assertCredential env extendedIssuerCid [exampleClaim] None None issuerCreatedAt (twoFreePeriods issuerCreatedAt)
  -- an expired record extends from requestedAt, not from its old expiresAt
  passTime (env.config.freePeriod + env.config.freePeriod + days 1)
  Right expiredRequestedAt <- tryExtendBy env env.holder extendedHolderCid 0.0 []
  (renewedCid, _) <- recordCreatedAt env holderCreatedAt
  assertCredential env renewedCid [exampleClaim] None None holderCreatedAt
    (expiredRequestedAt `addRelTime` env.config.freePeriod)

-- | A positive amount burns Amulet and buys whole days on top of the free period.
-- Less than a day buys no day. validUntil caps the lease, and an extension that
-- would not move it is rejected without burning anything.
test_extend_credential_paid : Script ()
test_extend_credential_paid = do
  env <- setupCredentialEnv
  assertMsg "test assumes 1 USD per Amulet and 1 USD per year" $
    env.amuletPrice == 1.0 && env.config.extensionUsdPerYear == 1.0
  let twoFreePeriods createdAt = createdAt `addRelTime` (env.config.freePeriod + env.config.freePeriod)
  -- 2 Amulet buy two years
  (paidCid, paidCreatedAt) <- createCredential env env.issuer env.holder [exampleClaim]
  holding <- tap env.app env.holderUser 10.0
  balanceBefore <- amuletBalance env.holder
  Right _ <- tryExtendBy env env.holder paidCid 2.0 [holding]
  balanceAfter <- amuletBalance env.holder
  assert $ balanceBefore - balanceAfter == 2.0
  (extendedCid, _) <- recordCreatedAt env paidCreatedAt
  assertCredential env extendedCid [exampleClaim] None None paidCreatedAt
    (twoFreePeriods paidCreatedAt `addRelTime` days 730)
  -- 0.001 Amulet is less than a day (about 0.00274), so only the free period is added
  (smallCid, smallCreatedAt) <- createCredential env env.issuer env.holder [exampleClaim]
  smallHolding <- tap env.app env.holderUser 1.0
  Right _ <- tryExtendBy env env.holder smallCid 0.001 [smallHolding]
  (extendedSmallCid, _) <- recordCreatedAt env smallCreatedAt
  assertCredential env extendedSmallCid [exampleClaim] None None smallCreatedAt (twoFreePeriods smallCreatedAt)
  -- validUntil caps the lease; once it is reached, a further extension fails and burns nothing
  (cappedCid, cappedCreatedAt) <- createCredentialUntil env (env.config.freePeriod + days 10)
  cappedHolding <- tap env.app env.holderUser 10.0
  Right _ <- tryExtendBy env env.holder cappedCid 2.0 [cappedHolding]
  (atCapCid, atCap) <- recordCreatedAt env cappedCreatedAt
  assert $ Some atCap.expiresAt == atCap.validUntil
  nextHolding <- tap env.app env.holderUser 5.0
  balanceBefore <- amuletBalance env.holder
  tryExtendBy env env.holder atCapCid 2.0 [nextHolding]
    >>= mustFailWith "new expiry is later than the current one"
  balanceAfter <- amuletBalance env.holder
  assert $ balanceAfter == balanceBefore

test_extend_credential_rejected : Script ()
test_extend_credential_rejected = do
  env <- setupCredentialEnv
  outsider <- allocateParty "outsider"
  (credentialCid, _) <- createCredential env env.issuer env.holder [exampleClaim]
  holding <- tap env.app env.holderUser 1.0
  requestedAt <- pastRequestedAt
  now <- getTime
  let executeBefore = now `addRelTime` days 1
      context = expiryChoiceContext env.configStateCid credentialCid
      valid = expiryTransfer env env.holder requestedAt executeBefore
      notAmulet = (amuletInstrumentId env.dso) with id = "NotAmulet"
      hostedSender = (basicAccount env.holder) with provider = Some env.issuer
  -- receiver, memo, and instrument
  extendCredentialMustFail env env.dso env.holder (valid with receiver = env.holder) context
  extendCredentialMustFail env env.dso env.holder (valid with meta = emptyMetadata) context
  extendCredentialMustFail env env.dso env.holder (valid with instrumentId = notAmulet) context
  -- admin, sender, amount, and holdings
  extendCredentialMustFail env outsider env.holder valid context
  extendCredentialMustFail env env.dso outsider (valid with sender = outsider) context
  extendCredentialMustFail env env.dso env.holder (valid with amount = 1.0) context
  extendCredentialMustFail env env.dso env.holder (valid with amount = -1.0) context
  extendCredentialMustFail env env.dso env.holder (valid with inputHoldingCids = [toInterfaceContractId holding]) context
  -- deadlines: executeBefore passed, requestedAt in the future or older than 24 hours
  extendCredentialMustFail env env.dso env.holder (valid with executeBefore = requestedAt) context
  extendCredentialMustFail env env.dso env.holder
    (valid with requestedAt = now `addRelTime` hours 1; executeBefore = now `addRelTime` days 2) context
  extendCredentialMustFail env env.dso env.holder (valid with requestedAt = now `addRelTime` days (-2)) context
  -- credential cid missing from the context
  extendCredentialMustFail env env.dso env.holder valid (registryConfigContext env.configStateCid)
  -- v2 account is not basic, or the actor is not the sender
  extendCredentialV2MustFail env env.holder
    ((expiryTransferV2 env env.holder requestedAt executeBefore) with sender = hostedSender)
    context
  extendCredentialV2MustFail env env.issuer (expiryTransferV2 env env.holder requestedAt executeBefore) context
  Some _ <- queryContractId env.holder credentialCid
  -- validUntil has passed, so the capped expiry would lie in the past
  (cappedCid, _) <- createCredentialUntil env (env.config.freePeriod + days 10)
  passTime (env.config.freePeriod + days 11)
  tryExtendBy env env.holder cappedCid 0.0 [] >>= mustFailWith "new expiresAt"

-- | Credential_ExtendExpiry accepts a later lease, and rejects a shorter one,
-- an actor that is neither issuer nor holder, and a lease past validUntil.
test_extend_expiry_choice_invariants : Script ()
test_extend_expiry_choice_invariants = do
  env <- setupCredentialEnv
  outsider <- allocateParty "outsider"
  (credentialCid, createdAt) <- createCredential env env.issuer env.holder [exampleClaim]
  Some record <- queryContractId env.holder credentialCid
  let later = record.expiresAt `addRelTime` days 1
  Right extendedCid <- tryExtendExpiry env env.holder credentialCid later
  assertCredential env extendedCid [exampleClaim] None None createdAt later
  tryExtendExpiry env env.holder extendedCid (createdAt `addRelTime` days 1)
    >>= mustFailWith "new expiry is later than the current one"
  tryExtendExpiry env env.holder extendedCid later
    >>= mustFailWith "new expiry is later than the current one"
  tryExtendExpiry env outsider extendedCid (later `addRelTime` days 1)
    >>= mustFailWith "actor is the issuer or the holder"
  (cappedCid, cappedCreatedAt) <- createCredentialUntil env (days 30)
  tryExtendExpiry env env.holder cappedCid (cappedCreatedAt `addRelTime` days 31)
    >>= mustFailWith "precondition"

-- | A SetConfig vote archives AmuletRules. Issuance and extension against the
-- earlier snapshot still run with its free period, and the next snapshot carries the vote.
test_set_config_keeps_prepared_credential_calls : Script ()
test_set_config_keeps_prepared_credential_calls = do
  env <- setupCredentialEnv
  updateAmuletConfig env.app (\c -> c with
    credentialRegistryConfig = Some (env.config with freePeriod = days 1))
  (credentialCid, createdAt) <- createCredential env env.issuer env.holder [exampleClaim]
  assertCredential env credentialCid [exampleClaim] None None createdAt
    (createdAt `addRelTime` env.config.freePeriod)
  updateAmuletConfig env.app (\c -> c with
    credentialRegistryConfig = Some (env.config with freePeriod = days 2))
  Right _ <- tryExtendBy env env.holder credentialCid 0.0 []
  (extendedCid, _) <- recordCreatedAt env createdAt
  assertCredential env extendedCid [exampleClaim] None None createdAt
    (createdAt `addRelTime` (env.config.freePeriod + env.config.freePeriod))
  passTime (days 2)
  updateExternalPartyConfigState env.app
  (_, newestCid) <- getExternalPartyConfigStates env.app
  Some newest <- queryContractId @ExternalPartyConfigState env.dso newestCid
  assert $ newest.credentialRegistryConfig == Some (env.config with freePeriod = days 2)

-- | Parties, factory, snapshot, and the registry config used by the credential scripts.
data CredentialEnv = CredentialEnv with
    dso : Party
    issuer : Party
    holder : Party
    rulesCid : ContractId ExternalPartyAmuletRules
    holderUser : AmuletUser
    app : AmuletApp
    configStateCid : ContractId ExternalPartyConfigState
    config : CredentialRegistryConfig
    amuletPrice : Decimal

-- | Helper: the holder sees these fields, and the issuer sees the same record.
assertCredential
  : CredentialEnv
  -> ContractId CredentialRecord
  -> [RecordV1.Claim]
  -> Optional Time
  -> Optional Time
  -> Time
  -> Time
  -> Script ()
assertCredential env cid claims validFrom validUntil createdAt expiresAt = do
  Some record <- queryContractId env.holder cid
  assert $ record.dso == env.dso
  assert $ record.issuer == env.issuer
  assert $ record.holder == env.holder
  assert $ record.claims == claims
  assert $ record.validFrom == validFrom
  assert $ record.validUntil == validUntil
  assert $ record.createdAt == createdAt
  assert $ record.expiresAt == expiresAt
  Some issuerRecord <- queryContractId env.issuer cid
  assert $ issuerRecord == record

-- | 90 days of free validity and $1 per extra year.
defaultCredentialRegistryConfig : CredentialRegistryConfig
defaultCredentialRegistryConfig = CredentialRegistryConfig with
  freePeriod = days 90
  extensionUsdPerYear = 1.0

-- | Helper: parties, factory, and registry config copied onto the external-party snapshot.
setupCredentialEnv : Script CredentialEnv
setupCredentialEnv = setupCredentialEnvWith (Some defaultCredentialRegistryConfig)

-- | Helper: as `setupCredentialEnv`, with this registry config in AmuletConfig.
-- With `None` the snapshot carries no registry config, and `config` holds the default.
setupCredentialEnvWith : Optional CredentialRegistryConfig -> Script CredentialEnv
setupCredentialEnvWith registryConfig = do
  app <- setupAppWithConfig $ defaultAmuletConfig with
    credentialRegistryConfig = registryConfig
  (issuerUser, _) <- setupSelfHostedUser app "alice"
  (holderUser, _) <- setupSelfHostedUser app "bob"
  let dso = app.dso
      issuer = issuerUser.primaryParty
      holder = holderUser.primaryParty
  (rulesCid, _) <- getExternalPartyAmuletRules app
  (_, configStateCid) <- getExternalPartyConfigStates app
  Some state <- queryContractId @ExternalPartyConfigState dso configStateCid
  let config = fromOptional defaultCredentialRegistryConfig state.credentialRegistryConfig
      amuletPrice = state.amuletPrice
  pure CredentialEnv with ..

-- | Context entry the factory and the expiry transfer read.
registryConfigContext : ContractId ExternalPartyConfigState -> ChoiceContext
registryConfigContext configStateCid = ChoiceContext with
  values = TextMap.fromList
    [(externalPartyConfigStateContextKey, toAnyValue configStateCid)]

-- | One claim used by the happy-path scripts.
exampleClaim : RecordV1.Claim
exampleClaim = RecordV1.Claim with
  subject = None
  property = "example.com/name"
  value = "alice"

-- | A credential with no validity window.
simpleCredentialParams : [RecordV1.Claim] -> PublicationV1.CredentialParams
simpleCredentialParams claims = PublicationV1.CredentialParams with
  claims
  validFrom = None
  validUntil = None

-- | A timestamp already behind ledger time. The factory rejects requestedAt that is not in the past.
pastRequestedAt : Script Time
pastRequestedAt = do
  requestedAt <- getTime
  passTime (seconds 1)
  pure requestedAt

-- | Helper: the issuer and holder of the env, with read access to the registry.
issuerAndHolder : CredentialEnv -> SubmitOptions
issuerAndHolder env = actAs env.holder <> actAs env.issuer <>
  readAs env.dso

-- | Helper: the env issuer and holder archive `old` and record `new`.
updateCredentialsCmd
  : CredentialEnv
  -> [ContractId CredentialRecord]
  -> [PublicationV1.CredentialParams]
  -> Time
  -> ChoiceContext
  -> Commands PublicationV1.CredentialFactory_UpdateCredentialsResult
updateCredentialsCmd env old new requestedAt context =
  exerciseCmd
    (toInterfaceContractId @PublicationV1.CredentialFactory env.rulesCid)
    PublicationV1.CredentialFactory_UpdateCredentials with
      admin = env.dso
      holder = env.holder
      issuer = env.issuer
      oldCredentials = map (toInterfaceContractId @RecordV1.Credential) old
      newCredentials = new
      requestedAt
      extraArgs = ExtraArgs with
        context
        meta = emptyMetadata

-- | Helper: issuer and holder create one record.
createCredential
  : CredentialEnv
  -> Party
  -> Party
  -> [RecordV1.Claim]
  -> Script (ContractId CredentialRecord, Time)
createCredential env issuer holder claims =
  createCredentialWith (env with issuer; holder) (simpleCredentialParams claims)

-- | Helper: the env issuer and holder create the example claim, valid for `validity` from requestedAt.
createCredentialUntil : CredentialEnv -> RelTime -> Script (ContractId CredentialRecord, Time)
createCredentialUntil env validity = do
  requestedAt <- getTime
  createCredentialWith env (simpleCredentialParams [exampleClaim]) with
    validUntil = Some (requestedAt `addRelTime` validity)

createCredentialWith : CredentialEnv -> PublicationV1.CredentialParams -> Script (ContractId CredentialRecord, Time)
createCredentialWith env params = do
  requestedAt <- pastRequestedAt
  result <- submit (issuerAndHolder env) $
    updateCredentialsCmd env [] [params] requestedAt (registryConfigContext env.configStateCid)
  let [cid] = map (fromInterfaceContractId @CredentialRecord) result.newCredentials
  pure (cid, requestedAt)

-- | Helper: the active record created at this time, e.g. the replacement after an extension.
recordCreatedAt : CredentialEnv -> Time -> Script (ContractId CredentialRecord, CredentialRecord)
recordCreatedAt env createdAt = do
  [record] <- queryFilter @CredentialRecord env.holder (\record -> record.createdAt == createdAt)
  pure record

-- | Helper: the factory rejects this new record.
createCredentialMustFail
  : CredentialEnv
  -> Time
  -> [RecordV1.Claim]
  -> Optional Time
  -> Optional Time
  -> Script ()
createCredentialMustFail env requestedAt claims validFrom validUntil =
  submitMustFail (issuerAndHolder env) $
    updateCredentialsCmd env [] [PublicationV1.CredentialParams with claims; validFrom; validUntil]
      requestedAt (registryConfigContext env.configStateCid)

-- | Helper: the factory rejects this update of an old record.
updateCredentialMustFail
  : CredentialEnv
  -> Time
  -> [RecordV1.Claim]
  -> [ContractId CredentialRecord]
  -> Script ()
updateCredentialMustFail env requestedAt claims oldCredentials =
  submitMustFail (issuerAndHolder env) $
    updateCredentialsCmd env oldCredentials [simpleCredentialParams claims] requestedAt
      (registryConfigContext env.configStateCid)

-- | Helper: this actor cannot revoke the record.
revokeMustFail : CredentialEnv -> Party -> ContractId CredentialRecord -> Script ()
revokeMustFail env actor cid =
  submitMustFail (actAs actor <> readAs env.dso) $
    exerciseCmd (toInterfaceContractId @RecordV1.Credential cid) RecordV1.Credential_Revoke with
      actors = [actor]

-- | Helper: context entries the expiry transfer reads.
expiryChoiceContext : ContractId ExternalPartyConfigState -> ContractId CredentialRecord -> ChoiceContext
expiryChoiceContext configStateCid credentialCid = ChoiceContext with
  values = TextMap.fromList
    [ (externalPartyConfigStateContextKey, toAnyValue configStateCid)
    , (credentialCidContextKey, toAnyValue credentialCid)
    ]

-- | Helper: wallet reason that selects a credential expiry extension.
expiryMemo : Metadata
expiryMemo = Metadata with
  values = TextMap.fromList [(reasonMetaKey, credentialExpiryMemo)]

-- | Helper: account with an owner and no provider or id.
basicAccount : Party -> HoldingV2.Account
basicAccount owner = HoldingV2.Account with
  owner = Some owner
  provider = None
  id = ""

-- | Helper: zero-amount v1 transfer. It adds only the free period.
expiryTransfer : CredentialEnv -> Party -> Time -> Time -> TransferV1.Transfer
expiryTransfer env sender requestedAt executeBefore = TransferV1.Transfer with
  sender
  receiver = credentialExpiryReceiver
  amount = 0.0
  instrumentId = amuletInstrumentId env.dso
  requestedAt
  executeBefore
  inputHoldingCids = []
  meta = expiryMemo

-- | Helper: zero-amount v2 transfer. The sender account stays basic.
expiryTransferV2 : CredentialEnv -> Party -> Time -> Time -> TransferV2.Transfer
expiryTransferV2 env sender requestedAt executeBefore = TransferV2.Transfer with
  sender = basicAccount sender
  receiver = credentialExpiryAccount
  amount = 0.0
  instrumentId = amuletInstrumentIdV2 env.dso
  requestedAt
  executeBefore
  inputHoldingCids = []
  meta = expiryMemo

-- | Helper: the v1 transfer factory command for this expiry transfer.
extendCmd
  : CredentialEnv
  -> Party
  -> TransferV1.Transfer
  -> ChoiceContext
  -> Commands TransferV1.TransferInstructionResult
extendCmd env expectedAdmin transfer context =
  exerciseCmd
    (toInterfaceContractId @TransferV1.TransferFactory env.rulesCid)
    TransferV1.TransferFactory_Transfer with
      expectedAdmin
      transfer
      extraArgs = ExtraArgs with
        context
        meta = emptyMetadata

-- | Helper: the sender extends the record through the v1 factory, burning `amount`
-- from these holdings. Returns the requestedAt it used.
tryExtendBy
  : CredentialEnv
  -> Party
  -> ContractId CredentialRecord
  -> Decimal
  -> [ContractId Amulet]
  -> Script (Either SubmitError Time)
tryExtendBy env sender credentialCid amount holdings = do
  requestedAt <- pastRequestedAt
  now <- getTime
  let transfer = (expiryTransfer env sender requestedAt (now `addRelTime` days 1)) with
        amount
        inputHoldingCids = map toInterfaceContractId holdings
  result <- trySubmit (actAs sender <> readAs env.dso) $
    extendCmd env env.dso transfer (expiryChoiceContext env.configStateCid credentialCid)
  pure (requestedAt <$ result)

-- | Helper: the actor and the DSO party exercise the expiry choice directly.
tryExtendExpiry
  : CredentialEnv
  -> Party
  -> ContractId CredentialRecord
  -> Time
  -> Script (Either SubmitError (ContractId CredentialRecord))
tryExtendExpiry env actor cid newExpiresAt =
  trySubmit (actAs actor <> actAs env.dso) $
    exerciseCmd cid Credential_ExtendExpiry with
      actor
      newExpiresAt

-- | Helper: this v1 expiry transfer is rejected.
extendCredentialMustFail
  : CredentialEnv
  -> Party
  -> Party
  -> TransferV1.Transfer
  -> ChoiceContext
  -> Script ()
extendCredentialMustFail env expectedAdmin sender transfer context =
  submitMustFail (actAs sender <> readAs env.dso) $
    extendCmd env expectedAdmin transfer context

-- | Helper: this v2 expiry transfer is rejected.
extendCredentialV2MustFail : CredentialEnv -> Party -> TransferV2.Transfer -> ChoiceContext -> Script ()
extendCredentialV2MustFail env actor transfer context =
  submitMustFail (actAs actor <> readAs env.dso) $
    exerciseCmd
      (toInterfaceContractId @TransferV2.TransferFactory env.rulesCid)
      TransferV2.TransferFactory_Transfer with
        transfer
        actors = [actor]
        extraArgs = ExtraArgs with
          context
          meta = emptyMetadata

-- | Helper: total initial amount of the Amulet holdings this party owns.
amuletBalance : Party -> Script Decimal
amuletBalance owner = do
  amulets <- query @Amulet owner
  pure $ sum [amulet.amount.initialAmount | (_, amulet) <- amulets, amulet.owner == owner]

-- | Helper: the submission failed, and its error mentions this text.
mustFailWith : Text -> Either SubmitError a -> Script ()
mustFailWith needle (Right _) =
  fail $ "Expected a failure containing '" <> needle <> "', but the submission succeeded"
mustFailWith needle (Left err) =
  unless (needle `T.isInfixOf` show err) $
    fail $ "Expected a failure containing '" <> needle <> "', got: " <> show err
