module Splice.Scripts.UnitTests.Amulet.RewardKind where

import DA.Assert

import Daml.Script

import Splice.AmuletConfig (RewardKind(..))

test_rewardKindEq : Script ()
test_rewardKindEq = do
  App === App
  Validator === Validator
  assertMsg "App /= Validator" (App /= Validator)
  assertMsg "Validator /= App" (Validator /= App)

test_rewardKindShow : Script ()
test_rewardKindShow = do
  show App === "App"
  show Validator === "Validator"
