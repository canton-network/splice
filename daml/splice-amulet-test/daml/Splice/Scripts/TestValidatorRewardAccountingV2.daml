    amount = 100.0
    expiresAt = now `addRelTime` hours 36
    providerIsObserver = True
    beneficiary = None
    kind = Some Validator

  [(amuletRulesCid, _)] <- query @AmuletRules app.dso
  submitMustFail app.dso $ exerciseCmd amuletRulesCid AmuletRules_ClaimExpiredRewardsV2 with
    rewardCouponCids = [couponCid]
    expiryObservers = [node]

-- Claim expired rejects a validator-kind coupon when the supplied
-- expiryObservers don't match the parties that would be observers of the
-- archived coupons.
test_ClaimExpiredRewardsV2_validator_rejects_wrong_observer_set : Script ()
test_ClaimExpiredRewardsV2_validator_rejects_wrong_observer_set = do
  app <- setupApp
  node <- allocateParty "validator-node"
  intruder <- allocateParty "intruder"
  now <- getTime
  let expiresAt = now `addRelTime` hours 1
  couponCid <- submit app.dso $ createCmd RewardCouponV2 with
    dso = app.dso
    provider = node
    round = Round 0
    amount = 100.0
    expiresAt
    providerIsObserver = True
    beneficiary = None
    kind = Some Validator
  setTime $ expiresAt `addRelTime` minutes 1

  [(amuletRulesCid, _)] <- query @AmuletRules app.dso
  submitMustFail app.dso $ exerciseCmd amuletRulesCid AmuletRules_ClaimExpiredRewardsV2 with
    rewardCouponCids = [couponCid]
    expiryObservers = [intruder]


-- End-to-end coverage of the validator-flow round-close: round-close
-- creates CalculateRewardsV2 with kind = Some Validator; the DSO party
-- starts processing with a root batch hash; recursive
-- ProcessRewardsV2_ProcessBatch calls unfold the Merkle tree and create
-- RewardCouponV2 with kind = Some Validator; hidden coupons are unhidden
-- once nodes vet; each coupon mints an amulet.

create_and_process_validator_reward_batches :
  Bool -> Script (Script (), (AmuletApp, Party, Party, Party, Party))
create_and_process_validator_reward_batches dryRun = do
  app <- setupAppWithConfig $ defaultAmuletConfig with
    validatorRewardConfig = Some $ ValidatorRewardConfig with
      mintingVersion = if dryRun then ValidatorRewardVersion_AmuletBurn else ValidatorRewardVersion_TrafficBased
      dryRunVersion = if dryRun then Some ValidatorRewardVersion_TrafficBased else None
      batchSize = 100
      rewardCouponTimeToLive = hours 36
      confirmingValidatorRewardPercentage = 0.3
      maximumDecentralizationValue = 7

  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  charlie <- allocateParty "Charlie"
  dora <- allocateParty "Dora"

  runNextIssuance app  -- triggers CalculateRewardsV2 (kind = Some Validator) creation

  let allowances1 = sortOn (.provider)
        [ MintingAllowance alice 1000.0
        , MintingAllowance bob 2000.0
        ]
  let allowances2 = sortOn (.provider)
        [ MintingAllowance charlie 30.0
        , MintingAllowance dora 5.1
        ]
  let b1 = BatchOfMintingAllowances allowances1
  let b2 = BatchOfMintingAllowances allowances2
  let rootBatch = BatchOfBatches [CryptoHash.hash b1, CryptoHash.hash b2]
  let rootBatchHash = CryptoHash.hash rootBatch
  -- bob and dora are simulated as having wrong vetting state
  let batchesWithHiding = [(b1, [bob]), (b2, [dora]), (rootBatch, [])]

  [(calculateCid, calculate)] <- query @CalculateRewardsV2 app.dso
  calculate.kind === Some Validator
  [(amuletRulesCid, _)] <- query @AmuletRules app.dso

  submit [app.dso] $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingRewardsV2 with
    calculateRewardsCid = calculateCid
    batchHash = rootBatchHash

  let processBatches = do
        states <- query @ProcessRewardsV2 app.dso
        forA_ states $ \(processCid, process) -> do
          let Some (b, badVettingState) =
                find (\(b, _) -> CryptoHash.hash b == process.batchHash) batchesWithHiding
          void $ submit app.dso $ exerciseCmd processCid
            ProcessRewardsV2_ProcessBatch with
              batch = b
              providersWithWrongVettingState = Set.fromList badVettingState

  pure (processBatches, (app, alice, bob, charlie, dora))

-- Four nodes; bob and dora are hidden at creation time. Verify created
-- coupons match expected, unhiding flips their observer field, and each
-- node can mint its coupon into an amulet.
test_validator_reward_accounting_v2 : Script ()
test_validator_reward_accounting_v2 = do
  (processBatches, (app, alice, bob, charlie, dora)) <- create_and_process_validator_reward_batches False

  processBatches  -- root hash → child batch hashes
  processBatches  -- child batch hashes → coupons

  [] <- query @CalculateRewardsV2 app.dso
  [] <- query @ProcessRewardsV2 app.dso

  now <- getTime
  let couponExpiryTime = now `addRelTime` hours 36
  let expectedAmounts = [(alice, 1000.0), (bob, 2000.0), (charlie, 30.0), (dora, 5.1)]
  let expectedCoupons = do
        (node, amount) <- expectedAmounts
        pure RewardCouponV2 with
          dso = app.dso
          provider = node
          amount
          round = Round 0
          expiresAt = couponExpiryTime
          providerIsObserver = node `notElem` [bob, dora]
          beneficiary = None
          kind = Some Validator

  actualCoupons0 <- query @RewardCouponV2 app.dso
  let actualCoupons = sortOn (.provider) $ fmap snd actualCoupons0
  actualCoupons === expectedCoupons

  -- unhide bob's and dora's coupons (simulate them changing their vetting state)
  [(amuletRulesCid, _)] <- query @AmuletRules app.dso
  unobservableCoupons <- queryFilter @RewardCouponV2 app.dso (\c -> not c.providerIsObserver)
  void $ submit app.dso $ exerciseCmd amuletRulesCid AmuletRules_UnhideRewardCouponsV2 with
    rewardCouponCids = map fst unobservableCoupons
    providers = map (._2.provider) unobservableCoupons

  couponsAfterUnhiding <- query @RewardCouponV2 app.dso
  sortOn (.provider) (map snd couponsAfterUnhiding) ===
    map (\c -> c with providerIsObserver = True) expectedCoupons

  -- mint each coupon and verify an amulet was created for the node;
  -- InputRewardCouponV2's summarizeAndConsumeInput routes the amount to
  -- totalValidatorRewardAmount when coupon.kind == Some Validator.
  couponCids <- query @RewardCouponV2 app.dso
  (openMiningRound, _) <- getLatestOpenRound app
  let ctx = TransferContext with
        openMiningRound
        issuingMiningRounds = Map.empty
        validatorRights = Map.empty
        featuredAppRight = None
  forA_ couponCids $ \(couponCid, coupon) -> do
    void $ submitExerciseAmuletRulesByKey app [coupon.provider] [] AmuletRules_Transfer with
      transfer = Transfer with
        sender = coupon.provider
        provider = coupon.provider
        inputs = [InputRewardCouponV2 couponCid]
        outputs = []
        beneficiaries = None
      context = ctx
      expectedDso = Some app.dso
    amulets <- queryFilter @Splice.Amulet.Amulet coupon.provider (\a -> a.owner == coupon.provider)
    assertMsg
      ("expected at least one Amulet for " <> show coupon.provider)
      (not (null amulets))

-- Dry-run: batches are processed but no coupons are created, and the
-- state contracts are archived just as in the happy path.
test_validator_reward_accounting_v2_dry_run : Script ()
test_validator_reward_accounting_v2_dry_run = do
  (processBatches, (app, _, _, _, _)) <- create_and_process_validator_reward_batches True

  processBatches
  processBatches

  [] <- query @CalculateRewardsV2 app.dso
  [] <- query @ProcessRewardsV2 app.dso

  -- no coupons created in dry-run mode
  [] <- query @RewardCouponV2 app.dso
  pure ()
