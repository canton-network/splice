-- TODO(CIP-0120): the scripts below cover the config types in isolation.
-- Remove them once the validator-reward flow has functional tests analogous
-- to those in TestRewardAccountingV2 that exercise the types end-to-end.
-- The CIP-104 app-side does not carry equivalents for RewardVersion /
-- RewardConfig / defaultAmuletConfig.rewardConfig in isolation.
module Splice.Scripts.TestValidatorRewardAccountingV2 where

import DA.Assert
import DA.Time

import Daml.Script

import Splice.AmuletConfig

import Splice.Testing.Registries.AmuletRegistry.Parameters (defaultAmuletConfig)

test_ValidatorRewardVersion_distinct : Script ()
test_ValidatorRewardVersion_distinct = do
  ValidatorRewardVersion_CcBurn === ValidatorRewardVersion_CcBurn
  ValidatorRewardVersion_TrafficBased === ValidatorRewardVersion_TrafficBased
  assertMsg
    "CcBurn and TrafficBased are distinct"
    (ValidatorRewardVersion_CcBurn /= ValidatorRewardVersion_TrafficBased)

sampleValidatorRewardConfig : ValidatorRewardConfig
sampleValidatorRewardConfig = ValidatorRewardConfig with
  mintingVersion = ValidatorRewardVersion_TrafficBased
  dryRunVersion = None
  batchSize = 100
  rewardCouponTimeToLive = hours 36
  confirmingValidatorRewardPercentage = 0.3
  maximumDecentralizationValue = 7

test_ValidatorRewardConfig_equality : Script ()
test_ValidatorRewardConfig_equality = do
  sampleValidatorRewardConfig === sampleValidatorRewardConfig
  assertMsg
    "changing batchSize breaks equality"
    (sampleValidatorRewardConfig /= (sampleValidatorRewardConfig with batchSize = 200))
  assertMsg
    "changing mintingVersion breaks equality"
    (sampleValidatorRewardConfig /=
      (sampleValidatorRewardConfig with mintingVersion = ValidatorRewardVersion_CcBurn))

test_defaultAmuletConfig_no_validator_reward_config : Script ()
test_defaultAmuletConfig_no_validator_reward_config =
  defaultAmuletConfig.validatorRewardConfig === None

test_validAmuletConfig_accepts_some_validator_reward_config : Script ()
test_validAmuletConfig_accepts_some_validator_reward_config = do
  let config = defaultAmuletConfig with validatorRewardConfig = Some sampleValidatorRewardConfig
  assertMsg "validAmuletConfig accepts Some sampleValidatorRewardConfig" (validAmuletConfig config)
