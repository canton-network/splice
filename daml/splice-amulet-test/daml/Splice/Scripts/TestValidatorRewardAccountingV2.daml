-- TODO(CIP-0120): the scripts below each confirm one step of the
-- validator-reward daml build-out. None of them have a counterpart in
-- TestRewardAccountingV2 (the CIP-104 app-side) — the CIP-104 tests
-- exercise the shared types via end-to-end reward flows instead of
-- targeting the types directly. Remove these once the validator-reward
-- flow has analogous end-to-end tests.
module Splice.Scripts.TestValidatorRewardAccountingV2 where

import DA.Assert
import DA.Foldable (forA_)
import DA.Time

import Daml.Script

import Splice.Amulet
import Splice.AmuletConfig
import Splice.AmuletRules
import Splice.Round

import Splice.Scripts.Util
import Splice.Testing.Registries.AmuletRegistry.Parameters (defaultAmuletConfig)
import Splice.Scripts.TestTransferPreapproval (createTransferPreapproval)

test_ValidatorRewardVersion_distinct : Script ()
test_ValidatorRewardVersion_distinct = do
  ValidatorRewardVersion_CcBurn === ValidatorRewardVersion_CcBurn
  ValidatorRewardVersion_TrafficBased === ValidatorRewardVersion_TrafficBased
  assertMsg
    "CcBurn and TrafficBased are distinct"
    (ValidatorRewardVersion_CcBurn /= ValidatorRewardVersion_TrafficBased)

sampleValidatorRewardConfig : ValidatorRewardConfig
sampleValidatorRewardConfig = ValidatorRewardConfig with
  mintingVersion = ValidatorRewardVersion_TrafficBased
  dryRunVersion = None
  batchSize = 100
  rewardCouponTimeToLive = hours 36
  confirmingValidatorRewardPercentage = 0.3
  maximumDecentralizationValue = 7

test_ValidatorRewardConfig_equality : Script ()
test_ValidatorRewardConfig_equality = do
  sampleValidatorRewardConfig === sampleValidatorRewardConfig
  assertMsg
    "changing batchSize breaks equality"
    (sampleValidatorRewardConfig /= (sampleValidatorRewardConfig with batchSize = 200))
  assertMsg
    "changing mintingVersion breaks equality"
    (sampleValidatorRewardConfig /=
      (sampleValidatorRewardConfig with mintingVersion = ValidatorRewardVersion_CcBurn))

test_defaultAmuletConfig_no_validator_reward_config : Script ()
test_defaultAmuletConfig_no_validator_reward_config =
  defaultAmuletConfig.validatorRewardConfig === None

test_validAmuletConfig_accepts_some_validator_reward_config : Script ()
test_validAmuletConfig_accepts_some_validator_reward_config = do
  let config = defaultAmuletConfig with validatorRewardConfig = Some sampleValidatorRewardConfig
  assertMsg "validAmuletConfig accepts Some sampleValidatorRewardConfig" (validAmuletConfig config)

test_openMiningRound_validatorRewardConfig_none : Script ()
test_openMiningRound_validatorRewardConfig_none = do
  app <- setupApp
  rounds <- query @OpenMiningRound app.dso
  forA_ rounds $ \(_, round) ->
    round.validatorRewardConfig === None

test_openMiningRound_validatorRewardConfig_some : Script ()
test_openMiningRound_validatorRewardConfig_some = do
  app <- setupAppWithConfig
    (defaultAmuletConfig with validatorRewardConfig = Some sampleValidatorRewardConfig)
  rounds <- query @OpenMiningRound app.dso
  forA_ rounds $ \(_, round) ->
    round.validatorRewardConfig === Some sampleValidatorRewardConfig

-- Unit test on the gate helper directly.
test_useCcBurnValidatorRewards_cases : Script ()
test_useCcBurnValidatorRewards_cases = do
  useCcBurnValidatorRewards None === True
  useCcBurnValidatorRewards (Some ValidatorRewardVersion_CcBurn) === True
  useCcBurnValidatorRewards (Some ValidatorRewardVersion_TrafficBased) === False

-- Integration test: TrafficBased config in force -> splitAndBurn does NOT
-- create the legacy ValidatorRewardCoupon. Exercised via
-- TransferPreapproval_Send, which routes through splitAndBurn to pay
-- the preapproval fee.
test_splitAndBurn_traffic_based_skips_coupon : Script ()
test_splitAndBurn_traffic_based_skips_coupon = do
  app <- setupAppWithConfig
    (defaultAmuletConfig with validatorRewardConfig = Some sampleValidatorRewardConfig)
  (alice, aliceValidator) <- setupSelfHostedUser app "alice"
  (bob, _bobValidator) <- setupSelfHostedUser app "bob"
  runNextIssuance app
  runAmuletDepositBots app

  now <- getTime
  transferPreapprovalCid <- createTransferPreapproval
    alice.primaryParty aliceValidator.primaryParty app.dso (now `addRelTime` days 1)
  context <- getPaymentTransferContext app bob
  amuletCid <- tap app bob 50.0
  _ <- submit (actAs bob.primaryParty <> readAs app.dso) $
    exerciseCmd transferPreapprovalCid TransferPreapproval_Send with
      sender = bob.primaryParty
      context
      inputs = [InputAmulet amuletCid]
      amount = 10.0
      description = None

  coupons <- query @ValidatorRewardCoupon app.dso
  assertMsg "no ValidatorRewardCoupon should be created under TrafficBased" (null coupons)
