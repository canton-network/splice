-- TODO(CIP-0120): confirm-one-step test (see top-of-file TODO). Remove once
-- an end-to-end test covers the dryRun variant.
test_CalculateValidatorRewardsV2_dry_run_variant : Script ()
test_CalculateValidatorRewardsV2_dry_run_variant = do
  let dryRunConfig = sampleValidatorRewardConfig with
        mintingVersion = ValidatorRewardVersion_CcBurn
        dryRunVersion = Some ValidatorRewardVersion_TrafficBased
  app <- setupAppWithConfig
    (defaultAmuletConfig with validatorRewardConfig = Some dryRunConfig)
  runNextIssuance app
  contracts <- query @CalculateValidatorRewardsV2 app.dso
  length contracts === 1
  case contracts of
    [(_, c)] -> c.dryRun === True
    _ -> fail "expected exactly one dry-run CalculateValidatorRewardsV2"
