sampleValidatorRewardConfig : ValidatorRewardConfig
sampleValidatorRewardConfig = ValidatorRewardConfig with
  mintingVersion = ValidatorRewardVersion_TrafficBased
  dryRunVersion = None
  batchSize = 100
  rewardCouponTimeToLive = hours 36
  confirmingValidatorRewardPercentage = 0.3
  maximumDecentralizationValue = 7

-- TransferPreapproval_Send routes through splitAndBurn to pay the
-- preapproval fee. With TrafficBased in force the legacy
-- ValidatorRewardCoupon creation is gated off.
test_splitAndBurn_traffic_based_skips_coupon : Script ()
test_splitAndBurn_traffic_based_skips_coupon = do
  app <- setupAppWithConfig
    (defaultAmuletConfig with validatorRewardConfig = Some sampleValidatorRewardConfig)
  (alice, aliceValidator) <- setupSelfHostedUser app "alice"
  (bob, _bobValidator) <- setupSelfHostedUser app "bob"
  runNextIssuance app
  runAmuletDepositBots app

  now <- getTime
  transferPreapprovalCid <- createTransferPreapproval
    alice.primaryParty aliceValidator.primaryParty app.dso (now `addRelTime` days 1)
  context <- getPaymentTransferContext app bob
  amuletCid <- tap app bob 50.0
  _ <- submit (actAs bob.primaryParty <> readAs app.dso) $
    exerciseCmd transferPreapprovalCid TransferPreapproval_Send with
      sender = bob.primaryParty
      context
      inputs = [InputAmulet amuletCid]
      amount = 10.0
      description = None

  coupons <- query @ValidatorRewardCoupon app.dso
  assertMsg "no ValidatorRewardCoupon should be created under TrafficBased" (null coupons)

-- Exercise RewardCoupon_AssignBeneficiaries via the interface on a
-- validator-kind coupon. Split the original 60/40 between two new
-- beneficiaries; verify the original is archived, each new coupon carries
-- the correct share of the amount, and 'kind = Some Validator' is
-- preserved on the new coupons.
test_RewardCouponV2_validator_assign_beneficiaries : Script ()
test_RewardCouponV2_validator_assign_beneficiaries = do
  app <- setupApp
  node <- allocateParty "validator-node"
  bob <- allocateParty "bob"
  charlie <- allocateParty "charlie"
  now <- getTime
  let expiresAt = now `addRelTime` hours 36
  couponCid <- submit app.dso $ createCmd RewardCouponV2 with
    dso = app.dso
    provider = node
    round = Round 0
    amount = 100.0
    expiresAt
    providerIsObserver = True
    beneficiary = None
    kind = Some Validator
  let percentages = [(bob, 0.6), (charlie, 0.4)]
  result <- submit (actAs node <> readAs app.dso) $
    exerciseCmd (toInterfaceContractId @Api.RewardAssignmentV1.RewardCoupon couponCid)
      Api.RewardAssignmentV1.RewardCoupon_AssignBeneficiaries with
        additionalCoupons = []
        newBeneficiaries = map (uncurry Api.RewardAssignmentV1.RewardBeneficiary) percentages
        extraArgs = emptyExtraArgs
  None <- queryContractId node couponCid
  forA_ result.newBeneficiariesCouponCids $ \(beneficiary, cids) -> do
    let Some (_, percentage) = find (\(p, _) -> p == beneficiary) percentages
    length cids === 1
    forA_ cids $ \cid -> do
      Some newCoupon <- queryContractId beneficiary (fromInterfaceContractId @RewardCouponV2 cid)
      newCoupon.provider === node
      newCoupon.beneficiary === Some beneficiary
      newCoupon.amount === 100.0 * percentage
      newCoupon.providerIsObserver === True
      newCoupon.round === Round 0
      newCoupon.kind === Some Validator
  pure ()

-- ProcessBatch rejects when the supplied batch's hash does not match the
-- batchHash the ProcessRewardsV2 contract was created with.
test_ProcessRewardsV2_rejects_hash_mismatch_validator_kind : Script ()
test_ProcessRewardsV2_rejects_hash_mismatch_validator_kind = do
  app <- setupApp
  alice <- allocateParty "validator-alice"
  now <- getTime
  let originalBatch = BatchOfMintingAllowances [MintingAllowance alice 100.0]
  let tamperedBatch = BatchOfMintingAllowances [MintingAllowance alice 999.0]

  processCid <- submit app.dso $ createCmd ProcessRewardsV2 with
    dso = app.dso
    round = Round 0
    roundClosedAt = now
    dryRun = False
    rewardCouponTimeToLive = hours 36
    batchHash = CryptoHash.hash originalBatch
    kind = Some Validator

  submitMustFail app.dso $ exerciseCmd processCid ProcessRewardsV2_ProcessBatch with
    batch = tamperedBatch
    providersWithWrongVettingState = Set.empty

-- Unhide rejects a validator-kind coupon whose provider is already an observer.
test_UnhideRewardCouponsV2_validator_rejects_already_observable : Script ()
test_UnhideRewardCouponsV2_validator_rejects_already_observable = do
  app <- setupApp
  node <- allocateParty "validator-node"
  now <- getTime
  observableCid <- submit app.dso $ createCmd RewardCouponV2 with
    dso = app.dso
    provider = node
    round = Round 0
    amount = 100.0
    expiresAt = now `addRelTime` hours 36
    providerIsObserver = True
    beneficiary = None
    kind = Some Validator

  [(amuletRulesCid, _)] <- query @AmuletRules app.dso
  submitMustFail app.dso $ exerciseCmd amuletRulesCid AmuletRules_UnhideRewardCouponsV2 with
    rewardCouponCids = [observableCid]
    providers = [node]

-- Claim expired archives a validator-kind coupon and produces an
-- UnclaimedReward for its amount once the coupon's expiresAt has passed.
test_ClaimExpiredRewardsV2_validator_happy_path : Script ()
test_ClaimExpiredRewardsV2_validator_happy_path = do
  app <- setupApp
  node <- allocateParty "validator-node"
  now <- getTime
  let expiresAt = now `addRelTime` hours 1
  couponCid <- submit app.dso $ createCmd RewardCouponV2 with
    dso = app.dso
    provider = node
    round = Round 0
    amount = 100.0
    expiresAt
    providerIsObserver = True
    beneficiary = None
    kind = Some Validator
  setTime $ expiresAt `addRelTime` minutes 1

  [(amuletRulesCid, _)] <- query @AmuletRules app.dso
  _ <- submit app.dso $ exerciseCmd amuletRulesCid AmuletRules_ClaimExpiredRewardsV2 with
    rewardCouponCids = [couponCid]
    expiryObservers = [node]

  None <- queryContractId app.dso couponCid
  unclaimed <- query @UnclaimedReward app.dso
  case unclaimed of
    [(_, r)] -> r.amount === 100.0
    _ -> fail "expected exactly one UnclaimedReward after expiry"

