    nodeIsObserver = True
    beneficiary = None
  setTime $ expiresAt `addRelTime` minutes 1

  [(amuletRulesCid, _)] <- query @AmuletRules app.dso
  submitMustFail app.dso $ exerciseCmd amuletRulesCid AmuletRules_ClaimExpiredValidatorRewardsV2 with
    rewardCouponCids = [couponCid]
    expiryObservers = [intruder]  -- wrong: node should be there

-- TODO(CIP-0120): confirm-one-step test (see top-of-file TODO). Remove once
-- an end-to-end test walks a round through TrafficBased.
test_CalculateValidatorRewardsV2_created_on_traffic_based : Script ()
test_CalculateValidatorRewardsV2_created_on_traffic_based = do
  app <- setupAppWithConfig
    (defaultAmuletConfig with validatorRewardConfig = Some sampleValidatorRewardConfig)
  runNextIssuance app
  contracts <- query @CalculateValidatorRewardsV2 app.dso
  length contracts === 1
  case contracts of
    [(_, c)] -> do
      c.dryRun === False
      c.rewardCouponTimeToLive === sampleValidatorRewardConfig.rewardCouponTimeToLive
    _ -> fail "expected exactly one CalculateValidatorRewardsV2"

