import Splice.Testing.Utils
import Splice.TokenStandard.Utils
import Splice.TokenStandard.Utils.Internal.Conversions (encodeRelTime, encodeTime)

expectParsed : Show a => Validation Text a -> Script a
expectParsed (Success a) = pure a
expectParsed (Errors es) = fail $ "Expected a successful parse, got errors: " <> show es

expectParseError : Show a => Text -> Validation Text a -> Script ()
expectParseError needle (Success a) =
  fail $ "Expected a parse error containing '" <> needle <> "', got " <> show a
expectParseError needle (Errors es) =
  unless (any (needle `Text.isInfixOf`) (NonEmpty.toList es)) $
    fail $ "Expected a parse error containing '" <> needle <> "', got " <> show es

-- | Proposes a substitution through `ExternalPartyAmuletRules_GovernanceLocks_ProposeSubstitution`,
-- funded with all unlocked holdings of the proposer.
createSubstitutionRaw
  :  TestEnv -> Party -> AnySubstitution -> Decimal
  -> Script (Either SubmitError ExternalPartyAmuletRules_GovernanceLocks_ProposeSubstitutionResult)
createSubstitutionRaw env proposer substitution amount = do
  now <- getTime
  proposeSubstitutionRawChoice' env.registriesEnv.amuletV2 proposer substitution amount now

-- | Discloses a target lock and its locked amulet.
targetDisclosures
  :  (Template t, HasEnsure t, HasField "lockedAmulet" t (ContractId LockedAmulet))
  => Party -> ContractId t -> Script Disclosures'
targetDisclosures owner cid = do
  Some lock <- queryContractId owner cid
  amuletDisclosure <- queryDisclosure' owner lock.lockedAmulet
  pure amuletDisclosure

acceptGovernanceSubstitutionRaw
  :  TestEnv -> Disclosures' -> ContractId GovernanceLockSubstitution -> [Party]
  -> Script (Either SubmitError GovernanceLockSubstitution_AcceptResult)
acceptGovernanceSubstitutionRaw env disclosures cid actors =
  submitWithTransferContext env.registriesEnv.amuletV2 (actAs actors <> discloseMany' disclosures) \context ->
    exerciseCmd cid GovernanceLockSubstitution_Accept with
      actors
      extraArgs = emptyExtraArgs with context

acceptVestingSubstitutionRaw
  :  TestEnv -> Disclosures' -> ContractId VestingLockSubstitution -> [Party]
  -> Script (Either SubmitError VestingLockSubstitution_AcceptResult)
acceptVestingSubstitutionRaw env disclosures cid actors =
  submitWithTransferContext env.registriesEnv.amuletV2 (actAs actors <> discloseMany' disclosures) \context ->
    exerciseCmd cid VestingLockSubstitution_Accept with
      actors
      extraArgs = emptyExtraArgs with context

expectFailureContaining : Text -> Either SubmitError a -> Script ()
expectFailureContaining needle (Right _) =
  fail $ "Expected a failure containing '" <> needle <> "', but the submission succeeded"
expectFailureContaining needle (Left err) =
  unless (needle `Text.isInfixOf` show err) $
    fail $ "Expected a failure containing '" <> needle <> "', got: " <> show err

lockKindMetadata : GovernanceLockTag -> Metadata
lockKindMetadata tag = Metadata $ TextMap.singleton lockKindMetaKey (governanceLockTagToText tag)

substitutionRequestMetadata : Metadata
substitutionRequestMetadata = Metadata $ TextMap.singleton requestMetaKey governanceLockRequestSubstituteLock

substitutionAcceptRequestMetadata : Metadata
substitutionAcceptRequestMetadata = Metadata $ TextMap.singleton requestMetaKey governanceLockRequestAcceptToSubstituteLock

parseSubstitutionTSv1 : Party -> GovernanceLockTag -> Metadata -> Validation Text AnySubstitution
parseSubstitutionTSv1 admin tag meta =
  runParser (substitutionTSv1Parser admin) (substitutionRequestMetadata <> lockKindMetadata tag <> meta)

encodeVestingLockSubstitutionTargetMetadata : VestingLockKey -> Metadata
encodeVestingLockSubstitutionTargetMetadata key =
  Metadata $ TextMap.fromList $
    [ (targetLockOwnerMetaKey, partyToText key.owner)
    , (lockStatusMetaKey, lockStateToText LS_Vesting)
    , (lockVestingDurationMetaKey, encodeRelTime key.vestingPeriod)
    , (lockVestingEndTimeMetaKey, encodeTime key.endTime)
    ]

testSubstitutionMeta_lockedTargetDefaults : Script ()
testSubstitutionMeta_lockedTargetDefaults = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  let kind = GLK_SuperValidatorRightsOwner "TestSV"
      meta = Metadata $ TextMap.fromList
        [ (lockSubjectMetaKey, "TestSV")
        , (targetLockOwnerMetaKey, partyToText alice)
        ]
  parsed <- expectParsed $ parseSubstitutionTSv1 admin GLT_SuperValidator meta
  parsed === AS_Governance with
    governanceLockKey = GovernanceLockKey with
      dso = admin
      owner = alice
      specification = GovernanceLockSpecification with kind

testSubstitutionMeta_lockedTargetRoundTrip : Script ()
testSubstitutionMeta_lockedTargetRoundTrip = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  x <- allocateParty "x"
  let kind = GLK_FeaturedApp x
      targetKey = GovernanceLockKey with
        dso = admin
        owner = alice
        specification = GovernanceLockSpecification with kind
      meta = Metadata $ TextMap.fromList
        [ (lockSubjectMetaKey, partyToText x)
        , (targetLockOwnerMetaKey, partyToText targetKey.owner)
        , (lockStatusMetaKey, lockStateToText LS_Locked)
        ]
  parsed <- expectParsed $ parseSubstitutionTSv1 admin GLT_FeaturedApp meta
  parsed === AS_Governance with governanceLockKey = targetKey

testSubstitutionMeta_vestingTargetRoundTrip : Script ()
testSubstitutionMeta_vestingTargetRoundTrip = do
  now <- getTime
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  let kind = GLK_SuperValidatorRightsOwner "TestSV"
      targetKey = VestingLockKey with
        dso = admin
        owner = alice
        specification = VestingLockSpecification with
          kind
        vestingPeriod = days 60
        endTime = now `addRelTime` days 45
      meta = encodeVestingLockSubstitutionTargetMetadata targetKey <>
        (Metadata $ TextMap.fromList [(lockSubjectMetaKey, "TestSV")])
  parsed <- expectParsed $ parseSubstitutionTSv1 admin GLT_SuperValidator meta
  parsed === AS_Vesting with vestingLockKey = targetKey

testSubstitutionMeta_failures : Script ()
testSubstitutionMeta_failures = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  let base = TextMap.fromList
        [ (lockSubjectMetaKey, "TestSV")
        , (targetLockOwnerMetaKey, partyToText alice)
        ]
      parse values = parseSubstitutionTSv1 admin GLT_SuperValidator (Metadata values)

  expectParseError lockStatusMetaKey $
    parse $ TextMap.insert lockStatusMetaKey "unlocking" base
  expectParseError targetLockOwnerMetaKey $
    parse $ TextMap.insert targetLockOwnerMetaKey "bad$party" base
  expectParseError lockSubjectMetaKey $
    parse $ TextMap.delete lockSubjectMetaKey base
  expectParseError lockVestingDurationMetaKey $
    parse $ TextMap.insert lockStatusMetaKey (lockStateToText LS_Vesting) base
  expectParseError lockVestingEndTimeMetaKey $
    parse $ TextMap.insert lockStatusMetaKey (lockStateToText LS_Vesting) base

testSubstitution_governanceLock : Script ()
testSubstitution_governanceLock = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2

  let dso = env.instrId.admin
  let someSvKind = GLK_SuperValidatorRightsOwner "TestSV"


  let testLockAmount = 180000.0
  AmuletRegistryV2.tapFaucet registriesEnv.amuletV2 alice (testLockAmount - 1000.0) -- Env creates 1000.0 for alice, so we top up to 180k
  AmuletRegistryV2.tapFaucet registriesEnv.amuletV2 bob testLockAmount

  governanceLockRawChoice registry alice testLockAmount someSvKind

  -- check balances
  let checkBalances (aliceUnlocked, aliceLocked) (bobUnlocked, bobLocked) = do
        WalletClientV2.checkUnlockedBalance alice env.instrId aliceUnlocked
        WalletClientV2.checkBalance alice env.instrId (aliceUnlocked + aliceLocked)
        WalletClientV2.checkUnlockedBalance bob env.instrId bobUnlocked
        WalletClientV2.checkBalance bob env.instrId (bobUnlocked + bobLocked)

  checkBalances (0.0, testLockAmount) (testLockAmount, 0.0)

  -- propose two partial substs
  let testSubstAmount = 50000.0

  -- TODO(canton-network/splice-sv-fa-locking#118): share that submission code with the other instances
  (rulesCid, disc) <- AmuletRegistryV2.getExtAmuletRulesWithDisclosures registry
  now <- getTime
  let createSubstitution amount = do
        inputHoldingCids <- WalletClientV2.listUnlockedHoldingCidsFor (basicAccount bob) bob env.instrId
        result <- submitWithTransferContext registry (actAs [bob] <> discloseMany' disc) $ \context ->
          exerciseCmd rulesCid ExternalPartyAmuletRules_GovernanceLocks_ProposeSubstitution with
            args = CreateSubstitutionArgs with
              dso
              substitution = AS_Governance with
                governanceLockKey = GovernanceLockKey with
                  dso
                  owner = alice
                  specification = GovernanceLockSpecification with kind = someSvKind
              owner = bob
              amount
              inputHoldingCids = map downcast inputHoldingCids
              extraArgs = emptyExtraArgs with context
              requestedAt = now
        errorIfLeft result
        pure ()

  createSubstitution (testSubstAmount / 2.0)
  createSubstitution (testSubstAmount / 2.0)

  checkBalances (0.0, testLockAmount) (testLockAmount - testSubstAmount, testSubstAmount)

  -- accept substitution
  let acceptOneSubstitution = do
        (substitutionCid, _)::_ <- query @GovernanceLockSubstitution dso
        result <- submitWithTransferContext registry (actAs [alice]) $ \context ->
          exerciseCmd substitutionCid GovernanceLockSubstitution_Accept with
            actors = [ alice ]
            extraArgs = emptyExtraArgs with context
        errorIfLeft result

  acceptOneSubstitution
  query @GovernanceLock alice >>= (debug . show)
  acceptOneSubstitution
  checkBalances (testSubstAmount, testLockAmount - testSubstAmount) (testLockAmount - testSubstAmount, testSubstAmount)

  -- propose full subst
  (rulesCid, disc) <- AmuletRegistryV2.getExtAmuletRulesWithDisclosures registry
  inputHoldingCids <- WalletClientV2.listUnlockedHoldingCidsFor (basicAccount bob) bob env.instrId
  result <- submitWithTransferContext registry (actAs [bob] <> discloseMany' disc) $ \context ->
    exerciseCmd rulesCid ExternalPartyAmuletRules_GovernanceLocks_ProposeSubstitution with
      args = CreateSubstitutionArgs with
        dso
        substitution = AS_Governance with
                governanceLockKey = GovernanceLockKey with
                  dso
                  owner = alice
                  specification = GovernanceLockSpecification with kind = someSvKind
        owner = bob
        amount = testLockAmount - testSubstAmount
        inputHoldingCids = map downcast inputHoldingCids
        extraArgs = emptyExtraArgs with context
        requestedAt = now
  _ <- errorIfLeft result

  checkBalances (testSubstAmount, testLockAmount - testSubstAmount) (0.0, testLockAmount)

  -- accept substitution
  acceptOneSubstitution

  checkBalances (testLockAmount, 0.0) (0.0, testLockAmount)

  pure ()

testSubstitutionRaw_failures : Script ()
testSubstitutionRaw_failures = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0 -- alice starts with 1000.0
  AmuletRegistryV2.tapFaucet registry bob 60000.0

  let targetSpec = GovernanceLockSpecification with kind
  _ <- governanceLockWithSpecRawChoice registry alice 50000.0 targetSpec

  -- Insufficient funds to create the substitution
  expectFailureContaining "Insufficient funds: you are missing" =<< createSubstitutionRaw env charlie
    (AS_Governance with
      governanceLockKey = GovernanceLockKey with dso = instrId.admin; owner = alice; specification = targetSpec)
    60000.0

  -- Insufficient lock size on the accepter side
  expectSuccess $ createSubstitutionRaw env bob
    (AS_Governance with
      governanceLockKey = GovernanceLockKey with dso = instrId.admin; owner = alice; specification = targetSpec)
    60000.0
  [(substitutionCid, _)] <- query @GovernanceLockSubstitution bob

  expectFailureContaining "substituted lock has less funds " =<<
    acceptGovernanceSubstitutionRaw env mempty substitutionCid [alice]

-- | Negative: `expiresAt` is derived from `requestedAt`, so dating a proposal into
-- the future would let the proposer choose how long the registry admin has to wait to withdraw it.
testSubstitutionRaw_futureRequestedAt : Script ()
testSubstitutionRaw_futureRequestedAt = do
  TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0

  let targetSpec = GovernanceLockSpecification with kind
  _ <- governanceLockWithSpecRawChoice registry alice 50000.0 targetSpec

  requestedAt <- (`addRelTime` days 1) <$> getTime
  expectFailureContaining "requestedAt" =<< proposeSubstitutionRawChoice' registry bob
    (AS_Governance with
      governanceLockKey = GovernanceLockKey with dso = instrId.admin; owner = alice; specification = targetSpec)
    20000.0 requestedAt

-- | alice holds a 50000.0 SV lock; bob has 20000.0 liquid and proposes to substitute 20000.0 of it.
setupRawSubstitution : Script (TestEnv, ContractId GovernanceLock, GovernanceLockSpecification, ContractId V1.TransferInstruction)
setupRawSubstitution = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0
  targetCid <- governanceLockRawChoice registry alice 50000.0 kind
  let targetKey = GovernanceLockKey with dso = instrId.admin; owner = alice; specification = GovernanceLockSpecification with kind
      newSpec = GovernanceLockSpecification with kind
  result <- expectSuccess $ createSubstitutionRaw env bob
    (AS_Governance with governanceLockKey = targetKey)
    20000.0
  pure (env, targetCid, newSpec, result.proposal)

-- TSv1 on raw-created substitutions
------------------------------------

acceptSubstitutionV1 : TestEnv -> Disclosures' -> ContractId V1.TransferInstruction -> Party -> Script (Either SubmitError V1.TransferInstructionResult)
acceptSubstitutionV1 env disclosures cid actor =
  submitWithTransferContext env.registriesEnv.amuletV2 (actAs actor <> discloseMany' disclosures) \context ->
    exerciseCmd cid V1.TransferInstruction_Accept with extraArgs = emptyExtraArgs with context

withdrawSubstitutionV1 : TestEnv -> ContractId V1.TransferInstruction -> Party -> Script (Either SubmitError V1.TransferInstructionResult)
withdrawSubstitutionV1 env cid actor =
  submitWithTransferContext env.registriesEnv.amuletV2 (actAs actor) \context ->
    exerciseCmd cid V1.TransferInstruction_Withdraw with extraArgs = emptyExtraArgs with context

rejectSubstitutionV1 : TestEnv -> Disclosures' -> ContractId V1.TransferInstruction -> Party -> Script (Either SubmitError V1.TransferInstructionResult)
rejectSubstitutionV1 env disclosures cid actor =
  submitWithTransferContext env.registriesEnv.amuletV2 (actAs actor <> discloseMany' disclosures) \context ->
    exerciseCmd cid V1.TransferInstruction_Reject with extraArgs = emptyExtraArgs with context

rejectGovernanceSubstitutionRaw
  :  TestEnv -> Disclosures' -> ContractId GovernanceLockSubstitution -> [Party]
  -> Script (Either SubmitError GovernanceLockSubstitution_RejectResult)
rejectGovernanceSubstitutionRaw env disclosures cid actors =
  submitWithTransferContext env.registriesEnv.amuletV2 (actAs actors <> discloseMany' disclosures) \_ ->
    exerciseCmd cid GovernanceLockSubstitution_Reject with actors

-- | Discloses the funds of a substitution proposal, which the owner of the target lock cannot see.
proposalDisclosures : Party -> ContractId GovernanceLockSubstitution -> Script Disclosures'
proposalDisclosures proposer cid = do
  Some proposal <- queryContractId proposer cid
  case proposal.lockedAmulet of
    Some lockedAmulet -> queryDisclosure' proposer lockedAmulet
    None -> pure mempty

-- | Returns the holdings of the receiver of a completed transfer instruction.
expectTransferCompleted : V1.TransferInstructionResult -> Script [ContractId V1.Holding]
expectTransferCompleted result = case result.output of
  V1.TransferInstructionResult_Completed receiverHoldingCids -> pure receiverHoldingCids
  output -> fail $ "Expected TransferInstructionResult_Completed, got " <> show output

-- | Returns the change holdings of a failed transfer instruction.
expectTransferFailed : V1.TransferInstructionResult -> Script [ContractId V1.Holding]
expectTransferFailed result = case result.output of
  V1.TransferInstructionResult_Failed -> pure result.senderChangeCids
  output -> fail $ "Expected TransferInstructionResult_Failed, got " <> show output

testSubstitutionV1_rawSubstitutionView : Script ()
testSubstitutionV1_rawSubstitutionView = do
  (TestEnv{..}, _, _, substitutionCid) <- setupRawSubstitution
  Some transferView <- queryInterfaceContractId bob substitutionCid
  transferView.transfer.amount === 20000.0
  transferView.status === V1.TransferPendingInternalWorkflow with
    pendingActions = Map.fromList [(alice, "accept substitution; reject substitution"), (bob, "withdraw substitution")]

testSubstitutionV1_acceptRawSubstitution : Script ()
testSubstitutionV1_acceptRawSubstitution = do
  (env@TestEnv{..}, targetCid, newSpec, substitutionCid) <- setupRawSubstitution
  options <- targetDisclosures alice targetCid
  result <- expectSuccess (acceptSubstitutionV1 env options substitutionCid alice)
  result.senderChangeCids === []
  [unlockedAmulet] <- expectTransferCompleted result
  WalletClientV2.checkHolding alice (coerceContractId unlockedAmulet) 20000.0

  [(_, newLock)] <- query @GovernanceLock bob
  newLock.owner === bob
  newLock.amount === 20000.0
  newLock.specification === newSpec
  WalletClientV2.checkUnlockedBalance alice instrId 20000.0
  WalletClientV2.checkBalance alice instrId 50000.0

testSubstitutionV1_withdrawRawSubstitution : Script ()
testSubstitutionV1_withdrawRawSubstitution = do
  (env@TestEnv{..}, _, _, substitutionCid) <- setupRawSubstitution
  WalletClientV2.checkUnlockedBalance bob instrId 0.0
  changes <- expectTransferFailed =<< expectSuccess (withdrawSubstitutionV1 env substitutionCid bob)
  length changes === 1
  WalletClientV2.checkUnlockedBalance bob instrId 20000.0
  archived <- queryInterfaceContractId bob substitutionCid
  archived === None

testSubstitutionV1_rejectRawSubstitution : Script ()
testSubstitutionV1_rejectRawSubstitution = do
  (env@TestEnv{..}, targetCid, _, substitutionCid) <- setupRawSubstitution
  WalletClientV2.checkUnlockedBalance bob instrId 0.0
  disclosures <- proposalDisclosures bob (fromInterfaceContractId substitutionCid)
  [change] <- expectTransferFailed =<< expectSuccess (rejectSubstitutionV1 env disclosures substitutionCid alice)
  WalletClientV2.checkHolding bob (coerceContractId change) 20000.0
  WalletClientV2.checkUnlockedBalance bob instrId 20000.0
  archived <- queryInterfaceContractId bob substitutionCid
  archived === None
  Some target <- queryContractId alice targetCid
  target.amount === 50000.0

-- | Only the owner of the target lock can reject a proposal, and the proposer gets their funds back.
testSubstitutionRaw_reject : Script ()
testSubstitutionRaw_reject = do
  (env@TestEnv{..}, targetCid, _, substitutionCid) <- setupRawSubstitution
  let cid = fromInterfaceContractId @GovernanceLockSubstitution substitutionCid
  disclosures <- proposalDisclosures bob cid

  -- the proposer cannot reject
  bobResult <- rejectGovernanceSubstitutionRaw env disclosures cid [bob]
  case bobResult of
    Left _ -> pure ()
    Right r -> fail $ "Expected the reject by the proposer to fail, got " <> show r

  GovernanceLockSubstitution_RejectResult (Some unlockedAmulet) <-
    expectSuccess $ rejectGovernanceSubstitutionRaw env disclosures cid [alice]
  checkHolding' bob unlockedAmulet 20000.0
  WalletClientV2.checkUnlockedBalance bob instrId 20000.0
  Some target <- queryContractId alice targetCid
  target.amount === 50000.0

testSubstitutionV1_updateFails : Script ()
testSubstitutionV1_updateFails = do
  (TestEnv{..}, _, _, substitutionCid) <- setupRawSubstitution
  let registry = registriesEnv.amuletV2
  expectFailureContaining substitutionTransferUpdateUnsupported =<<
    submitWithTransferContext registry (actAs instrId.admin) \context ->
      exerciseCmd substitutionCid V1.TransferInstruction_Update with extraActors = []; extraArgs = emptyExtraArgs with context

testSubstitutionV1_vestingTarget : Script ()
testSubstitutionV1_vestingTarget = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0
  lockCid <- governanceLockRawChoice registry alice 50000.0 kind
  unlockAt <- (`addRelTime` hours 1) <$> getTime
  (Some vestingCid, None, None) <- governanceUnlockRawChoice registry lockCid 50000.0 unlockAt [alice]
  Some vestingLock <- queryContractId alice vestingCid
  let newSpec = VestingLockSpecification with kind

  result <- expectSuccess $ createSubstitutionRaw env bob
    (AS_Vesting with
      vestingLockKey = VestingLockKey with
        dso = instrId.admin
        owner = alice
        specification = vestingLock.specification
        vestingPeriod = vestingLock.vestingPeriod
        endTime = vestingLock.endTime)
    20000.0

  options <- targetDisclosures alice vestingCid
  [unlockedAmulet] <- expectTransferCompleted =<< expectSuccess (acceptSubstitutionV1 env options result.proposal alice)
  WalletClientV2.checkHolding alice (coerceContractId unlockedAmulet) 20000.0
  [(_, newLock)] <- query @VestingLock bob
  newLock.owner === bob
  newLock.vestingAmount === 20000.0
  newLock.vestingPeriod === vestingLock.vestingPeriod
  newLock.endTime === vestingLock.endTime
  newLock.specification === newSpec
  WalletClientV2.checkUnlockedBalance alice instrId 20000.0

-- Substitutions proposed by the owner of the target lock
---------------------------------------------------------

-- | alice locks all her 50000.0 in an SV lock with the specification that `mkTargetSpec` builds.
setupSelfSubstitution : GovernanceLockSpecification -> Script (TestEnv, ContractId GovernanceLock, GovernanceLockSpecification)
setupSelfSubstitution targetSpec = do
  env@TestEnv{..} <- setupTest
  AmuletRegistryV2.tapFaucet registriesEnv.amuletV2 alice 49000.0 -- alice starts with 1000.0
  targetCid <- governanceLockWithSpecRawChoice registriesEnv.amuletV2 alice 50000.0 targetSpec
  WalletClientV2.checkUnlockedBalance alice instrId 0.0
  pure (env, targetCid, targetSpec)

-- | alice proposes to move `amount` of her lock with `targetSpec` to a lock with `newSpec`.
proposeSelfSubstitution
  :  TestEnv -> GovernanceLockSpecification -> Decimal
  -> Script ExternalPartyAmuletRules_GovernanceLocks_ProposeSubstitutionResult
proposeSelfSubstitution env targetSpec amount =
  expectSuccess $ createSubstitutionRaw env env.alice
    (AS_Governance with
      governanceLockKey = GovernanceLockKey with dso = env.instrId.admin; owner = env.alice; specification = targetSpec)
    amount

selfSubstitutionKind : GovernanceLockKind
selfSubstitutionKind = GLK_SuperValidatorRightsOwner "TestSV"

-- | alice proposes to substitute part of her lock without liquid funds.
testSelfSubstitution_partial : Script ()
testSelfSubstitution_partial = do
  (env@TestEnv{..}, targetCid, targetSpec) <- setupSelfSubstitution GovernanceLockSpecification with kind = selfSubstitutionKind

  -- alice has no liquid funds, and the proposal locks none
  result <- proposeSelfSubstitution env targetSpec 20000.0
  result.changeHolding === None
  Some proposal <- queryContractId alice (fromInterfaceContractId @GovernanceLockSubstitution result.proposal)
  proposal.lockedAmulet === None
  Some proposalView <- queryInterfaceContractId alice result.proposal
  proposalView.transfer.inputHoldingCids === []
  WalletClientV2.checkBalance alice instrId 50000.0

  disclosures <- targetDisclosures alice targetCid
  GovernanceLockSubstitution_AcceptResult newLockCid (Some remainingLockCid) unlockedAmulet <-
    expectSuccess $ acceptGovernanceSubstitutionRaw env disclosures (fromInterfaceContractId result.proposal) [alice]
  unlockedAmulet === None

  Some newLock <- queryContractId alice newLockCid
  newLock.owner === alice
  newLock.amount === 20000.0
  newLock.specification === targetSpec
  checkLockedHolding alice newLockCid 20000.0
  Some remainder <- queryContractId alice remainingLockCid
  remainder.amount === 30000.0
  remainder.specification === targetSpec
  checkLockedHolding alice remainingLockCid 30000.0
  WalletClientV2.checkUnlockedBalance alice instrId 0.0
  WalletClientV2.checkBalance alice instrId 50000.0

testSelfSubstitution_fullTSv1 : Script ()
testSelfSubstitution_fullTSv1 = do
  (env@TestEnv{..}, _, targetSpec) <- setupSelfSubstitution GovernanceLockSpecification with kind = selfSubstitutionKind

  result <- proposeSelfSubstitution env targetSpec 50000.0
  Some transferView <- queryInterfaceContractId alice result.proposal
  transferView.transfer.sender === alice
  transferView.transfer.receiver === alice
  transferView.transfer.inputHoldingCids === []
  transferView.status === V1.TransferPendingInternalWorkflow with
    pendingActions = Map.fromList [(alice, "accept substitution; reject substitution; withdraw substitution")]

  acceptResult <- expectSuccess $ acceptSubstitutionV1 env mempty result.proposal alice
  acceptResult.senderChangeCids === []
  receiverHoldings <- expectTransferCompleted acceptResult
  receiverHoldings === []

  [(newLockCid, newLock)] <- query @GovernanceLock alice
  newLock.amount === 50000.0
  newLock.specification === targetSpec
  checkLockedHolding alice newLockCid 50000.0
  WalletClientV2.checkUnlockedBalance alice instrId 0.0
  WalletClientV2.checkBalance alice instrId 50000.0

-- | A self-substitution ignores the input holdings.
testSelfSubstitution_ignoresInputHoldings : Script ()
testSelfSubstitution_ignoresInputHoldings = do
  (env@TestEnv{..}, _, targetSpec) <- setupSelfSubstitution GovernanceLockSpecification with kind = selfSubstitutionKind
  AmuletRegistryV2.tapFaucet registriesEnv.amuletV2 alice 5000.0

  result <- proposeSelfSubstitution env targetSpec 20000.0
  result.changeHolding === None
  WalletClientV2.checkUnlockedBalance alice instrId 5000.0
  WalletClientV2.checkBalance alice instrId 55000.0

-- | Withdrawing a self-substitution returns no funds and leaves the target lock unchanged.
testSelfSubstitution_withdraw : Script ()
testSelfSubstitution_withdraw = do
  (env@TestEnv{..}, targetCid, targetSpec) <- setupSelfSubstitution GovernanceLockSpecification with kind = selfSubstitutionKind

  -- TSv1
  result <- proposeSelfSubstitution env targetSpec 20000.0
  senderChanges <- expectTransferFailed =<< expectSuccess (withdrawSubstitutionV1 env result.proposal alice)
  senderChanges === []

  Some target <- queryContractId alice targetCid
  target.amount === 50000.0
  WalletClientV2.checkUnlockedBalance alice instrId 0.0
  WalletClientV2.checkBalance alice instrId 50000.0

-- | alice moves part of her vesting lock to a vesting lock that charlie can also withdraw from.
-- The new lock keeps the vesting period and end time of the target.
testSelfSubstitution_vesting : Script ()
testSelfSubstitution_vesting = do
  (env@TestEnv{..}, lockCid, _) <- setupSelfSubstitution GovernanceLockSpecification with kind = selfSubstitutionKind
  unlockAt <- (`addRelTime` hours 1) <$> getTime
  (Some vestingCid, None, None) <- governanceUnlockRawChoice registriesEnv.amuletV2 lockCid 50000.0 unlockAt [alice]
  Some vestingLock <- queryContractId alice vestingCid

  result <- expectSuccess $ createSubstitutionRaw env alice
    (AS_Vesting with
      vestingLockKey = VestingLockKey with
        dso = instrId.admin
        owner = alice
        specification = vestingLock.specification
        vestingPeriod = vestingLock.vestingPeriod
        endTime = vestingLock.endTime)
    20000.0
  result.changeHolding === None
  Some proposal <- queryContractId alice (fromInterfaceContractId @VestingLockSubstitution result.proposal)
  proposal.lockedAmulet === None

  VestingLockSubstitution_AcceptResult newLockCid (Some remainingLockCid) unlockedAmulet <-
    expectSuccess $ acceptVestingSubstitutionRaw env mempty (fromInterfaceContractId result.proposal) [alice]
  unlockedAmulet === None

  Some newLock <- queryContractId alice newLockCid
  newLock.owner === alice
  newLock.vestingAmount === 20000.0
  newLock.vestingPeriod === vestingLock.vestingPeriod
  newLock.endTime === vestingLock.endTime
  newLock.specification === vestingLock.specification
  checkLockedHolding alice newLockCid 20000.0
  Some remainder <- queryContractId alice remainingLockCid
  remainder.vestingAmount === 30000.0
  remainder.specification === vestingLock.specification
  checkLockedHolding alice remainingLockCid 30000.0
  WalletClientV2.checkUnlockedBalance alice instrId 0.0

-- | A proposal by the owner of the target lock fails on acceptance if the target lock has too little funds,
-- or if the remainder would be below the minimum lock amount.
testSelfSubstitution_failures : Script ()
testSelfSubstitution_failures = do
  (env@TestEnv{..}, _, targetSpec) <- setupSelfSubstitution GovernanceLockSpecification with kind = selfSubstitutionKind

  -- more than the target lock holds
  tooLarge <- proposeSelfSubstitution env targetSpec 60000.0
  expectFailureContaining "substituted lock has less funds" =<<
    acceptGovernanceSubstitutionRaw env mempty (fromInterfaceContractId tooLarge.proposal) [alice]

  -- the remainder of 5000.0 is below the minimum lock amount of 10000.0
  smallRemainder <- proposeSelfSubstitution env targetSpec 45000.0
  expectFailureContaining "minimum governance lock amount" =<<
    acceptGovernanceSubstitutionRaw env mempty (fromInterfaceContractId smallRemainder.proposal) [alice]

-- | Rejecting a proposal by the owner of the target lock returns no funds and leaves the target lock unchanged.
testSelfSubstitution_reject : Script ()
testSelfSubstitution_reject = do
  (env@TestEnv{..}, targetCid, targetSpec) <- setupSelfSubstitution GovernanceLockSpecification with kind = selfSubstitutionKind

  result <- proposeSelfSubstitution env targetSpec 20000.0
  changes <- expectTransferFailed =<< expectSuccess (rejectSubstitutionV1 env mempty result.proposal alice)
  changes === []

  Some target <- queryContractId alice targetCid
  target.amount === 50000.0
  WalletClientV2.checkUnlockedBalance alice instrId 0.0
  WalletClientV2.checkBalance alice instrId 50000.0
