expectParsed : Show a => Validation Text a -> Script a
expectParsed (Success a) = pure a
expectParsed (Errors es) = fail $ "Expected a successful parse, got errors: " <> show es

expectParseError : Show a => Text -> Validation Text a -> Script ()
expectParseError needle (Success a) =
  fail $ "Expected a parse error containing '" <> needle <> "', got " <> show a
expectParseError needle (Errors es) =
  unless (any (needle `Text.isInfixOf`) (NonEmpty.toList es)) $
    fail $ "Expected a parse error containing '" <> needle <> "', got " <> show es

-- | Proposes a substitution through `ExternalPartyAmuletRules_GovernanceLocks_ProposeSubstitution`,
-- funded with all unlocked holdings of the proposer.
createSubstitutionRaw
  :  TestEnv -> Party -> AnySubstitution -> Decimal
  -> Script (Either SubmitError ExternalPartyAmuletRules_GovernanceLocks_ProposeSubstitutionResult)
createSubstitutionRaw env proposer substitution amount = do
  now <- getTime
  proposeSubstitutionRawChoice' env.registriesEnv.amuletV2 proposer substitution amount now

-- | Discloses a target lock and its locked amulet, which controllers other than the owner cannot see.
targetDisclosures
  :  (Template t, HasEnsure t, HasField "lockedAmulet" t (ContractId LockedAmulet))
  => Party -> ContractId t -> Script Disclosures'
targetDisclosures owner cid = do
  Some lock <- queryContractId owner cid
  amuletDisclosure <- queryDisclosure' owner lock.lockedAmulet
  pure amuletDisclosure

acceptGovernanceSubstitutionRaw
  :  TestEnv -> Disclosures' -> ContractId GovernanceLockSubstitution -> [Party]
  -> Script (Either SubmitError GovernanceLockSubstitution_AcceptResult)
acceptGovernanceSubstitutionRaw env disclosures cid actors =
  submitWithTransferContext env.registriesEnv.amuletV2 (actAs actors <> discloseMany' disclosures) \context ->
    exerciseCmd cid GovernanceLockSubstitution_Accept with
      actors
      extraArgs = emptyExtraArgs with context

acceptVestingSubstitutionRaw
  :  TestEnv -> Disclosures' -> ContractId VestingLockSubstitution -> [Party]
  -> Script (Either SubmitError VestingLockSubstitution_AcceptResult)
acceptVestingSubstitutionRaw env disclosures cid actors =
  submitWithTransferContext env.registriesEnv.amuletV2 (actAs actors <> discloseMany' disclosures) \context ->
    exerciseCmd cid VestingLockSubstitution_Accept with
      actors
      extraArgs = emptyExtraArgs with context

expectFailureContaining : Text -> Either SubmitError a -> Script ()
expectFailureContaining needle (Right _) =
  fail $ "Expected a failure containing '" <> needle <> "', but the submission succeeded"
expectFailureContaining needle (Left err) =
  unless (needle `Text.isInfixOf` show err) $
    fail $ "Expected a failure containing '" <> needle <> "', got: " <> show err

acceptSubstitutionV2 : TestEnv -> Disclosures' -> ContractId V2.AllocationInstruction -> Party -> Script (Either SubmitError V2.AllocationInstructionResult)
acceptSubstitutionV2 env disclosures cid actor =
  WalletClientV2.tryAcceptAllocationInstructionV2 env.registries actor env.instrId.admin cid disclosures

withdrawSubstitutionV2 : TestEnv -> ContractId V2.AllocationInstruction -> Party -> Script (Either SubmitError V2.AllocationInstructionResult)
withdrawSubstitutionV2 env cid actor =
  WalletClientV2.tryWithdrawAllocationInstructionV2 env.registries actor env.instrId.admin cid

-- | Checks that the `allocation.meta` of a substitution proposal view contains the encoded target.
expectTargetInAllocationMeta : Metadata -> V2.AllocationSpecification -> Script ()
expectTargetInAllocationMeta targetMeta allocation =
  TextMap.filterWithKey (\k _ -> TextMap.member k targetMeta.values) allocation.meta.values === targetMeta.values

-- | Checks that the `allocation` of a substitution proposal view equals the `allocation` of the lock
-- that the accepted proposal created, plus the substitution request and the encoded target in `allocation.meta`.
-- and the accept request in the memo.
expectSubstitutionAllocation : Metadata -> V2.AllocationSpecification -> V2.AllocationSpecification -> Script ()
expectSubstitutionAllocation targetMeta allocation newLockAllocation = do
  let withoutMemo meta = Metadata $ TextMap.delete reasonMetaKey meta.values
      memoFields meta = parseGovernanceLockMetadata @(Either Text) $ Metadata $ TextMap.singleton reasonMetaKey (reasonFromMeta meta)
  (allocation with meta = withoutMemo allocation.meta) === newLockAllocation with
    meta = withoutMemo $ newLockAllocation.meta <> substitutionRequestMetadata <> targetMeta
  memoFields allocation.meta === ((<>) substitutionAcceptRequestMetadata <$> memoFields newLockAllocation.meta)

expectInstructionPending : V2.AllocationInstructionResult -> Script (ContractId V2.AllocationInstruction)
expectInstructionPending result = case result.output of
  V2.AllocationInstructionResult_Pending cid -> pure cid
  output -> fail $ "Expected AllocationInstructionResult_Pending, got " <> show output

expectInstructionCompleted : V2.AllocationInstructionResult -> Script (ContractId V2.Allocation)
expectInstructionCompleted result = case result.output of
  V2.AllocationInstructionResult_Completed cid -> pure cid
  output -> fail $ "Expected AllocationInstructionResult_Completed, got " <> show output

-- | Returns the change holdings of a failed instruction.
expectInstructionFailed : TestEnv -> V2.AllocationInstructionResult -> Script [ContractId V2.Holding]
expectInstructionFailed env result = case result.output of
  V2.AllocationInstructionResult_Failed ->
    pure $ fromOptional [] $ TextMap.lookup env.instrId.id result.authorizerChangeCids
  output -> fail $ "Expected AllocationInstructionResult_Failed, got " <> show output

-- | Proposes a substitution through `AllocationFactory_Allocate`, funded with all unlocked
-- holdings of the proposer. `meta` gets the substitution request and the lock subject of `kind` added.
createSubstitutionV2
  :  TestEnv -> Party -> Decimal -> GovernanceLockKind -> Metadata
  -> Script (Either SubmitError V2.AllocationInstructionResult)
createSubstitutionV2 env proposer amount kind meta = do
  let admin = env.instrId.admin
      (tag, lockSubject) = governanceLockKindToTagAndSubject kind
      settlement = V2.SettlementInfo with
        executors = [admin]
        id = governanceLockTagToText tag
        cid = None
        meta = emptyMetadata
      allocation = V2.AllocationSpecification with
        admin
        authorizer = basicAccount proposer
        transferLegSides = []
        settlementDeadline = Some maxComparableTime
        nextIterationFunding = Some $ TextMap.singleton env.instrId.id amount
        committed = False
        meta = Metadata $ TextMap.insert lockSubjectMetaKey lockSubject $ (substitutionRequestMetadata <> meta).values

  WalletClientV2.tryAllocateV2 env.registries proposer settlement allocation

parseSubstitutionTSv2 : (Party, Text, Metadata, Party) -> Validation Text AnySubstitution
parseSubstitutionTSv2 (admin, id, meta, proposer) =
  runParser (substitutionTSv2Parser admin id proposer) (substitutionRequestMetadata <> meta)

testSubstitutionMeta_lockedTargetDefaults : Script ()
testSubstitutionMeta_lockedTargetDefaults = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  let kind = GLK_SuperValidatorRightsOwner "TestSV"
      meta = Metadata $ TextMap.fromList
        [ (lockSubjectMetaKey, "TestSV")
        , (targetLockOwnerMetaKey, partyToText alice)
        ]
  parsed <- expectParsed $ parseSubstitutionTSv2 (admin, governanceLockTagToText GLT_SuperValidator, meta, bob)
  parsed === AS_Governance with
    governanceLockKey = GovernanceLockKey with
      dso = admin
      owner = alice
      specification = ownerControlledSpecification alice kind
    governanceSpecification = ownerControlledSpecification bob kind

testSubstitutionMeta_lockedTargetRoundTrip : Script ()
testSubstitutionMeta_lockedTargetRoundTrip = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  s <- allocateParty "s"
  x <- allocateParty "x"
  let kind = GLK_FeaturedApp x
      targetKey = GovernanceLockKey with
        dso = admin
        owner = alice
        specification = GovernanceLockSpecification with
          kind
          unlockControllers = ControllerSpecification [[s, x], [alice]]
          substitutionControllers = ControllerSpecification [[s, x]]
          vestingControllers = ControllerSpecification [[s], [alice]]
      newSpec = GovernanceLockSpecification with
        kind
        unlockControllers = ControllerSpecification [[bob, s]]
        substitutionControllers = ControllerSpecification [[bob]]
        vestingControllers = ControllerSpecification [[bob], [s]]
      meta = encodeGovernanceLockSubstitutionTargetMetadata targetKey <>
        encodeGovernanceLockSpecControllers bob newSpec <>
        (Metadata $ TextMap.fromList [(lockSubjectMetaKey, partyToText x)])
  parsed <- expectParsed $ parseSubstitutionTSv2 (admin, governanceLockTagToText GLT_FeaturedApp, meta, bob)
  parsed === AS_Governance with governanceLockKey = targetKey; governanceSpecification = newSpec

testSubstitutionMeta_vestingTargetRoundTrip : Script ()
testSubstitutionMeta_vestingTargetRoundTrip = do
  now <- getTime
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  s <- allocateParty "s"
  let kind = GLK_SuperValidatorRightsOwner "TestSV"
      targetKey = VestingLockKey with
        dso = admin
        owner = alice
        specification = VestingLockSpecification with
          kind
          vestingControllers = ControllerSpecification [[s], [alice]]
        vestingPeriod = days 60
        endTime = now `addRelTime` days 45
      newSpec = VestingLockSpecification with
        kind
        vestingControllers = ControllerSpecification [[s, bob]]
      meta = encodeVestingLockSubstitutionTargetMetadata targetKey <>
        encodeVestingLockSpecControllers bob newSpec <>
        (Metadata $ TextMap.fromList [(lockSubjectMetaKey, "TestSV")])
  parsed <- expectParsed $ parseSubstitutionTSv2 (admin, governanceLockTagToText GLT_SuperValidator, meta, bob)
  parsed === AS_Vesting with vestingLockKey = targetKey; vestingSpecification = newSpec

testSubstitutionMeta_failures : Script ()
testSubstitutionMeta_failures = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  let base = TextMap.fromList
        [ (lockSubjectMetaKey, "TestSV")
        , (targetLockOwnerMetaKey, partyToText alice)
        ]
      parse values = parseSubstitutionTSv2 (admin, governanceLockTagToText GLT_SuperValidator, Metadata values, bob)

  expectParseError lockStatusMetaKey $
    parse $ TextMap.insert lockStatusMetaKey "unlocking" base
  expectParseError targetLockOwnerMetaKey $
    parse $ TextMap.insert targetLockOwnerMetaKey "bad$party" base
  expectParseError lockSubjectMetaKey $
    parse $ TextMap.delete lockSubjectMetaKey base
  expectParseError unlockControllersMetaKey $
    parse $ TextMap.insert unlockControllersMetaKey (partyToText bob) $
      TextMap.insert lockStatusMetaKey (lockStateToText LS_Vesting) base
  expectParseError targetLockSubstitutionControllersMetaKey $
    parse $ TextMap.insert targetLockSubstitutionControllersMetaKey (partyToText alice) $
      TextMap.insert lockStatusMetaKey (lockStateToText LS_Vesting) base
  expectParseError lockVestingDurationMetaKey $
    parse $ TextMap.insert lockStatusMetaKey (lockStateToText LS_Vesting) base
  expectParseError lockVestingEndTimeMetaKey $
    parse $ TextMap.insert lockStatusMetaKey (lockStateToText LS_Vesting) base

testSubstitution_governanceLock : Script ()
testSubstitution_governanceLock = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2

  let dso = env.instrId.admin
  let someSvKind = GLK_SuperValidatorRightsOwner "TestSV"


  let testLockAmount = 180000.0
  AmuletRegistryV2.tapFaucet registriesEnv.amuletV2 alice (testLockAmount - 1000.0) -- Env creates 1000.0 for alice, so we top up to 180k
  AmuletRegistryV2.tapFaucet registriesEnv.amuletV2 bob testLockAmount

  governanceLockRawChoice registry alice testLockAmount someSvKind

  -- check balances
  let checkBalances (aliceUnlocked, aliceLocked) (bobUnlocked, bobLocked) = do
        WalletClientV2.checkUnlockedBalance alice env.instrId aliceUnlocked
        WalletClientV2.checkBalance alice env.instrId (aliceUnlocked + aliceLocked)
        WalletClientV2.checkUnlockedBalance bob env.instrId bobUnlocked
        WalletClientV2.checkBalance bob env.instrId (bobUnlocked + bobLocked)

  checkBalances (0.0, testLockAmount) (testLockAmount, 0.0)

  -- propose two partial substs
  let testSubstAmount = 50000.0

  -- TODO(canton-network/splice-sv-fa-locking#118): share that submission code with the other instances
  (rulesCid, disc) <- AmuletRegistryV2.getExtAmuletRulesWithDisclosures registry
  now <- getTime
  let createSubstitution amount = do
        inputHoldingCids <- WalletClientV2.listUnlockedHoldingCidsFor (basicAccount bob) bob env.instrId
        result <- submitWithTransferContext registry (actAs [bob] <> discloseMany' disc) $ \context ->
          exerciseCmd rulesCid ExternalPartyAmuletRules_GovernanceLocks_ProposeSubstitution with
            args = CreateSubstitutionArgs with
              dso
              substitution = AS_Governance with
                governanceLockKey = GovernanceLockKey with
                  dso
                  owner = alice
                  specification = ownerControlledSpecification alice someSvKind
                governanceSpecification = GovernanceLockSpecification with
                  kind = GLK_SuperValidatorRightsOwner "TestSV"
                  unlockControllers = ControllerSpecification [[bob]]
                  substitutionControllers = ControllerSpecification [[bob]]
                  vestingControllers = ControllerSpecification [[bob]]
              owner = bob
              amount
              inputHoldingCids = map downcast inputHoldingCids
              extraArgs = emptyExtraArgs with context
              requestedAt = now
        errorIfLeft result
        pure ()

  createSubstitution (testSubstAmount / 2.0)
  createSubstitution (testSubstAmount / 2.0)

  checkBalances (0.0, testLockAmount) (testLockAmount - testSubstAmount, testSubstAmount)

  -- accept substitution
  let acceptOneSubstitution = do
        (substitutionCid, _)::_ <- query @GovernanceLockSubstitution dso
        result <- submitWithTransferContext registry (actAs [alice]) $ \context ->
          exerciseCmd substitutionCid GovernanceLockSubstitution_Accept with
            actors = [ alice ]
            extraArgs = emptyExtraArgs with context
        errorIfLeft result

  acceptOneSubstitution
  query @GovernanceLock alice >>= (debug . show)
  acceptOneSubstitution
  checkBalances (testSubstAmount, testLockAmount - testSubstAmount) (testLockAmount - testSubstAmount, testSubstAmount)

  -- propose full subst
  (rulesCid, disc) <- AmuletRegistryV2.getExtAmuletRulesWithDisclosures registry
  inputHoldingCids <- WalletClientV2.listUnlockedHoldingCidsFor (basicAccount bob) bob env.instrId
  result <- submitWithTransferContext registry (actAs [bob] <> discloseMany' disc) $ \context ->
    exerciseCmd rulesCid ExternalPartyAmuletRules_GovernanceLocks_ProposeSubstitution with
      args = CreateSubstitutionArgs with
        dso
        substitution = AS_Governance with
                governanceLockKey = GovernanceLockKey with
                  dso
                  owner = alice
                  specification = ownerControlledSpecification alice someSvKind
                governanceSpecification = GovernanceLockSpecification with
                  kind = GLK_SuperValidatorRightsOwner "TestSV"
                  unlockControllers = ControllerSpecification [[bob]]
                  substitutionControllers = ControllerSpecification [[bob]]
                  vestingControllers = ControllerSpecification [[bob]]
        owner = bob
        amount = testLockAmount - testSubstAmount
        inputHoldingCids = map downcast inputHoldingCids
        extraArgs = emptyExtraArgs with context
        requestedAt = now
  _ <- errorIfLeft result

  checkBalances (testSubstAmount, testLockAmount - testSubstAmount) (0.0, testLockAmount)

  -- accept substitution
  acceptOneSubstitution

  checkBalances (testLockAmount, 0.0) (0.0, testLockAmount)

  pure ()

testSubstitutionRaw_oneStepApprovalWithoutOwner : Script ()
testSubstitutionRaw_oneStepApprovalWithoutOwner = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0 -- alice starts with 1000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0

  let targetSpec = (ownerControlledSpecification alice kind) with
        substitutionControllers = ControllerSpecification [[charlie]]
  governanceLockCid <- governanceLockWithSpecRawChoice registry alice 50000.0 targetSpec

  -- Some (GovernanceLock { lockedAmulet }) <- queryContractId bob governanceLockCid
  -- lockedAmuletDisclosure <- queryDisclosure bob lockedAmulet

  expectSuccess $ createSubstitutionRaw env bob
    (AS_Governance with
      governanceLockKey = GovernanceLockKey with dso = instrId.admin; owner = alice; specification = targetSpec
      governanceSpecification = ownerControlledSpecification bob kind)
    20000.0
  [(substitutionCid, _)] <- query @GovernanceLockSubstitution bob

  disclosures <- targetDisclosures alice governanceLockCid
  GovernanceLockSubstitution_AcceptResult_Complete newLockCid (Some remainderCid) _ <-
    expectSuccess $ acceptGovernanceSubstitutionRaw env disclosures substitutionCid [charlie]

  checkLockedHolding bob newLockCid 20000.0
  checkLockedHolding alice remainderCid 30000.0
  WalletClientV2.checkUnlockedBalance alice instrId 20000.0
  WalletClientV2.checkUnlockedBalance bob instrId 0.0

testSubstitutionRaw_twoStepApprovalWithoutOwner : Script ()
testSubstitutionRaw_twoStepApprovalWithoutOwner = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  dave <- allocateParty "dave"
  AmuletRegistryV2.tapFaucet registry alice 49000.0 -- alice starts with 1000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0

  let targetSpec = (ownerControlledSpecification alice kind) with
        substitutionControllers = ControllerSpecification [[charlie, dave]]
  targetCid <- governanceLockWithSpecRawChoice registry alice 50000.0 targetSpec

  expectSuccess $ createSubstitutionRaw env bob
    (AS_Governance with
      governanceLockKey = GovernanceLockKey with dso = instrId.admin; owner = alice; specification = targetSpec
      governanceSpecification = ownerControlledSpecification bob kind)
    20000.0
  [(substitutionCid, _)] <- query @GovernanceLockSubstitution bob

  GovernanceLockSubstitution_AcceptResult_Pending pendingCid <-
    expectSuccess $ acceptGovernanceSubstitutionRaw env mempty substitutionCid [charlie]
  disclosures <- targetDisclosures alice targetCid
  GovernanceLockSubstitution_AcceptResult_Complete newLockCid (Some remainderCid) _ <-
    expectSuccess $ acceptGovernanceSubstitutionRaw env disclosures pendingCid [dave]

  checkLockedHolding bob newLockCid 20000.0
  checkLockedHolding alice remainderCid 30000.0
  WalletClientV2.checkUnlockedBalance alice instrId 20000.0
  WalletClientV2.checkUnlockedBalance bob instrId 0.0

testSubstitutionRaw_failures : Script ()
testSubstitutionRaw_failures = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0 -- alice starts with 1000.0
  AmuletRegistryV2.tapFaucet registry bob 60000.0

  let targetSpec = (ownerControlledSpecification alice kind) with
  _ <- governanceLockWithSpecRawChoice registry alice 50000.0 targetSpec

  -- Insufficient funds to create the substitution
  expectFailureContaining "Insufficient funds: you are missing" =<< createSubstitutionRaw env charlie
    (AS_Governance with
      governanceLockKey = GovernanceLockKey with dso = instrId.admin; owner = alice; specification = targetSpec
      governanceSpecification = ownerControlledSpecification bob kind)
    60000.0

  -- Insufficient lock size on the accepter side
  expectSuccess $ createSubstitutionRaw env bob
    (AS_Governance with
      governanceLockKey = GovernanceLockKey with dso = instrId.admin; owner = alice; specification = targetSpec
      governanceSpecification = ownerControlledSpecification bob kind)
    60000.0
  [(substitutionCid, _)] <- query @GovernanceLockSubstitution bob

  expectFailureContaining "substituted lock has less funds " =<<
    acceptGovernanceSubstitutionRaw env mempty substitutionCid [alice]

-- | Negative: `expiresAt` is derived from `requestedAt`, so dating a proposal into
-- the future would let the proposer choose how long the registry admin has to wait to withdraw it.
testSubstitutionRaw_futureRequestedAt : Script ()
testSubstitutionRaw_futureRequestedAt = do
  TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0

  let targetSpec = ownerControlledSpecification alice kind
  _ <- governanceLockWithSpecRawChoice registry alice 50000.0 targetSpec

  requestedAt <- (`addRelTime` days 1) <$> getTime
  expectFailureContaining "requestedAt" =<< proposeSubstitutionRawChoice' registry bob
    (AS_Governance with
      governanceLockKey = GovernanceLockKey with dso = instrId.admin; owner = alice; specification = targetSpec
      governanceSpecification = ownerControlledSpecification bob kind)
    20000.0 requestedAt

testSubstitutionRaw_vestingWithoutOwner : Script ()
testSubstitutionRaw_vestingWithoutOwner = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0

  let lockSpec = (ownerControlledSpecification alice kind) with
        vestingControllers = ControllerSpecification [[charlie]]
  lockCid <- governanceLockWithSpecRawChoice registry alice 50000.0 lockSpec
  unlockAt <- (`addRelTime` hours 1) <$> getTime
  (Some vestingCid, None, None) <- governanceUnlockRawChoice registry lockCid 50000.0 unlockAt [alice]
  Some vestingLock <- queryContractId alice vestingCid

  expectSuccess $ createSubstitutionRaw env bob
    (AS_Vesting with
      vestingLockKey = VestingLockKey with
        dso = instrId.admin
        owner = alice
        specification = vestingLock.specification
        vestingPeriod = vestingLock.vestingPeriod
        endTime = vestingLock.endTime
      vestingSpecification = VestingLockSpecification with kind; vestingControllers = ControllerSpecification [[bob]])
    20000.0
  [(substitutionCid, _)] <- query @VestingLockSubstitution bob

  disclosures <- targetDisclosures alice vestingCid
  VestingLockSubstitution_AcceptResult_Complete newLockCid (Some remainderCid) _ <-
    expectSuccess $ acceptVestingSubstitutionRaw env disclosures substitutionCid [charlie]

  Some newLock <- queryContractId bob newLockCid
  newLock.vestingAmount === 20000.0
  newLock.vestingPeriod === vestingLock.vestingPeriod
  newLock.endTime === vestingLock.endTime
  Some remainder <- queryContractId alice remainderCid
  remainder.vestingAmount === 30000.0
  WalletClientV2.checkUnlockedBalance alice instrId 20000.0

-- TSv2 on raw-created substitutions
------------------------------------

-- | alice holds a 50000.0 owner-controlled SV lock; bob has 20000.0 liquid and proposes to
-- substitute 20000.0 of it with an owner-controlled lock.
setupRawSubstitution : Script (TestEnv, ContractId GovernanceLock, GovernanceLockKey, GovernanceLockSpecification, ContractId V2.AllocationInstruction)
setupRawSubstitution = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0
  targetCid <- governanceLockRawChoice registry alice 50000.0 kind
  let targetKey = GovernanceLockKey with dso = instrId.admin; owner = alice; specification = ownerControlledSpecification alice kind
      newSpec = ownerControlledSpecification bob kind
  result <- expectSuccess $ createSubstitutionRaw env bob
    (AS_Governance with governanceLockKey = targetKey; governanceSpecification = newSpec)
    20000.0
  pure (env, targetCid, targetKey, newSpec, result.proposal)

testSubstitutionV2_rawSubstitutionView : Script ()
testSubstitutionV2_rawSubstitutionView = do
  (TestEnv{..}, _, targetKey, _, substitutionCid) <- setupRawSubstitution
  Some substitutionView <- queryInterfaceContractId bob substitutionCid
  substitutionView.availableActions === Map.fromList [(V2.AIA_Accept, [[alice]]), (V2.AIA_Withdraw, [[bob]])]
  substitutionView.meta === emptyMetadata
  expectTargetInAllocationMeta (encodeGovernanceLockSubstitutionTargetMetadata targetKey) substitutionView.allocation
  substitutionView.originalInstructionCid === None
  length substitutionView.inputHoldingCids === 1
  substitutionView.allocation.authorizer === basicAccount bob
  substitutionView.allocation.nextIterationFunding === Some (TextMap.singleton instrId.id 20000.0)
  substitutionView.settlement.id === governanceLockTagToText GLT_SuperValidator

testSubstitutionV2_acceptRawSubstitution : Script ()
testSubstitutionV2_acceptRawSubstitution = do
  (env@TestEnv{..}, targetCid, targetKey, newSpec, substitutionCid) <- setupRawSubstitution
  Some substitutionView <- queryInterfaceContractId bob substitutionCid
  options <- targetDisclosures alice targetCid
  newLockCid <- expectInstructionCompleted =<< expectSuccess (acceptSubstitutionV2 env options substitutionCid alice)

  Some newLockView <- queryInterfaceContractId bob newLockCid
  expectSubstitutionAllocation (encodeGovernanceLockSubstitutionTargetMetadata targetKey) substitutionView.allocation newLockView.allocation
  newLockView.settlement === substitutionView.settlement
  Some newLock <- queryContractId bob (fromInterfaceContractId @GovernanceLock newLockCid)
  newLock.owner === bob
  newLock.amount === 20000.0
  newLock.specification === newSpec
  WalletClientV2.checkUnlockedBalance alice instrId 20000.0
  WalletClientV2.checkBalance alice instrId 50000.0

testSubstitutionV2_withdrawRawSubstitution : Script ()
testSubstitutionV2_withdrawRawSubstitution = do
  (env@TestEnv{..}, _, _, _, substitutionCid) <- setupRawSubstitution
  WalletClientV2.checkUnlockedBalance bob instrId 0.0
  changes <- expectInstructionFailed env =<< expectSuccess (withdrawSubstitutionV2 env substitutionCid bob)
  length changes === 1
  WalletClientV2.checkUnlockedBalance bob instrId 20000.0
  archived <- queryInterfaceContractId bob substitutionCid
  archived === None

-- TSv2 through AllocationFactory_Allocate
------------------------------------------

testSubstitutionV2_partialCompatTarget : Script ()
testSubstitutionV2_partialCompatTarget = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0
  errorIfLeft =<< governanceLockV1 env alice 50000.0 kind emptyMetadata

  result <- expectSuccess $ createSubstitutionV2 env bob 20000.0 kind $
    Metadata $ TextMap.fromList [(targetLockOwnerMetaKey, partyToText alice)]
  TextMap.lookup instrId.id result.authorizerChangeCids === Some []
  substitutionCid <- expectInstructionPending result
  [(targetCid, _)] <- query @GovernanceLock alice
  options <- targetDisclosures alice targetCid
  newLockCid <- expectInstructionCompleted =<< expectSuccess (acceptSubstitutionV2 env options substitutionCid alice)

  Some newLock <- queryContractId bob (fromInterfaceContractId @GovernanceLock newLockCid)
  newLock.amount === 20000.0
  newLock.specification === ownerControlledSpecification bob kind
  [(_, remainder)] <- query @GovernanceLock alice
  remainder.amount === 30000.0
  WalletClientV2.checkUnlockedBalance alice instrId 20000.0

testSubstitutionV2_full : Script ()
testSubstitutionV2_full = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0
  AmuletRegistryV2.tapFaucet registry bob 50000.0
