import DA.Assert ((===))
import DA.Map qualified as Map
import DA.NonEmpty qualified as NonEmpty
import DA.Text qualified as Text
import DA.TextMap qualified as TextMap
import DA.Time
import DA.Validation

import Daml.Script
import Splice.Amulet
import Splice.Api.Token.HoldingV1 qualified as V1
import Splice.Api.Token.MetadataV1
