testSubstitutionV2_vestingTarget : Script ()
testSubstitutionV2_vestingTarget = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0
  lockCid <- governanceLockRawChoice registry alice 50000.0 kind
  unlockAt <- (`addRelTime` hours 1) <$> getTime
  (Some vestingCid, None, None) <- governanceUnlockRawChoice registry lockCid 50000.0 unlockAt [alice]
  Some vestingLock <- queryContractId alice vestingCid
  let targetKey = VestingLockKey with
        dso = instrId.admin
        owner = alice
        specification = vestingLock.specification
        vestingPeriod = vestingLock.vestingPeriod
        endTime = vestingLock.endTime

  substitutionCid <- expectInstructionPending =<< expectSuccess (createSubstitutionV2 env bob 20000.0 kind $
    encodeVestingLockSubstitutionTargetMetadata targetKey)
  Some substitutionView <- queryInterfaceContractId bob substitutionCid
  substitutionView.meta === emptyMetadata
  expectTargetInAllocationMeta (encodeVestingLockSubstitutionTargetMetadata targetKey) substitutionView.allocation

  options <- targetDisclosures alice vestingCid
  newLockCid <- expectInstructionCompleted =<< expectSuccess (acceptSubstitutionV2 env options substitutionCid alice)

  Some newLockView <- queryInterfaceContractId bob newLockCid
  expectSubstitutionAllocation (encodeVestingLockSubstitutionTargetMetadata targetKey) substitutionView.allocation newLockView.allocation
  Some newLock <- queryContractId bob (fromInterfaceContractId @VestingLock newLockCid)
  newLock.owner === bob
  newLock.vestingAmount === 20000.0
  newLock.vestingPeriod === vestingLock.vestingPeriod
  newLock.endTime === vestingLock.endTime
  newLock.specification === VestingLockSpecification with kind; vestingControllers = ControllerSpecification [[bob]]
  [(_, remainder)] <- filter (\(_, l) -> l.owner == alice) <$> query @VestingLock alice
  remainder.vestingAmount === 30000.0
  WalletClientV2.checkUnlockedBalance alice instrId 20000.0

testSubstitutionV2_twoStepApproval : Script ()
testSubstitutionV2_twoStepApproval = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  dave <- allocateParty "dave"
  AmuletRegistryV2.tapFaucet registry alice 49000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0
  let targetSubstitutionControllers = ControllerSpecification [[charlie, dave]]
      targetSpec = (ownerControlledSpecification alice kind) with substitutionControllers = targetSubstitutionControllers
  WalletClientV2.createBatchingUtility charlie
  WalletClientV2.createBatchingUtility dave
  targetCid <- governanceLockWithSpecRawChoice registry alice 50000.0 targetSpec

  firstCid <- expectInstructionPending =<< expectSuccess (createSubstitutionV2 env bob 20000.0 kind $
    encodeControllerSpecification alice targetLockSubstitutionControllersMetaKey targetSubstitutionControllers <>
      (Metadata $ TextMap.fromList [(targetLockOwnerMetaKey, partyToText alice)]))
  Some firstView <- queryInterfaceContractId charlie firstCid
  firstView.availableActions === Map.fromList [(V2.AIA_Accept, [[charlie, dave]]), (V2.AIA_Withdraw, [[bob]])]

  pendingCid <- expectInstructionPending =<< expectSuccess (acceptSubstitutionV2 env mempty firstCid charlie)
  Some pendingView <- queryInterfaceContractId charlie pendingCid
  pendingView.originalInstructionCid === Some firstCid

  expectFailureContaining "at least one actor's approval must change" =<< acceptSubstitutionV2 env mempty pendingCid charlie

  options <- targetDisclosures alice targetCid
  _ <- expectInstructionCompleted =<< expectSuccess (acceptSubstitutionV2 env options pendingCid dave)
  WalletClientV2.checkUnlockedBalance alice instrId 20000.0

testSubstitutionV2_failures : Script ()
testSubstitutionV2_failures = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
      targetOwnerMeta = [(targetLockOwnerMetaKey, partyToText alice)]
  AmuletRegistryV2.tapFaucet registry alice 19000.0
  AmuletRegistryV2.tapFaucet registry bob 60000.0
  targetCid <- governanceLockRawChoice registry alice 20000.0 kind
  options <- targetDisclosures alice targetCid

  -- the proposer is not a target controller
  substitutionCid <- expectInstructionPending =<< expectSuccess (createSubstitutionV2 env bob 10000.0 kind $
    Metadata $ TextMap.fromList targetOwnerMeta)
  expectFailureContaining "must be a controller" =<< acceptSubstitutionV2 env options substitutionCid bob

  -- the target controllers do not match the lock of alice
  mismatchCid <- expectInstructionPending =<< expectSuccess (createSubstitutionV2 env bob 10000.0 kind $
    encodeControllerSpecification alice targetLockUnlockControllersMetaKey (ControllerSpecification [[alice], [bob]]) <>
      (Metadata $ TextMap.fromList targetOwnerMeta))
  result <- acceptSubstitutionV2 env options mismatchCid alice
  case result of
    Left _ -> pure ()
    Right r -> fail $ "Expected the accept of a substitution for an unknown target to fail, got " <> show r

  -- the proposal is larger than the target
  largeCid <- expectInstructionPending =<< expectSuccess (createSubstitutionV2 env bob 30000.0 kind $
    Metadata $ TextMap.fromList targetOwnerMeta)
  expectFailureContaining "substituted lock has less funds" =<< acceptSubstitutionV2 env options largeCid alice

  -- invalid metadata
  expectFailureContaining lockStatusMetaKey =<< createSubstitutionV2 env bob 10000.0 kind
    (Metadata $ TextMap.fromList $ (lockStatusMetaKey, "unlocking") :: targetOwnerMeta)
  expectFailureContaining unlockControllersMetaKey =<< createSubstitutionV2 env bob 10000.0 kind
    (Metadata $ TextMap.fromList $
      (lockStatusMetaKey, lockStateToText LS_Vesting)
      :: (unlockControllersMetaKey, partyToText bob)
      :: targetOwnerMeta)

-- TSv1 on raw-created substitutions
------------------------------------

-- | The TSv1 interface of a substitution proposal, which has the same contract id as its TSv2 interface.
asTransferInstruction : ContractId V2.AllocationInstruction -> ContractId V1.TransferInstruction
asTransferInstruction = coerceContractId

acceptSubstitutionV1 : TestEnv -> Disclosures' -> ContractId V1.TransferInstruction -> Party -> Script (Either SubmitError V1.TransferInstructionResult)
acceptSubstitutionV1 env disclosures cid actor =
  submitWithTransferContext env.registriesEnv.amuletV2 (actAs actor <> discloseMany' disclosures) \context ->
    exerciseCmd cid V1.TransferInstruction_Accept with extraArgs = emptyExtraArgs with context

withdrawSubstitutionV1 : TestEnv -> ContractId V1.TransferInstruction -> Party -> Script (Either SubmitError V1.TransferInstructionResult)
withdrawSubstitutionV1 env cid actor =
  submitWithTransferContext env.registriesEnv.amuletV2 (actAs actor) \context ->
    exerciseCmd cid V1.TransferInstruction_Withdraw with extraArgs = emptyExtraArgs with context

expectTransferPending : V1.TransferInstructionResult -> Script (ContractId V1.TransferInstruction)
expectTransferPending result = case result.output of
  V1.TransferInstructionResult_Pending cid -> pure cid
  output -> fail $ "Expected TransferInstructionResult_Pending, got " <> show output

-- | Returns the holdings of the receiver of a completed transfer instruction.
expectTransferCompleted : V1.TransferInstructionResult -> Script [ContractId V1.Holding]
expectTransferCompleted result = case result.output of
  V1.TransferInstructionResult_Completed receiverHoldingCids -> pure receiverHoldingCids
  output -> fail $ "Expected TransferInstructionResult_Completed, got " <> show output

-- | Returns the change holdings of a failed transfer instruction.
expectTransferFailed : V1.TransferInstructionResult -> Script [ContractId V1.Holding]
expectTransferFailed result = case result.output of
  V1.TransferInstructionResult_Failed -> pure result.senderChangeCids
  output -> fail $ "Expected TransferInstructionResult_Failed, got " <> show output

-- | Checks that the TSv1 view of a substitution proposal matches its TSv2 view.
expectTransferMatchesAllocation : Party -> V2.AllocationInstructionView -> V1.TransferInstructionView -> Script ()
expectTransferMatchesAllocation targetOwner allocationView transferView = do
  transferView.originalInstructionCid === (coerceContractId <$> allocationView.originalInstructionCid)
  basicAccount transferView.transfer.sender === allocationView.allocation.authorizer
  transferView.transfer.receiver === targetOwner
  Some (TextMap.singleton transferView.transfer.instrumentId.id transferView.transfer.amount) === allocationView.allocation.nextIterationFunding
  transferView.transfer.instrumentId.admin === allocationView.allocation.admin
  transferView.transfer.requestedAt === allocationView.requestedAt
  transferView.transfer.executeBefore === maxBound
  transferView.transfer.inputHoldingCids === map coerceContractId allocationView.inputHoldingCids
  transferView.transfer.meta === allocationView.allocation.meta
  transferView.meta === emptyMetadata

testSubstitutionV1_rawSubstitutionView : Script ()
testSubstitutionV1_rawSubstitutionView = do
  (TestEnv{..}, _, _, _, substitutionCid) <- setupRawSubstitution
  Some allocationView <- queryInterfaceContractId bob substitutionCid
  Some transferView <- queryInterfaceContractId bob (asTransferInstruction substitutionCid)
  expectTransferMatchesAllocation alice allocationView transferView
  transferView.transfer.amount === 20000.0
  transferView.status === V1.TransferPendingInternalWorkflow with
    pendingActions = Map.fromList [(alice, "accept substitution"), (bob, "withdraw substitution")]

testSubstitutionV1_acceptRawSubstitution : Script ()
testSubstitutionV1_acceptRawSubstitution = do
  (env@TestEnv{..}, targetCid, _, newSpec, substitutionCid) <- setupRawSubstitution
  options <- targetDisclosures alice targetCid
  result <- expectSuccess (acceptSubstitutionV1 env options (asTransferInstruction substitutionCid) alice)
  result.senderChangeCids === []
  [unlockedAmulet] <- expectTransferCompleted result
  WalletClientV2.checkHolding alice (coerceContractId unlockedAmulet) 20000.0

  [(_, newLock)] <- query @GovernanceLock bob
  newLock.owner === bob
  newLock.amount === 20000.0
  newLock.specification === newSpec
  WalletClientV2.checkUnlockedBalance alice instrId 20000.0
  WalletClientV2.checkBalance alice instrId 50000.0

testSubstitutionV1_withdrawRawSubstitution : Script ()
testSubstitutionV1_withdrawRawSubstitution = do
  (env@TestEnv{..}, _, _, _, substitutionCid) <- setupRawSubstitution
  WalletClientV2.checkUnlockedBalance bob instrId 0.0
  changes <- expectTransferFailed =<< expectSuccess (withdrawSubstitutionV1 env (asTransferInstruction substitutionCid) bob)
  length changes === 1
  WalletClientV2.checkUnlockedBalance bob instrId 20000.0
  archived <- queryInterfaceContractId bob substitutionCid
  archived === None

testSubstitutionV1_rejectAndUpdateFail : Script ()
testSubstitutionV1_rejectAndUpdateFail = do
  (TestEnv{..}, _, _, _, substitutionCid) <- setupRawSubstitution
  let registry = registriesEnv.amuletV2
      cid = asTransferInstruction substitutionCid
  expectFailureContaining substitutionTransferRejectUnsupported =<<
    submitWithTransferContext registry (actAs alice) \context ->
      exerciseCmd cid V1.TransferInstruction_Reject with extraArgs = emptyExtraArgs with context
  expectFailureContaining substitutionTransferUpdateUnsupported =<<
    submitWithTransferContext registry (actAs instrId.admin) \context ->
      exerciseCmd cid V1.TransferInstruction_Update with extraActors = []; extraArgs = emptyExtraArgs with context

-- | The owner of the target lock accepts through TSv1, and another substitution controller completes the accept.
testSubstitutionV1_twoStepApproval : Script ()
testSubstitutionV1_twoStepApproval = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0
  let targetSpec = (ownerControlledSpecification alice kind) with
        substitutionControllers = ControllerSpecification [[alice, charlie]]
  targetCid <- governanceLockWithSpecRawChoice registry alice 50000.0 targetSpec

  result <- expectSuccess $ createSubstitutionRaw env bob
    (AS_Governance with
      governanceLockKey = GovernanceLockKey with dso = instrId.admin; owner = alice; specification = targetSpec
      governanceSpecification = ownerControlledSpecification bob kind)
    20000.0
  let firstCid = asTransferInstruction result.proposal
  Some firstView <- queryInterfaceContractId alice firstCid
  firstView.status === V1.TransferPendingInternalWorkflow with
    pendingActions = Map.fromList [(alice, "accept substitution"), (bob, "withdraw substitution"), (charlie, "accept substitution")]

  pendingCid <- expectTransferPending =<< expectSuccess (acceptSubstitutionV1 env mempty firstCid alice)
  Some pendingView <- queryInterfaceContractId alice pendingCid
  pendingView.originalInstructionCid === Some firstCid
  pendingView.status === V1.TransferPendingInternalWorkflow with
    pendingActions = Map.fromList [(bob, "withdraw substitution"), (charlie, "accept substitution")]

  options <- targetDisclosures alice targetCid
  GovernanceLockSubstitution_AcceptResult_Complete newLockCid (Some remainderCid) _ <-
    expectSuccess $ acceptGovernanceSubstitutionRaw env options (fromInterfaceContractId pendingCid) [charlie]
  checkLockedHolding bob newLockCid 20000.0
  checkLockedHolding alice remainderCid 30000.0
  WalletClientV2.checkUnlockedBalance alice instrId 20000.0

testSubstitutionV1_vestingTarget : Script ()
testSubstitutionV1_vestingTarget = do
  env@TestEnv{..} <- setupTest
  let registry = registriesEnv.amuletV2
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  AmuletRegistryV2.tapFaucet registry alice 49000.0
  AmuletRegistryV2.tapFaucet registry bob 20000.0
  lockCid <- governanceLockRawChoice registry alice 50000.0 kind
  unlockAt <- (`addRelTime` hours 1) <$> getTime
  (Some vestingCid, None, None) <- governanceUnlockRawChoice registry lockCid 50000.0 unlockAt [alice]
  Some vestingLock <- queryContractId alice vestingCid
  let newSpec = VestingLockSpecification with kind; vestingControllers = ControllerSpecification [[bob]]

  result <- expectSuccess $ createSubstitutionRaw env bob
    (AS_Vesting with
      vestingLockKey = VestingLockKey with
        dso = instrId.admin
        owner = alice
        specification = vestingLock.specification
        vestingPeriod = vestingLock.vestingPeriod
        endTime = vestingLock.endTime
      vestingSpecification = newSpec)
    20000.0
  let substitutionCid = asTransferInstruction result.proposal
  Some allocationView <- queryInterfaceContractId bob result.proposal
  Some transferView <- queryInterfaceContractId bob substitutionCid
  expectTransferMatchesAllocation alice allocationView transferView

  options <- targetDisclosures alice vestingCid
  [unlockedAmulet] <- expectTransferCompleted =<< expectSuccess (acceptSubstitutionV1 env options substitutionCid alice)
  WalletClientV2.checkHolding alice (coerceContractId unlockedAmulet) 20000.0
  [(_, newLock)] <- query @VestingLock bob
  newLock.owner === bob
  newLock.vestingAmount === 20000.0
  newLock.vestingPeriod === vestingLock.vestingPeriod
  newLock.endTime === vestingLock.endTime
  newLock.specification === newSpec
  WalletClientV2.checkUnlockedBalance alice instrId 20000.0

-- | Passing the `transfer` of the TSv1 view of a proposal to `TransferFactory_Transfer`, with
-- `lockManagerParty` as the receiver, proposes the same substitution.
testSubstitutionV1_transferFactoryRoundTrip : Script ()
testSubstitutionV1_transferFactoryRoundTrip = do
  (TestEnv{..}, _, _, _, substitutionCid) <- setupRawSubstitution
  let registry = registriesEnv.amuletV2
  AmuletRegistryV2.tapFaucet registry bob 20000.0
  Some transferView <- queryInterfaceContractId bob (asTransferInstruction substitutionCid)
  Some substitution <- queryContractId bob (fromInterfaceContractId @GovernanceLockSubstitution substitutionCid)

  now <- getTime
  inputHoldingCids <- WalletClientV2.listUnlockedHoldingCidsFor (basicAccount bob) bob instrId
  (rulesCid, disc) <- AmuletRegistryV2.getExtAmuletRulesWithDisclosures registry
  result <- expectSuccess $ submitWithTransferContext registry (actAs bob <> discloseMany' disc) \context ->
    exerciseCmd (toInterfaceContractId @V1.TransferFactory rulesCid) V1.TransferFactory_Transfer with
      expectedAdmin = instrId.admin
      transfer = transferView.transfer with
        receiver = lockManagerParty
        requestedAt = now
        inputHoldingCids = map downcast inputHoldingCids
      extraArgs = emptyExtraArgs with context
  newCid <- expectTransferPending result

  Some newView <- queryInterfaceContractId bob newCid
  newView.transfer.meta === transferView.transfer.meta
  newView.transfer.receiver === alice
  newView.transfer.amount === transferView.transfer.amount
  Some newSubstitution <- queryContractId bob (fromInterfaceContractId @GovernanceLockSubstitution newCid)
  newSubstitution.target === substitution.target
  newSubstitution.newLockSpecification === substitution.newLockSpecification
