-- | Upper bounds on the length of `Text` values that the Splice apps store.
--
-- The limits are chosen with ample headroom over the longest values that the Splice apps produce.
-- Limits on values that the Splice apps index are low enough that their UTF-8 encoding,
-- of at most four bytes per character, stays below the size limit of Postgres index entries.
-- Values that need a larger limit are restricted to ASCII characters.
module Splice.TextLimits
(
  maxIdentifierLength,
  maxTrackingIdLength,
  maxSvOnboardingTokenLength,

  requireMaxLength,
  requireSvOnboardingTokenCharacters,

  textTooLongFailure,
  invalidTokenCharactersFailure,
) where

import DA.Fail
import DA.Text qualified as Text
import DA.TextMap qualified as TextMap

-- | Maximum length of names and identifiers, e.g., ANS entry names and SV names.
maxIdentifierLength : Int
maxIdentifierLength = 255

-- | Maximum length of the tracking ids that clients choose to deduplicate requests.
-- Inherited from the existing limit of `TransferOffer.trackingId`, which cannot be lowered
-- without making existing transfer offers unusable.
maxTrackingIdLength : Int
maxTrackingIdLength = 279

-- | Maximum length of the signed token with which an SV candidate requests to be onboarded.
-- The token is a JWT, whose characters `requireSvOnboardingTokenCharacters` restricts to ASCII.
-- It contains the candidate's SV name, party, participant id and public key, and the DSO party,
-- which take at most 1822 characters with all of them at their maximum length.
maxSvOnboardingTokenLength : Int
maxSvOnboardingTokenLength = 1900

-- | Require that the `Text` value named `name` is at most `maxLength` characters long.
-- Fails with `textTooLongFailure` otherwise.
requireMaxLength : Text -> Int -> Text -> Update ()
requireMaxLength name maxLength value =
  if Text.length value <= maxLength
    then pure ()
    else failWithStatus $ textTooLongFailure name maxLength (Text.length value)

-- | Require that the SV onboarding token `token` only consists of the characters of a JWT:
-- the base64url alphabet `A-Z`, `a-z`, `0-9`, `-`, `_`, and the separator `.`.
-- Fails with `invalidTokenCharactersFailure` otherwise.
requireSvOnboardingTokenCharacters : Text -> Update ()
requireSvOnboardingTokenCharacters token =
  if all isJwtCodePoint (Text.toCodePoints token)
    then pure ()
    else failWithStatus invalidTokenCharactersFailure

-- | The failure reported if the `Text` value named `name` is `actualLength` characters long,
-- which exceeds `maxLength`.
textTooLongFailure : Text -> Int -> Int -> FailureStatus
textTooLongFailure name maxLength actualLength = FailureStatus with
  errorId = "splice.lfdecentralizedtrust.org/text-too-long"
  category = InvalidIndependentOfSystemState
  message = name <> " must be at most " <> show maxLength <> " characters long, but has length " <> show actualLength
  meta = TextMap.fromList
    [ ("field", name)
    , ("maxLength", show maxLength)
    , ("actualLength", show actualLength)
    ]

-- | The failure reported if an SV onboarding token contains characters that a JWT does not contain.
invalidTokenCharactersFailure : FailureStatus
invalidTokenCharactersFailure = FailureStatus with
  errorId = "splice.lfdecentralizedtrust.org/invalid-token-characters"
  category = InvalidIndependentOfSystemState
  message = "token must only contain the characters A-Z, a-z, 0-9, '-', '_' and '.'"
  meta = TextMap.empty

isJwtCodePoint : Int -> Bool
isJwtCodePoint c =
  (c >= 0x41 && c <= 0x5A) || -- A-Z
  (c >= 0x61 && c <= 0x7A) || -- a-z
  (c >= 0x30 && c <= 0x39) || -- 0-9
  c == 0x2D || -- '-'
  c == 0x5F || -- '_'
  c == 0x2E    -- '.'
