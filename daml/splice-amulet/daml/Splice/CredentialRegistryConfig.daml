-- | Voted free period and extension price for the Canton credential registry.
-- The registry factory stays in place. A vote recreates this contract.
module Splice.CredentialRegistryConfig where

import DA.Time

import Splice.Api.Token.MetadataV1 (ChoiceContext)

import Splice.Amulet.TokenApiUtils (getFromContextU)
import Splice.Types
import Splice.Util

data CredentialRegistryConfig_SetConfigResult = CredentialRegistryConfig_SetConfigResult with
    newCredentialRegistryConfig : ContractId CredentialRegistryConfig
  deriving (Serializable)

-- | Free period and yearly extension price for one DSO credential registry.
-- `extensionUsdPerYear` stays positive because the extension formula divides by it.
template CredentialRegistryConfig
  with
    dso : Party
    freePeriod : RelTime
    extensionUsdPerYear : Decimal
  where
    signatory dso
    ensure freePeriod >= days 0 && extensionUsdPerYear > 0.0

    -- | Replace this config. The caller is the DSO, after an accepted vote.
    choice CredentialRegistryConfig_SetConfig : CredentialRegistryConfig_SetConfigResult
      with
        newFreePeriod : RelTime
        newExtensionUsdPerYear : Decimal
      controller dso
      do
        newCredentialRegistryConfig <- create this with
          freePeriod = newFreePeriod
          extensionUsdPerYear = newExtensionUsdPerYear
        return CredentialRegistryConfig_SetConfigResult with ..

instance HasCheckedFetch CredentialRegistryConfig ForDso where
  contractGroupId CredentialRegistryConfig {..} = ForDso with
    dso = dso

-- | Context key carrying the CredentialRegistryConfig to use.
credentialRegistryConfigContextKey : Text
credentialRegistryConfigContextKey = "credential-registry-config"

-- | Fetch the config named in the choice context and require its dso.
getCredentialRegistryConfigFromChoiceContext
  : Party
  -> ChoiceContext
  -> Update CredentialRegistryConfig
getCredentialRegistryConfigFromChoiceContext dso context = do
  cid <- getFromContextU @(ContractId CredentialRegistryConfig) context credentialRegistryConfigContextKey
  fetchChecked (ForDso with dso) cid
