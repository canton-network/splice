import Splice.Api.Credential.RegistryPublicationV1 qualified as PublicationV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.MetadataV1 (ChoiceContext, emptyMetadata)
import Splice.Api.Token.TransferInstructionV1 qualified as TransferV1
import Splice.TokenStandard.Utils (
  archiveAndCheckActors,
  ensureNoAccountMeta,
  )

import Splice.AmuletConfig (CredentialRegistryConfig)
import Splice.AmuletRules (
  AmuletRules(..),
  ExternalPartyTransferContext(..),
  BurnRewardPolicy(SkipValidatorRewardCoupon),
  getExternalPartyConfigStateFromChoiceContext,
  splitAndBurn',
  summarizeAndValidateExternalPartyContext,
  )
import Splice.Amulet.TokenApiUtils
import Splice.Amulet.TwoStepTransfer (holdingToTransferInputs)
import Splice.ExternalPartyConfigState
