-- | The built-in Amulet Credential Registry.
module Splice.Credentials (
  -- * Templates and choices
  CredentialRecord(..),
  Credential_Expire(..),

  -- * Registry operations
  updateCredentials,

  -- * Paying for a longer expiry
  expiryPaidByMetaKey,
  expiryFundingContextKey,
) where

import DA.Assert
import DA.Foldable (forA_)
import DA.List (unique)
import DA.Optional (fromOptional, optionalToList)
import DA.Text qualified as T
import DA.TextMap qualified as TextMap
import DA.Time

import Splice.Api.Credential.RecordV1 qualified as RecordV1
import Splice.Api.Credential.RegistryPublicationV1 qualified as PublicationV1
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.TokenStandard.Utils (
  archiveAndCheckActors,
  checkActors,
  isGreaterOrEqualR,
  require',
  requireMatchExpected,
  )

import Splice.AmuletConfig (credentialRegistryExtensionUsdPerYear, credentialRegistryFreePeriod)
import Splice.AmuletRules (
  ExternalPartyTransferContext(..),
  BurnRewardPolicy(SkipValidatorRewardCoupon),
  getExternalPartyConfigStateFromChoiceContext,
  splitAndBurn',
  summarizeAndValidateExternalPartyContext,
  )
import Splice.Amulet.TokenApiUtils
import Splice.Amulet.TwoStepTransfer (holdingToTransferInputs)
import Splice.Fees (relTimeToDays)
import Splice.Types
import Splice.Util


-- | Archive the previous records and create the new ones.
--
-- A new record expires at `CredentialParams.expiresAt` when that is set, and otherwise
-- at `requestedAt + freePeriod`, or at `validUntil` when that is sooner.
-- The lease beyond `requestedAt + freePeriod` is paid by burning Amulet: the paying party
-- is named in `expiryPaidByMetaKey`, executes the update together with the holder and the issuer,
-- and provides its holdings in `expiryFundingContextKey`.
-- Every new record gets the free period from `requestedAt`. Only the paid part of the lease that
-- the archived records still have is credited against the fee, so free periods do not add up.
updateCredentials
  : Party
  -> PublicationV1.CredentialFactory_UpdateCredentials
  -> Update PublicationV1.CredentialFactory_UpdateCredentialsResult
updateCredentials dso arg = do
  assertInPast24Hours "requestedAt" arg.requestedAt
  requireMatchExpected ("admin", arg.admin) dso
  optPayer <- case TextMap.lookup expiryPaidByMetaKey arg.extraArgs.meta.values of
    None -> pure None
    Some payerText -> case partyFromText payerText of
      None -> fail ("invalid party in " <> expiryPaidByMetaKey <> ": " <> payerText)
      Some payer -> pure (Some payer)
  checkActors arg.actors [[arg.holder, arg.issuer] <> optionalToList optPayer]
  optFundingCids <- lookupFromContextU @[ContractId HoldingV1.Holding] arg.extraArgs.context expiryFundingContextKey

  -- archive old credential records, keeping their lease for the credit below
  oldLeases <- forA arg.oldCredentials \oldCredentialCid -> do
    let credentialCid = fromInterfaceContractId @CredentialRecord oldCredentialCid
    oldCredential <- fetchAndArchive (ForOwner with dso; owner = arg.holder) credentialCid
    requireMatchExpected ("issuer", oldCredential.issuer) arg.issuer
    -- an earlier requestedAt would inflate the credit of the remaining lease
    require' ("requestedAt", arg.requestedAt) isGreaterOrEqualR
      ("createdAt of an archived record", oldCredential.createdAt)
    pure (oldCredential.createdAt, oldCredential.expiresAt)

  -- Only new records need the registry config, so an archive-only update works without it.
  (cids, resultMeta) <- if null arg.newCredentials
    then pure ([], emptyMetadata)
    else do
      (configStateCid, configState) <- getExternalPartyConfigStateFromChoiceContext dso arg.extraArgs.context
      let freePeriod = credentialRegistryFreePeriod configState.credentialRegistryConfig
          freeUntil = addRelTime arg.requestedAt freePeriod
          expiresAtOf params = case params.expiresAt of
            None -> optional freeUntil (min freeUntil) params.validUntil
            Some expiresAt -> expiresAt
          expiries = map expiresAtOf arg.newCredentials
          -- lease lengths in days at full precision
          daysAfter start end = relTimeToDays (max (seconds 0) (subTime end start))
          -- each new record gets its own free period; of the archived records only the paid lease
          -- that is left, after their own free period and after requestedAt, is credited.
          -- Their free period is the current one: a record does not store the free period it was
          -- created with, so a change of freePeriod by vote between creation and renewal shifts
          -- the credit slightly.
          leaseToPay = sum (map (daysAfter freeUntil) expiries)
          paidLeaseLeft (createdAt, expiresAt) =
            daysAfter (max arg.requestedAt (addRelTime createdAt freePeriod)) expiresAt
          remainingPaidLease = sum (map paidLeaseLeft oldLeases)
          paidDays = max 0.0 (leaseToPay - remainingPaidLease)
          feeUsd = paidDays / credentialYearDays * credentialRegistryExtensionUsdPerYear configState.credentialRegistryConfig
      forA_ expiries (assertWithinDeadline "expiresAt")

      burnMeta <- if feeUsd == 0.0
        then pure emptyMetadata
        else do
          payer <- case optPayer of
            None -> fail ("an expiry beyond the free period needs " <> expiryPaidByMetaKey)
            Some payer -> pure payer
          let fundingCids = fromOptional [] optFundingCids
          csum <- summarizeAndValidateExternalPartyContext
            (ExternalPartyTransferContext with
              externalPartyConfigState = configStateCid
              featuredAppRight = None)
            dso
            payer
          inputs <- holdingToTransferInputs (ForOwner with dso; owner = payer) fundingCids
          -- the payer's change contract-id is not returned, as it is not part of the credential standard result
          (_, burnMeta) <- splitAndBurn'
            (toInterfaceContractId configStateCid)
            csum
            payer
            (feeUsd / configState.amuletPrice)
            inputs
            "credential expiry"
            SkipValidatorRewardCoupon
          pure burnMeta

      -- one record per credential, in the order of the arguments
      cids <- forA (zip arg.newCredentials expiries) \(params, expiresAt) ->
        toInterfaceContractId <$> create CredentialRecord with
          dso
          issuer = arg.issuer
          holder = arg.holder
          claims = params.claims
          validFrom = params.validFrom
          validUntil = params.validUntil
          createdAt = arg.requestedAt
          expiresAt
      pure (cids, burnMeta)

  pure PublicationV1.CredentialFactory_UpdateCredentialsResult with
    newCredentials = cids
    meta = resultMeta

-- | A credential record visible to the DSO party and served by Scan.
template CredentialRecord
  with
    dso : Party
      -- ^ The DSO party that administers this credential registry.
    issuer : Party
      -- ^ The party that issued the credential.
    holder : Party
      -- ^ The party that holds the credential.
    claims : [RecordV1.Claim]
      -- ^ The claims of the credential.
    validFrom : Optional Time
      -- ^ The time from which this credential is valid.
    validUntil : Optional Time
      -- ^ The time until which this credential is valid.
    createdAt : Time
      -- ^ The time at which this credential record was created.
    expiresAt : Time
      -- ^ The time at which this credential record expires in the registry.
      -- Separate from `validUntil`: this is the registry lease, not the credential's own validity.
  where
    ensure validCredentialRecord this

    signatory dso
    signatory issuer, holder

    interface instance RecordV1.Credential for CredentialRecord where
      view = RecordV1.CredentialView with
        admin = dso
        issuer
        holder
        claims
        validFrom
        validUntil
        createdAt = Some createdAt
        expiresAt = Some expiresAt
        -- holder and issuer can each revoke on their own
        revokableBy = [[holder], [issuer]]
        meta = emptyMetadata

      credential_getImpl _self _arg = pure (view (toInterface @RecordV1.Credential this))

      credential_revokeImpl cid arg = do
        let archivedCredential = view (toInterface @RecordV1.Credential this)
        archiveAndCheckActors cid arg.actors archivedCredential.revokableBy
        pure RecordV1.Credential_RevokeResult with
          archivedCredential
          meta = emptyMetadata

    choice Credential_Expire : ()
      with
        actor : Party
      controller actor
      do
        require "actor is stakeholder" $
          actor == holder || actor == issuer ||
          actor == dso
        assertDeadlineExceeded "expiresAt" expiresAt

-- Credential record validation
-------------------------------

-- | Credential record validation to ensure that the credentials are not too large and
-- can be efficiently indexed and processed by the Scan service.
-- It also checks the registry lease: `expiresAt` is set by the registry, not by the caller.
--
-- No content-level validation is performed, as that is application-specific and would
-- bind the registry to specific use cases.
validCredentialRecord : CredentialRecord -> Bool
validCredentialRecord record =
  -- at most 32 claims per credential to constrain indexing overhead
  Prelude.length record.claims <= 32 &&
  all validClaim record.claims &&
  -- Two unset subjects are the same subject: both mean the holder.
  -- Some (partyToText holder) is already rejected by validSubjectText.
  unique (map (\claim -> (claim.subject, claim.property)) record.claims) &&
  -- validFrom may be earlier than createdAt.
  -- If validUntil is set, it is later than createdAt, and later than validFrom when that is set.
  optional True
    (\until -> record.createdAt < until && optional True (< until) record.validFrom)
    record.validUntil &&
  -- The registry lease is later than createdAt, and never later than validUntil when that is set.
  record.createdAt < record.expiresAt &&
  optional True (record.expiresAt <=) record.validUntil
  where
    validClaim claim =
      T.length claim.property <= 255 &&
      all validPropertyCodepoint (T.toCodePoints claim.property) &&
      optional True validSubjectText claim.subject &&
      T.length claim.value < 4097

    -- None means the subject is the holder.
    -- Some must be non-empty and must not be `partyToText holder`.
    -- It does not have to be a party id.
    validSubjectText subject =
      T.isNotEmpty subject &&
      subject /= partyToText record.holder &&
      T.length subject <= 255 &&
      all validSubjectCodepoint (T.toCodePoints subject)

    validPropertyCodepoint codepoint =
      -- Daml has no regex support, so the character class is spelled out.
         (codepoint >= 0x30 && codepoint <= 0x39) -- '0' - '9'
      || (codepoint >= 0x41 && codepoint <= 0x5A) -- 'A' - 'Z'
      || (codepoint >= 0x61 && codepoint <= 0x7A) -- 'a' - 'z'
      || codepoint == 0x2E                        -- '.'
      || codepoint == 0x5F                        -- '_'
      || codepoint == 0x3A                        -- ':'
      || codepoint == 0x2D                        -- '-'
      || codepoint == 0x2F                        -- '/'

    -- Characters matching `[a-zA-Z0-9 ._~:/?#\[\]@!$&'()*+,;=%-]`:
    -- the URI characters of RFC 3986, plus ' ', which is allowed in party names.
    validSubjectCodepoint codepoint =
      codepoint == 0x20 ||
      validPropertyCodepoint codepoint ||
      codepoint `elem` T.toCodePoints "~?#[]@!$&'()*+,;=%"


-- Paying for a longer expiry
------------------------------

-- | Prefix of the metadata and context keys defined by the credential CIP.
-- FIXME: put the CIP number here.
credentialCipPrefix : Text
credentialCipPrefix = "FIXME/"

-- | Metadata key in `extraArgs.meta` naming the party that pays for an expiry beyond the free period.
-- The party must be one of the actors, and may differ from the holder and the issuer.
expiryPaidByMetaKey : Text
expiryPaidByMetaKey = credentialCipPrefix <> "extended-expiry-paid-by"

-- | Context key in `extraArgs.context` with the paying party's Amulet holdings.
expiryFundingContextKey : Text
expiryFundingContextKey = credentialCipPrefix <> "extended-expiry-funding"

-- | One year, in days, used only to turn a USD price per year into a fee.
credentialYearDays : Decimal
credentialYearDays = 365.0

-- checked fetches
------------------

instance HasCheckedFetch CredentialRecord ForOwner where
  contractGroupId CredentialRecord{..} = ForOwner with dso; owner = holder

instance HasCheckedFetch CredentialRecord ForDso where
  contractGroupId CredentialRecord{..} = ForDso with dso
