module Splice.Amulet.SvRightOwner where

import Prelude hiding (all, sum)

import DA.Foldable (forA_, all, sum)
import DA.Map (Map)
import qualified DA.Map as Map
import DA.TextMap (TextMap)
import Splice.Types (ForDso(..))
import Splice.Util (HasCheckedFetch(..), Patchable(..), patchScalar, require)

data SvRightsOwnerKey = SvRightsOwnerKey with
    dso : Party
    name : Text
  deriving (Eq, Show, Serializable)

-- | An SV right owner, i.e., an entity that owns SV rights and thereby earns SV rewards.
--
-- SV right owners are hosted by an SV node operator, which mints their rewards on their
-- behalf. Multiple SV right owners can be hosted by the same SV node operator, and an SV
-- node operator is not required to be an SV right owner itself.
template SvRightOwner
  with
    dso : Party
    name : Text -- ^ Human-readable name; unique among all SV right owners.
    info : SvRightOwnerInfo
  where
    signatory dso
    ensure validSvRightOwnerInfo info
    key ( SvRightsOwnerKey with dso; name ) : SvRightsOwnerKey
    maintainer key.dso

instance HasCheckedFetch SvRightOwner ForDso where
  contractGroupId SvRightOwner{dso} = ForDso with dso

-- | Information about a super validator right owner.
data SvRightOwnerInfo = SvRightOwnerInfo
  with
    rightOwnerParty : Party
      -- ^ The party of the SV right owner; manages the SV right owner controlled information.
    description : Text
    svNodeAssignments : TextMap SvNodeAssignment
      -- ^ Keyed by the name of the SV node through which rewards are minted.
  deriving (Eq, Show, Serializable)

instance Patchable SvRightOwnerInfo where
  patch new base current = SvRightOwnerInfo
    with
      rightOwnerParty = patch new.rightOwnerParty base.rightOwnerParty current.rightOwnerParty
      description = patch new.description base.description current.description
      svNodeAssignments = patch new.svNodeAssignments base.svNodeAssignments current.svNodeAssignments

data SvNodeAssignment = SvNodeAssignment
  with
    rewardWeight : Int
      -- ^ The weight of the SV rights owner at this SV node.
    escrowedRewardWeight : Int
      -- ^ The weight held in escrow; minted as one coupon to `escrowParty`, which is not claimed and expires into the unclaimed rewards. Changed only by a vote.
    escrowParty : Party
      -- ^ Receives the coupon for the escrowed weight, e.g., today's ghost party of the owner. Changed only by a vote.
    beneficiaries : Map Party BeneficiaryInfo
      -- ^ Map of beneficiaries and their percentages of `rewardWeight`.
      -- At most 20 beneficiaries are allowed to bound the number of coupons minted per round.
    defaultBeneficiary : Party
      -- ^ Receives the weight not paid to the beneficiaries.
  deriving (Eq, Show, Serializable)

instance Patchable SvNodeAssignment where
  patch new base current = SvNodeAssignment
    with
      rewardWeight = patch new.rewardWeight base.rewardWeight current.rewardWeight
      escrowedRewardWeight = patch new.escrowedRewardWeight base.escrowedRewardWeight current.escrowedRewardWeight
      escrowParty = patch new.escrowParty base.escrowParty current.escrowParty
      beneficiaries = patch new.beneficiaries base.beneficiaries current.beneficiaries
      defaultBeneficiary = patch new.defaultBeneficiary base.defaultBeneficiary current.defaultBeneficiary

-- | Information about a beneficiary.
data BeneficiaryInfo = BeneficiaryInfo
  with
    rewardRatio : Decimal
      -- ^ The proportion of the reward weight of the SV node assignment that is shared with this beneficiary. It should be >0.0 and <=1.0
  deriving (Eq, Show, Serializable)

instance Patchable BeneficiaryInfo where
  patch new base current = BeneficiaryInfo
    with
      rewardRatio = patchScalar new.rewardRatio base.rewardRatio current.rewardRatio

svRightOwnerInfoChecks : [(SvRightOwnerInfo -> Bool, Text)]
svRightOwnerInfoChecks =
  map (\(check, message) -> (all check . (.svNodeAssignments), message)) svNodeAssignmentChecks

svNodeAssignmentChecks : [(SvNodeAssignment -> Bool, Text)]
svNodeAssignmentChecks =
  [ (\SvNodeAssignment{..} -> rewardWeight >= 0, "SV right owner's reward weight is non-negative")
  , (\SvNodeAssignment{..} -> all ((> 0.0) . rewardRatio) beneficiaries, "Beneficiary reward ratios are positive")
  , (\SvNodeAssignment{..} -> sum (fmap (.rewardRatio) beneficiaries) <= 1.0, "Beneficiary reward ratios add up to at most 1.0")
  , (\SvNodeAssignment{..} -> Map.size beneficiaries <= 20, "There are at most 20 beneficiaries")
  ]

validSvRightOwnerInfo : SvRightOwnerInfo -> Bool
validSvRightOwnerInfo info = all (\(check, _) -> check info) svRightOwnerInfoChecks

requireValidSvRightOwnerInfo : SvRightOwnerInfo -> Update ()
requireValidSvRightOwnerInfo info =
  forA_ svRightOwnerInfoChecks $ \(check, message) -> require message (check info)

-- | The absolute reward weight for each party that receives rewards in the context of this SV node assignment.
svRewardCouponWeights : SvNodeAssignment -> Map Party Int
svRewardCouponWeights SvNodeAssignment{..} =
  Map.insertWith (+) defaultBeneficiary remainingWeight beneficiaryWeights
  where
    remainingWeight = rewardWeight - sum beneficiaryWeights
    beneficiaryWeights = fmap (\BeneficiaryInfo{rewardRatio} -> floor (intToDecimal rewardWeight * rewardRatio)) beneficiaries
