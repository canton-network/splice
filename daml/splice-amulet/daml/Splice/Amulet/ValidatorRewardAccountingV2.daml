-- | Validator-reward accounting based on off-ledger calculations (CIP-0120).
-- Only 'CalculateValidatorRewardsV2' remains here; the processing pipeline
-- runs through the collapsed 'ProcessRewardsV2' template in
-- 'Splice.Amulet.RewardAccountingV2'.
module Splice.Amulet.ValidatorRewardAccountingV2 where

import DA.Time

import Splice.Types
import Splice.Util

-- | State contract tracking the need to calculate and confirm the validator
-- reward amounts for the given round.
template CalculateValidatorRewardsV2 with
    dso : Party
    round : Round
    roundClosedAt : Time
      -- ^ The time at which the round was closed. Equal to the creation time
      -- of this contract. Stored for debugging and metrics.
    rewardCouponTimeToLive : RelTime
      -- ^ Copied from the AmuletConfig at round-open time so the value can't drift
      -- if the config changes while processing is in flight.
    dryRun : Bool
      -- ^ Whether to only simulate the confirmation without creating any
      -- ValidatorRewardCouponV2 contracts.
  where
    signatory dso


-- instances

instance HasCheckedFetch CalculateValidatorRewardsV2 ForDso where
  contractGroupId CalculateValidatorRewardsV2 with .. = ForDso with ..
