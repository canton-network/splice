-- | Types and contracts for managing synchronizer fees
module Splice.DecentralizedSynchronizer where

import DA.Action (foldlA)
import qualified DA.Set as Set
import DA.Text as T
import qualified DA.TextMap as TextMap
import DA.Time

import Splice.Types
import Splice.Util


-- Decentralized synchronizer configuration
-------------------------------

-- | The configuration of the logical concept of a decentralized synchronizer, which consists over its lifetime
-- of a series of actual synchronizers, which are introduced for handling the (rare) occasions of switching
-- to a new synchronizer protocol version.
data AmuletDecentralizedSynchronizerConfig = AmuletDecentralizedSynchronizerConfig with
    requiredSynchronizers : Set.Set Text -- ^ The synchronizer-ids of all synchronizers that Amulet and ANS users should be connected to.
    activeSynchronizer : Text -- ^ The synchronizer-id of the synchronizer on which the SVs accepts transactions involving the
                        -- AmuletRules and related contracts, which must be one of the `requiredSynchronizers`.
    fees : SynchronizerFeesConfig -- ^ The fees charged for using the decentralized synchronizer. We use the same fees across all active decentralized synchronizers.
  deriving (Eq, Show, Serializable)

-- | The limits defining the free base rate delivered by the synchronizer.
-- It defines the base rate as allowing at most burstAmount of sequencing traffic within a window of burstWindow seconds.
data BaseRateTrafficLimits = BaseRateTrafficLimits with
    burstAmount: Int -- ^ The total burstAmount in bytes of sequencing traffic delivered over the burstWindow
    burstWindow: RelTime -- ^ Time window within which the burstAmount must not be exceeded
  deriving (Eq, Show, Serializable)

-- | Synchronizer fees related configuration to be tracked on the DsoRules contract
data SynchronizerFeesConfig = SynchronizerFeesConfig with
    baseRateTrafficLimits: BaseRateTrafficLimits -- ^ Configuration limits for base rate traffic
    extraTrafficPrice: Decimal -- ^ The price of extra traffic denominated in $/MB
    readVsWriteScalingFactor: Int -- ^ How much the sending of a message to its recipient costs in terms of bytes written to the synchronizer.
    -- This factor is specified in parts per 10,000 (or per 10 mille)
    -- We charge for sending messages depending on the number of recipients,
    -- as delivering the message incurs a cost as well, albeit usually a much
    -- smaller one than the cost of a write.
    minTopupAmount: Int -- ^ The minimum amount of extra traffic (in bytes) that must be bought when buying extra traffic.
    -- This ensures that the SVs can amortize the cost of executing that transaction.
  deriving (Eq, Show, Serializable)


validAmuletDecentralizedSynchronizerConfig : AmuletDecentralizedSynchronizerConfig -> Bool
validAmuletDecentralizedSynchronizerConfig config =
  config.activeSynchronizer `Set.member` config.requiredSynchronizers


-- Per sequencer member synchronizer traffic tracking
------------------------------------------------

-- | The state of the extra synchronizer traffic purchases of a sequencer sv.
template MemberTraffic with
    dso : Party
    memberId : Text -- ^ The id of the sequencer member (participant or mediator) for which traffic has been purchased
    synchronizerId : Text -- ^ The id of the synchronizer for which this contract tracks purchased extra traffic
    migrationId : Int -- ^ The migration id of the synchronizer for which this contract tracks purchased extra traffic
    totalPurchased : Int -- ^ The number of bytes of extra traffic purchased
    numPurchases : Int -- ^ Number of times extra traffic has been purchased
    amuletSpent : Decimal -- ^ Total Amulet spent on extra traffic
    usdSpent : Decimal -- ^ Total USD spent on extra traffic
  where
    signatory dso

    ensure totalPurchased >= 0
      && numPurchases >= 0
      && amuletSpent >= 0.0
      && usdSpent >= 0.0
      && migrationId >= 0
      && not (T.isEmpty memberId)
      && not (T.isEmpty synchronizerId)


initialMemberTraffic : Party -> Text -> Text -> Int -> MemberTraffic
initialMemberTraffic dso memberId synchronizerId migrationId = MemberTraffic with
    dso
    memberId
    migrationId
    synchronizerId
    totalPurchased = 0
    numPurchases = 0
    amuletSpent = 0.0
    usdSpent = 0.0

data MemberTrafficPurchase = MemberTrafficPurchase with
    provider : Party
    memberId : Text
    synchronizerId : Text
    migrationId : Int
    trafficAmount : Int
  deriving (Eq, Show)

data TrafficPurchaseMemo = TrafficPurchaseMemo with
    memberId : Text
    synchronizerId : Text
    migrationId : Int
    forfeitValidatorRewardCoupon : Bool
  deriving (Eq, Show)

trafficPurchaseMemoPrefix : Text
trafficPurchaseMemoPrefix = "splice/memo:"

-- | Parse the purchase arguments from memo tag using url query param style:
-- `splice/memo:member-id=...&synchronizer-id=...&migration-id=...[&forfeit-validator-reward-coupon=true|false]`.
parseTrafficPurchaseMemo : Text -> Either Text TrafficPurchaseMemo
parseTrafficPurchaseMemo memo = do
  params <- case T.stripPrefix trafficPurchaseMemoPrefix memo of
    None -> Left $ "Traffic purchase memo must start with " <> trafficPurchaseMemoPrefix
    Some params -> Right params
  fields <- foldlA addField TextMap.empty (T.splitOn "&" params)
  memberId <- requiredField fields "member-id"
  synchronizerId <- requiredField fields "synchronizer-id"
  migrationId <- requiredField fields "migration-id" >>= parseIntField "migration-id"
  forfeitValidatorRewardCoupon <- case TextMap.lookup "forfeit-validator-reward-coupon" fields of
    None -> Right False
    Some value -> parseBoolField "forfeit-validator-reward-coupon" value
  pure TrafficPurchaseMemo with ..
  where
    knownKeys = ["member-id", "synchronizer-id", "migration-id", "forfeit-validator-reward-coupon"]
    addField fields field = case T.splitOn "=" field of
      [key, value]
        | not (key `elem` knownKeys) ->
            Left $ "Unknown key in traffic purchase memo: " <> key
        | TextMap.member key fields ->
            Left $ "Duplicate key in traffic purchase memo: " <> key
        | otherwise -> Right (TextMap.insert key value fields)
      _ -> Left $ "Expected key=value in traffic purchase memo, got: " <> field
    requiredField fields key = case TextMap.lookup key fields of
      None -> Left $ "Missing key in traffic purchase memo: " <> key
      Some value -> Right value
    parseIntField key value = case T.parseInt value of
      None -> Left $ "Expected an integer for " <> key <> " in traffic purchase memo, got: " <> value
      Some parsed -> Right parsed
    parseBoolField key value = case value of
      "true" -> Right True
      "false" -> Right False
      _ -> Left $ "Expected true or false for " <> key <> " in traffic purchase memo, got: " <> value

trafficPurchaseReason : MemberTrafficPurchase -> Text
trafficPurchaseReason purchase =
  "splice/memo:purchased-traffic-bytes=" <> show purchase.trafficAmount <> "&member-id=" <> purchase.memberId <>
  "&synchronizer-id=" <> purchase.synchronizerId <>
  "&migration-id=" <> show purchase.migrationId

data ForMemberTraffic = ForMemberTraffic with
    dso : Party
    memberId : Text
    synchronizerId : Text
    migrationId: Int
  deriving (Eq, Show, Serializable)

instance HasCheckedFetch MemberTraffic ForDso where
    contractGroupId MemberTraffic{..} = ForDso with ..

instance HasCheckedFetch MemberTraffic ForMemberTraffic where
    contractGroupId MemberTraffic{..} = ForMemberTraffic with ..

instance Patchable BaseRateTrafficLimits where
  patch new base current = BaseRateTrafficLimits with
    burstAmount = patch new.burstAmount base.burstAmount current.burstAmount
    burstWindow = patch new.burstWindow base.burstWindow current.burstWindow

instance Patchable SynchronizerFeesConfig where
  patch new base current = SynchronizerFeesConfig with
    baseRateTrafficLimits = patch new.baseRateTrafficLimits base.baseRateTrafficLimits current.baseRateTrafficLimits
    extraTrafficPrice = patch new.extraTrafficPrice base.extraTrafficPrice current.extraTrafficPrice
    readVsWriteScalingFactor = patch new.readVsWriteScalingFactor base.readVsWriteScalingFactor current.readVsWriteScalingFactor
    minTopupAmount = patch new.minTopupAmount base.minTopupAmount current.minTopupAmount

instance Patchable AmuletDecentralizedSynchronizerConfig where
  patch new base current = AmuletDecentralizedSynchronizerConfig with
    requiredSynchronizers = patch new.requiredSynchronizers base.requiredSynchronizers current.requiredSynchronizers
    activeSynchronizer = patch new.activeSynchronizer base.activeSynchronizer current.activeSynchronizer
    fees = patch new.fees base.fees current.fees

-- Dedicated synchronizer registry
------------------------------------------------

-- | Whether `weight` is an allowed bound for a registered synchronizer's activity weights.
-- A weight scales how much CIP-0104 activity a paid traffic byte earns. As for the other activity
-- weights, e.g., a `FeaturedAppRight`'s, only negative values are rejected: a weight above 1.0
-- lets the SVs compensate a paymaster that pays for only part of the synchronizer's traffic.
validSynchronizerActivityWeight : Decimal -> Bool
validSynchronizerActivityWeight weight = weight >= 0.0

validRegisteredSynchronizer : RegisteredSynchronizer -> Bool
validRegisteredSynchronizer RegisteredSynchronizer{..} =
  not (T.isEmpty synchronizerId)
  && validSynchronizerActivityWeight maxActivityWeight
  && validSynchronizerActivityWeight maxAssetActivityWeight

data RegisteredSynchronizer_UpdateResult = RegisteredSynchronizer_UpdateResult with
    registeredSynchronizerCid : ContractId RegisteredSynchronizer
  deriving (Serializable)

-- | A dedicated synchronizer registered by DSO governance.
--
-- A dedicated synchronizer runs the Splice software separately from the decentralized
-- synchronizer that hosts Amulet. Its `paymaster` pays for the synchronizer's traffic on the
-- decentralized synchronizer.
--
-- The registration is created, updated and archived only by an SV vote, through
-- `DsoRules_RegisterSynchronizer`, `DsoRules_UpdateSynchronizerRegistration` and
-- `DsoRules_ArchiveSynchronizerRegistration` in the governance package. It lives in splice-amulet
-- so that `AmuletRules` can fetch it: the governance package depends on splice-amulet, not the
-- reverse.
template RegisteredSynchronizer with
    dso : Party
      -- ^ The DSO party. Sole signatory.
    synchronizerId : Text
      -- ^ Id of the dedicated synchronizer. It identifies the registration and does not change on
      -- update.
    paymaster : Party
      -- ^ The party paying for the synchronizer's traffic on the decentralized synchronizer.
      -- Observes the registration, so it can read it from its own ledger.
    maxActivityWeight : Decimal
      -- ^ Highest weight with which traffic paid for this synchronizer earns CIP-0104 app
      -- activity. See `validSynchronizerActivityWeight` for the allowed range.
    maxAssetActivityWeight : Decimal
      -- ^ Highest weight with which traffic paid for this synchronizer earns CIP-0104 asset
      -- activity. See `validSynchronizerActivityWeight` for the allowed range.
  where
    signatory dso
    observer paymaster

    ensure validRegisteredSynchronizer this

    -- Replaces the governed fields. The synchronizerId is the identity of the registration and is
    -- kept.
    choice RegisteredSynchronizer_Update : RegisteredSynchronizer_UpdateResult
      with
        newPaymaster : Party
        newMaxActivityWeight : Decimal
        newMaxAssetActivityWeight : Decimal
      controller dso
      do
        registeredSynchronizerCid <- create this with
          paymaster = newPaymaster
          maxActivityWeight = newMaxActivityWeight
          maxAssetActivityWeight = newMaxAssetActivityWeight
        pure RegisteredSynchronizer_UpdateResult with registeredSynchronizerCid

instance HasCheckedFetch RegisteredSynchronizer ForDso where
    contractGroupId RegisteredSynchronizer{..} = ForDso with ..
