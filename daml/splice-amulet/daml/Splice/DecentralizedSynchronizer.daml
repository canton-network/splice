-- | Types and contracts for managing synchronizer fees
module Splice.DecentralizedSynchronizer where

import DA.Optional (optionalToList)
import qualified DA.Set as Set
import DA.Text as T
import DA.Time

import Splice.Types
import Splice.Util


-- Decentralized synchronizer configuration
-------------------------------

-- | The configuration of the logical concept of a decentralized synchronizer, which consists over its lifetime
-- of a series of actual synchronizers, which are introduced for handling the (rare) occasions of switching
-- to a new synchronizer protocol version.
data AmuletDecentralizedSynchronizerConfig = AmuletDecentralizedSynchronizerConfig with
    requiredSynchronizers : Set.Set Text -- ^ The synchronizer-ids of all synchronizers that Amulet and ANS users should be connected to.
    activeSynchronizer : Text -- ^ The synchronizer-id of the synchronizer on which the SVs accepts transactions involving the
                        -- AmuletRules and related contracts, which must be one of the `requiredSynchronizers`.
    fees : SynchronizerFeesConfig -- ^ The fees charged for using the decentralized synchronizer. We use the same fees across all active decentralized synchronizers.
  deriving (Eq, Show, Serializable)

-- | The limits defining the free base rate delivered by the synchronizer.
-- It defines the base rate as allowing at most burstAmount of sequencing traffic within a window of burstWindow seconds.
data BaseRateTrafficLimits = BaseRateTrafficLimits with
    burstAmount: Int -- ^ The total burstAmount in bytes of sequencing traffic delivered over the burstWindow
    burstWindow: RelTime -- ^ Time window within which the burstAmount must not be exceeded
  deriving (Eq, Show, Serializable)

-- | Synchronizer fees related configuration to be tracked on the DsoRules contract
data SynchronizerFeesConfig = SynchronizerFeesConfig with
    baseRateTrafficLimits: BaseRateTrafficLimits -- ^ Configuration limits for base rate traffic
    extraTrafficPrice: Decimal -- ^ The price of extra traffic denominated in $/MB
    readVsWriteScalingFactor: Int -- ^ How much the sending of a message to its recipient costs in terms of bytes written to the synchronizer.
    -- This factor is specified in parts per 10,000 (or per 10 mille)
    -- We charge for sending messages depending on the number of recipients,
    -- as delivering the message incurs a cost as well, albeit usually a much
    -- smaller one than the cost of a write.
    minTopupAmount: Int -- ^ The minimum amount of extra traffic (in bytes) that must be bought when buying extra traffic.
    -- This ensures that the SVs can amortize the cost of executing that transaction.
  deriving (Eq, Show, Serializable)


validAmuletDecentralizedSynchronizerConfig : AmuletDecentralizedSynchronizerConfig -> Bool
validAmuletDecentralizedSynchronizerConfig config =
  config.activeSynchronizer `Set.member` config.requiredSynchronizers


-- Per sequencer member synchronizer traffic tracking
------------------------------------------------

-- | The state of the extra synchronizer traffic purchases of a sequencer sv.
template MemberTraffic with
    dso : Party
    memberId : Text -- ^ The id of the sequencer member (participant or mediator) for which traffic has been purchased
    synchronizerId : Text -- ^ The id of the synchronizer for which this contract tracks purchased extra traffic
    migrationId : Int -- ^ The migration id of the synchronizer for which this contract tracks purchased extra traffic
    totalPurchased : Int -- ^ The number of bytes of extra traffic purchased
    numPurchases : Int -- ^ Number of times extra traffic has been purchased
    amuletSpent : Decimal -- ^ Total Amulet spent on extra traffic
    usdSpent : Decimal -- ^ Total USD spent on extra traffic
    operator : Optional Party
      -- ^ For traffic purchased for a governance-registered synchronizer (see
      -- `RegisteredSynchronizer`): its operator, made an observer of this contract so the
      -- operator's node can ingest the purchase on-ledger. `None` for traffic on the
      -- decentralized synchronizer itself.
  where
    signatory dso
    observer (optionalToList operator)

    ensure totalPurchased >= 0
      && numPurchases >= 0
      && amuletSpent >= 0.0
      && usdSpent >= 0.0
      && migrationId >= 0
      && not (T.isEmpty memberId)
      && not (T.isEmpty synchronizerId)


initialMemberTraffic : Party -> Text -> Text -> Int -> Optional Party -> MemberTraffic
initialMemberTraffic dso memberId synchronizerId migrationId operator = MemberTraffic with
    dso
    memberId
    migrationId
    synchronizerId
    totalPurchased = 0
    numPurchases = 0
    amuletSpent = 0.0
    usdSpent = 0.0
    operator

data ForMemberTraffic = ForMemberTraffic with
    dso : Party
    memberId : Text
    synchronizerId : Text
    migrationId: Int
  deriving (Eq, Show, Serializable)

instance HasCheckedFetch MemberTraffic ForDso where
    contractGroupId MemberTraffic{..} = ForDso with ..

instance HasCheckedFetch MemberTraffic ForMemberTraffic where
    contractGroupId MemberTraffic{..} = ForMemberTraffic with ..

-- Dedicated-synchronizer registration (PoC)
------------------------------------------------

defaultDiscountFactor : Decimal
defaultDiscountFactor = 1.0

-- | The registration parameters DSO governance can change by vote, as against the identity fields
--   fixed at registration. One record, so a further parameter costs no new choice or vote action.
data GovernanceParameters = GovernanceParameters with
    discountFactor : Decimal
      -- ^ Multiplies this synchronizer's traffic price.
  deriving (Show, Eq, Serializable)

-- | The parameters a synchronizer is registered with when governance has agreed no discount.
defaultGovernanceParameters : GovernanceParameters
defaultGovernanceParameters = GovernanceParameters with discountFactor = defaultDiscountFactor

-- | The multiplier a registration applies to its synchronizer's traffic price.
getDiscountFactor : RegisteredSynchronizer -> Decimal
getDiscountFactor reg = reg.governanceParameters.discountFactor

data RegisteredSynchronizer_SetGovernanceParametersResult = RegisteredSynchronizer_SetGovernanceParametersResult with
    registeredSynchronizerCid : ContractId RegisteredSynchronizer
  deriving (Show, Eq, Serializable)

-- A "dedicated synchronizer" is a synchronizer run by its own operator (stood up with the
-- Splice software), separate from the decentralized synchronizer that hosts Amulet. Its traffic
-- is funded by burning Amulet on the decentralized synchronizer. Before any Amulet can be
-- burned for such a synchronizer it is registered once, by DSO governance, via
-- `DsoRules_RegisterSynchronizer` (in the governance package), which creates this contract.
--
-- The registration binds a stable synchronizer id to the `operator` party that runs it. Two
-- consumers read it:
--   * `AmuletRules_BuyMemberTraffic` (splice-amulet) accepts a matching `RegisteredSynchronizer`
--     (via explicit disclosure) as authorization for a synchronizer id outside
--     `requiredSynchronizers`, and sets its `operator` as an observer on the `MemberTraffic`
--     it creates.
--   * the `operator` itself, which observes this contract and thus learns it is registered.
--
-- This template lives in splice-amulet (not the governance package) so that `AmuletRules` can
-- `fetch` it: the governance package depends on splice-amulet, not the reverse.
template RegisteredSynchronizer with
    dso : Party
      -- ^ The DSO party; sole signatory. Created by DSO governance (a `DsoRules` vote).
    synchronizerId : Text
      -- ^ Id of the dedicated synchronizer this registration authorizes Amulet-funded traffic for.
    operator : Party
      -- ^ The party operating the dedicated synchronizer. Observes this registration and every
      --   traffic purchase for its synchronizer (via the `operator` field on `MemberTraffic`).
    governanceParameters : GovernanceParameters
      -- ^ Set by DSO governance, stated explicitly at registration rather than defaulted, so
      --   what a synchronizer is registered with is never implied.
  where
    signatory dso
    observer operator

    ensure not (T.isEmpty synchronizerId)
        && (let f = getDiscountFactor this in f > 0.0 && f <= 1.0)

    -- Public read choice, mirroring OpenMiningRound_Fetch: lets a buyer who is neither
    -- signatory nor observer read this contract inside AmuletRules_BuyMemberTraffic
    -- when it is passed via explicit disclosure. Returns the contract unchanged.
    -- (Plain comment, not a `-- |` doc comment: damlc docs rejects a doc comment attached
    -- directly to a choice.)
    nonconsuming choice RegisteredSynchronizer_Fetch : RegisteredSynchronizer
      with
        p : Party -- the reader (buyer/provider) authorized to read this disclosed contract
      controller p
      do pure this

    choice RegisteredSynchronizer_SetGovernanceParameters : RegisteredSynchronizer_SetGovernanceParametersResult
      with
        newGovernanceParameters : GovernanceParameters
      controller dso
      do
        registeredSynchronizerCid <- create this with
          governanceParameters = newGovernanceParameters
        pure RegisteredSynchronizer_SetGovernanceParametersResult with registeredSynchronizerCid

-- Group-id check for `fetchPublicReferenceData`: a `RegisteredSynchronizer` is scoped to the
-- DSO party, so reads are validated against the expected DSO party (mirrors `MemberTraffic`).
instance HasCheckedFetch RegisteredSynchronizer ForDso where
    contractGroupId RegisteredSynchronizer{..} = ForDso with ..

instance Patchable BaseRateTrafficLimits where
  patch new base current = BaseRateTrafficLimits with
    burstAmount = patch new.burstAmount base.burstAmount current.burstAmount
    burstWindow = patch new.burstWindow base.burstWindow current.burstWindow

instance Patchable SynchronizerFeesConfig where
  patch new base current = SynchronizerFeesConfig with
    baseRateTrafficLimits = patch new.baseRateTrafficLimits base.baseRateTrafficLimits current.baseRateTrafficLimits
    extraTrafficPrice = patch new.extraTrafficPrice base.extraTrafficPrice current.extraTrafficPrice
    readVsWriteScalingFactor = patch new.readVsWriteScalingFactor base.readVsWriteScalingFactor current.readVsWriteScalingFactor
    minTopupAmount = patch new.minTopupAmount base.minTopupAmount current.minTopupAmount

instance Patchable AmuletDecentralizedSynchronizerConfig where
  patch new base current = AmuletDecentralizedSynchronizerConfig with
    requiredSynchronizers = patch new.requiredSynchronizers base.requiredSynchronizers current.requiredSynchronizers
    activeSynchronizer = patch new.activeSynchronizer base.activeSynchronizer current.activeSynchronizer
    fees = patch new.fees base.fees current.fees
