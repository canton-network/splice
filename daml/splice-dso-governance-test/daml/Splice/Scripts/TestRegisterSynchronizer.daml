-- | PoC (dedicated-synchronizer traffic): register a dedicated synchronizer via DSO governance
--   (a supermajority vote) and assert the resulting `RegisteredSynchronizer` contract.
--
--   This is the first rung of the ladder: it only proves that governance can create the
--   registry entry that a later Amulet-funded traffic purchase will read. Buying traffic against a
--   registered synchronizer is exercised in the splice-amulet test (next PR).
module Splice.Scripts.TestRegisterSynchronizer where

import DA.Assert

import Daml.Script

-- The governance action + its argument record.
import Splice.DsoRules
-- The registry contract created by the vote. It lives in splice-amulet (AmuletRules must be
-- able to fetch it), and this test package data-depends on splice-amulet.
import Splice.DecentralizedSynchronizer

-- Shared helpers that spin up a 4-SV network and drive a vote end-to-end.
import Splice.Scripts.DsoTestUtils

-- | Register a dedicated synchronizer via a supermajority SV vote, then verify the registration:
--   signed by the DSO party, naming the operator, and observed by that operator.
test_RegisterSynchronizer_viaVote : Script ()
test_RegisterSynchronizer_viaVote = do
  -- 4-SV network; returns the DSO party and the Super Validators `sv1..sv4`.
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet

  -- The party that will operate the dedicated synchronizer.
  operator <- allocateParty "dedicatedSyncOperator"
  let dedicatedSyncId = "dedicated-sync::1220dededededededededededededededededededededededededededededede"

  -- Supermajority SV vote to register the dedicated synchronizer. `initiateAndAcceptVote` routes
  -- through DsoRules_RequestVote -> DsoRules_CastVote (x3) -> DsoRules_CloseVoteRequest, which on
  -- acceptance calls executeActionRequiringConfirmation, dispatching to DsoRules_RegisterSynchronizer.
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $
    ARC_DsoRules with
      dsoAction = SRARC_RegisterSynchronizer DsoRules_RegisterSynchronizer with
        synchronizerId = dedicatedSyncId
        operator
        governanceParameters = defaultGovernanceParameters

  -- The registration now exists on-ledger with exactly the fields we voted for.
  (_, reg) <- onlyRegistration dso
  reg.dso === dso
  reg.synchronizerId === dedicatedSyncId
  reg.operator === operator
  reg.governanceParameters === defaultGovernanceParameters
  getDiscountFactor reg === 1.0

  -- The operator is an observer, so it can see its own registration.
  operatorView <- query @RegisteredSynchronizer operator
  length operatorView === 1

-- | Register with the governance parameters in the same vote: the registration is live at the
--   agreed discount immediately, with no window at full price and no second vote to arrange.
test_RegisterSynchronizer_withGovernanceParameters : Script ()
test_RegisterSynchronizer_withGovernanceParameters = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet
  operator <- allocateParty "dedicatedSyncOperator"
  let dedicatedSyncId = "dedicated-sync::1220fafafafafafafafafafafafafafafafafafafafafafafafafafafafafafa"

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $
    ARC_DsoRules with
      dsoAction = SRARC_RegisterSynchronizer DsoRules_RegisterSynchronizer with
        synchronizerId = dedicatedSyncId
        operator
        governanceParameters = GovernanceParameters with discountFactor = 0.5

  (_, reg) <- onlyRegistration dso
  reg.synchronizerId === dedicatedSyncId
  reg.operator === operator
  reg.governanceParameters === GovernanceParameters with discountFactor = 0.5
  getDiscountFactor reg === 0.5

-- | Set the governance parameters by vote, then replace them twice. A replacement archives the
--   registration and recreates it, so exactly one is live throughout, and the setter always stores
--   the block, including when a parameter is voted back to its default.
test_SetSynchronizerGovernanceParameters_viaVote : Script ()
test_SetSynchronizerGovernanceParameters_viaVote = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet
  operator <- allocateParty "dedicatedSyncOperator"
  let dedicatedSyncId = "dedicated-sync::1220bebebebebebebebebebebebebebebebebebebebebebebebebebebebebebe"
      svs = [sv1, sv2, sv3, sv4]
      setDiscountTo cid f = initiateAndAcceptVote app svs $
        ARC_DsoRules with
          dsoAction = SRARC_SetSynchronizerGovernanceParameters DsoRules_SetSynchronizerGovernanceParameters with
            registeredSynchronizerCid = cid
            setGovernanceParameters = RegisteredSynchronizer_SetGovernanceParameters with
              newGovernanceParameters = GovernanceParameters with discountFactor = f

  initiateAndAcceptVote app svs $
    ARC_DsoRules with
      dsoAction = SRARC_RegisterSynchronizer DsoRules_RegisterSynchronizer with
        synchronizerId = dedicatedSyncId
        operator
        governanceParameters = defaultGovernanceParameters

  (registeredCid, _) <- onlyRegistration dso
  setDiscountTo registeredCid 0.75
  (discountedCid, discounted) <- onlyRegistration dso
  discounted.governanceParameters === GovernanceParameters with discountFactor = 0.75

  setDiscountTo discountedCid 0.5
  (replacedCid, replaced) <- onlyRegistration dso
  replaced.governanceParameters === GovernanceParameters with discountFactor = 0.5

  -- Voting a parameter back to its default is an ordinary replacement: the block is always present,
  -- so there is no "nothing voted yet" state to fall back to.
  setDiscountTo replacedCid 1.0
  (_, defaulted) <- onlyRegistration dso
  defaulted.governanceParameters === GovernanceParameters with discountFactor = 1.0
  getDiscountFactor defaulted === 1.0

-- | The one live registration, which also asserts that a parameter vote replaced rather than added.
onlyRegistration : Party -> Script (ContractId RegisteredSynchronizer, RegisteredSynchronizer)
onlyRegistration dso = do
  registrations <- query @RegisteredSynchronizer dso
  case registrations of
    [registration] -> pure registration
    _ -> abort $ "expected exactly one RegisteredSynchronizer, got " <> show (length registrations)

-- | Offboard a registered synchronizer via a supermajority vote: the registration is archived,
--   which closes both economic paths (the buy needs the disclosed registration; reward
--   processing requires the live registration - see test_StartProcessing_registrationGate in
--   splice-amulet-test).
test_ArchiveSynchronizerRegistration_viaVote : Script ()
test_ArchiveSynchronizerRegistration_viaVote = do
  (app, _, (sv1, sv2, sv3, sv4)) <- initMainNet
  operator <- allocateParty "dedicatedSyncOperator"
  let dedicatedSyncId = "dedicated-sync::1220acacacacacacacacacacacacacacacacacacacacacacacacacacacacacac"

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $
    ARC_DsoRules with
      dsoAction = SRARC_RegisterSynchronizer DsoRules_RegisterSynchronizer with
        synchronizerId = dedicatedSyncId
        operator
        governanceParameters = defaultGovernanceParameters
  [(regCid, _)] <- query @RegisteredSynchronizer operator

  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $
    ARC_DsoRules with
      dsoAction = SRARC_ArchiveSynchronizerRegistration DsoRules_ArchiveSynchronizerRegistration with
        registeredSynchronizerCid = regCid

  -- the registration is gone: nothing to disclose to a buy, nothing to authorize processing
  [] <- query @RegisteredSynchronizer operator
  pure ()
