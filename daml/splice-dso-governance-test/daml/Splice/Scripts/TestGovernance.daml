    requestCid = requestResult.voteRequest
    amuletRulesCid = None
    sv = Some sv1

  -- only sv1 voted to accept as they created the request
  result.completedAt === now
  result.offboardedVoters === []
  result.abstainingSvs === ["sv2", "sv3", "sv4"]
  result.outcome === VRO_Expired

  return ()



-- Amulet Prices
--------------


unitTestMedian : Script ()
unitTestMedian = do
  median [1.0] === 1.0
  median [2.0, 1.0] === 1.5
  median [3.0, 1.0, 2.0] === 2.0
  median [1.0, 2.0, 3.0, 4.0] === 2.5
  median [1.0, 200.0, 3.0, 4.0, 1000.0] === 4.0


testAmuletPriceVoting : Script ()
testAmuletPriceVoting = do

  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet

  -- run a normal issuance so time advances and the amulet price is set to 1.2 for everybody
  runNextIssuanceD app 1.2 None

  -- have all SV's adjust their prices
  [(dsoRulesCid, _)] <- query @DsoRules dso
  forA_ (zip [1, 2, 3, 4] [sv1, sv2, sv3, sv4]) $ \(amuletPriceInt, sv) -> do
    [(voteCid, _)] <- queryFilter @AmuletPriceVote dso (\vote -> vote.sv == sv)
    submit (actAs sv <> readAs dso) $ exerciseCmd dsoRulesCid DsoRules_UpdateAmuletPriceVote with
      sv
      amuletPrice = intToDecimal amuletPriceInt
      voteCid

  [(voteCid, _)] <- queryFilter @AmuletPriceVote dso (\vote -> vote.sv == sv1)

  -- check that price vote updates fail if the coolodwn period is not over
  submitMustFail (actAs sv1 <> readAs dso) $ exerciseCmd dsoRulesCid DsoRules_UpdateAmuletPriceVote with
    sv = sv1
    amuletPrice = 5.0
    voteCid

  -- pass the cooldown and update the vote again
  passTime (minutes 1)
  submit (actAs sv1 <> readAs dso) $ exerciseCmd dsoRulesCid DsoRules_UpdateAmuletPriceVote with
    sv = sv1
    amuletPrice = 5.0
    voteCid

  [(amuletRulesCid, amuletRules)] <- query @AmuletRules dso
  now <- getTime
  let amuletConfig = Splice.Schedule.getValueAsOf now amuletRules.configSchedule
  passTime (amuletConfig.tickDuration)

  -- pass enough time to advance the open mining round and lock in the price
  [(roundToArchiveCid, _), (middleRoundCid, _), (latestRoundCid, _)] <- sortOn (._2.round) <$> query @OpenMiningRound dso
  amuletPriceVotes <- query @AmuletPriceVote dso
  submit (actAs sv1 <> readAs dso) $ exerciseCmd dsoRulesCid DsoRules_AdvanceOpenMiningRounds with
    amuletRulesCid
    roundToArchiveCid
    middleRoundCid
    latestRoundCid
    amuletPriceVoteCids = map fst amuletPriceVotes
    sv = Some sv1

  -- check that the most recent round has the median a amulet price of the votes
  (_, latestRound) <- (last . sortOn (._2.round)) <$> query @OpenMiningRound dso
  latestRound.amuletPrice === 3.5

  pure ()

testVoteCastingCooldown : Script ()
testVoteCastingCooldown  = do
  (_, dso, (sv1, sv2, _sv3, _sv4)) <- initMainNet

  [(dsoRulesCid, _)] <- query @DsoRules dso

  -- create vote request to use for testing
  result <- submit (actAs sv1 <> readAs dso) $ exerciseCmd dsoRulesCid DsoRules_RequestVote with
    requester = sv1
    action = ARC_DsoRules with
      dsoAction = SRARC_OffboardSv DsoRules_OffboardSv with
        sv = sv2
    reason = Reason with url = ""; body = "they are not good for us!"
    targetEffectiveAt = None
    voteRequestTimeout = Some (days 7) -- give everybody 7 days to vote
  let requestCid = result.voteRequest

  -- SV2 can immediately cast a vote
  result <- submit (actAs sv2 <> readAs dso) $ exerciseCmd dsoRulesCid DsoRules_CastVote with
    requestCid
    vote = Vote with
      sv = sv2
      accept = False
      reason = Reason with url = ""; body = "noooo, let me stay on please!"
      optCastAt = None
  let requestCid = result.voteRequest

  -- The second vote SV2 fails though
  _ <- submitMustFail (actAs sv2 <> readAs dso) $ exerciseCmd dsoRulesCid DsoRules_CastVote with
        requestCid
        vote = Vote with
          sv = sv2
          accept = False
          reason = Reason with url = ""; body = "a better rebuttal"
          optCastAt = None

  -- And that same holds for SV1, as it voted as part of creating the request.
  _ <- submitMustFail (actAs sv1 <> readAs dso) $ exerciseCmd dsoRulesCid DsoRules_CastVote with
        requestCid
        vote = Vote with
          sv = sv1
          accept = True
          reason = Reason with url = ""; body = "a better reason"
          optCastAt = None

  -- let the vote cooldown pass, so they can update their votes
  passTime (minutes 1)

  -- The second vote SV2 fails though
  result <- submit (actAs sv2 <> readAs dso) $ exerciseCmd dsoRulesCid DsoRules_CastVote with
        requestCid
        vote = Vote with
          sv = sv2
          accept = False
          reason = Reason with url = ""; body = "a better rebuttal"
          optCastAt = None
  let requestCid = result.voteRequest

  -- And that same holds for SV1, as it voted as part of creating the request.
  _ <- submit (actAs sv1 <> readAs dso) $ exerciseCmd dsoRulesCid DsoRules_CastVote with
        requestCid
        vote = Vote with
          sv = sv1
          accept = True
          reason = Reason with url = ""; body = "a better reason"
          optCastAt = None

  pure ()

grantFeaturedAppRightForConfigTest : AmuletApp -> [Party] -> Party -> Script (ContractId FeaturedAppRight, FeaturedAppRight)
grantFeaturedAppRightForConfigTest app svs provider = do
  initiateAndAcceptVote app svs $ ARC_DsoRules with
    dsoAction = SRARC_GrantFeaturedAppRight DsoRules_GrantFeaturedAppRight with
      provider
      activityWeight = None
      appKind = None
      opsParties = None
  [right] <- query @FeaturedAppRight provider
  pure right

voteFeaturedAppConfigUpdateInstruction : AmuletApp -> [Party] -> Party -> FeaturedAppConfig -> FeaturedAppConfig -> Script (ContractId FeaturedAppConfigUpdateInstruction)
voteFeaturedAppConfigUpdateInstruction app svs provider baseConfig newConfig = do
  existing <- map fst <$> query @FeaturedAppConfigUpdateInstruction app.dso
  initiateAndAcceptVote app svs $ ARC_DsoRules with
    dsoAction = SRARC_CreateFeaturedAppConfigUpdateInstruction DsoRules_CreateFeaturedAppConfigUpdateInstruction with
      provider
      update = FeaturedAppRight_UpdateConfig with baseConfig; newConfig
      additionalUpdates = []
  instructions <-queryFilter @FeaturedAppConfigUpdateInstruction app.dso (\i -> i.provider == provider)
  [(instructionCid, instruction)] <- pure $ filter (\(cid, _) -> cid `notElem` existing) instructions
  instruction.update.newConfig === newConfig
  pure instructionCid

testFeaturedAppConfigUpdate : Script ()
testFeaturedAppConfigUpdate = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet
  let svs = [sv1, sv2, sv3, sv4]
  provider <- allocateParty "provider"
  otherProvider <- allocateParty "otherProvider"
  ops1 <- allocateParty "ops1"
  ops2 <- allocateParty "ops2"
  (rightCid, right) <- grantFeaturedAppRightForConfigTest app svs provider
  (otherRightCid, _) <- grantFeaturedAppRightForConfigTest app svs otherProvider

  getFeaturedAppConfig right === FeaturedAppConfig with appKind = None; activityWeight = None; opsParties = None

  let baseConfig = getFeaturedAppConfig right
      newConfig = baseConfig with
        appKind = Some FAK_AssetMoving
        activityWeight = Some 2.5
        opsParties = Some [ops1, ops2]
  instructionCid <- voteFeaturedAppConfigUpdateInstruction app svs provider baseConfig newConfig

  -- accepting the vote only records the instruction, the right is unchanged
  [(rightCid', _)] <- query @FeaturedAppRight provider
  rightCid' === rightCid

  -- the instruction cannot be applied to another provider's right
  [(dsoRulesCid, _)] <- query @DsoRules dso
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid DsoRules_ExecuteFeaturedAppConfigUpdateInstruction with
      instructionCid; rightCid = otherRightCid; sv = sv1

  -- any SV can execute it
  _ <- svSubmits app sv3 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExecuteFeaturedAppConfigUpdateInstruction with
      instructionCid; rightCid; sv = sv3

  [(_, updatedRight)] <- query @FeaturedAppRight provider
  getFeaturedAppConfig updatedRight === newConfig
  updatedRight.activityWeight === Some 2.5

  -- the instruction is consumed
  [] <- queryFilter @FeaturedAppConfigUpdateInstruction dso (\i -> i.provider == provider)
  pure ()

testFeaturedAppConfigUpdateMultiple : Script ()
testFeaturedAppConfigUpdateMultiple = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet
  let svs = [sv1, sv2, sv3, sv4]
  provider1 <- allocateParty "provider1"
  provider2 <- allocateParty "provider2"
  provider3 <- allocateParty "provider3"
  (rightCid1, right1) <- grantFeaturedAppRightForConfigTest app svs provider1
  (rightCid2, _) <- grantFeaturedAppRightForConfigTest app svs provider2
  (rightCid3, _) <- grantFeaturedAppRightForConfigTest app svs provider3

  -- a single vote creates one instruction per (provider, update) pair
  let baseConfig = getFeaturedAppConfig right1
      newConfig1 = baseConfig with appKind = Some FAK_Asset
      newConfig2 = baseConfig with activityWeight = Some 2.0
      newConfig3 = baseConfig with appKind = Some FAK_AssetMoving
  initiateAndAcceptVote app svs $ ARC_DsoRules with
    dsoAction = SRARC_CreateFeaturedAppConfigUpdateInstruction DsoRules_CreateFeaturedAppConfigUpdateInstruction with
      provider = provider1
      update = FeaturedAppRight_UpdateConfig with baseConfig; newConfig = newConfig1
      additionalUpdates =
        [ (provider2, FeaturedAppRight_UpdateConfig with baseConfig; newConfig = newConfig2)
        , (provider3, FeaturedAppRight_UpdateConfig with baseConfig; newConfig = newConfig3)
        ]

  let executeFor provider rightCid expectedConfig = do
        [(instructionCid, _)] <- queryFilter @FeaturedAppConfigUpdateInstruction dso (\i -> i.provider == provider)
        _ <- svSubmits app sv1 $ \dsoRulesCid ->
          exerciseCmd dsoRulesCid DsoRules_ExecuteFeaturedAppConfigUpdateInstruction with
            instructionCid; rightCid; sv = sv1
        [(_, updatedRight)] <- query @FeaturedAppRight provider
        getFeaturedAppConfig updatedRight === expectedConfig

  -- each instruction may be executed in any order
  executeFor provider3 rightCid3 newConfig3
  executeFor provider1 rightCid1 newConfig1
  executeFor provider2 rightCid2 newConfig2

  [] <- query @FeaturedAppConfigUpdateInstruction dso
  pure ()

-- The instruction can be expired if SVs are not able to execute it
testFeaturedAppConfigUpdateInstructionExpiry : Script ()
testFeaturedAppConfigUpdateInstructionExpiry = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet
  let svs = [sv1, sv2, sv3, sv4]
  [(dsoRulesCid, dsoRules)] <- query @DsoRules dso

  -- Create wrong instruction where provider does not even have a featured app right
  let baseConfig = FeaturedAppConfig with appKind = None; activityWeight = None; opsParties = None
  instructionCid <- voteFeaturedAppConfigUpdateInstruction app svs dso
    baseConfig (baseConfig with activityWeight = Some 2.0)
  now <- getTime
  Some instruction <- queryContractId dso instructionCid
  instruction.expiresAt === now `addRelTime` dsoRules.config.voteRequestTimeout

  -- cannot be expired before expiresAt
  submitMustFail (actAs sv1 <> readAs dso) $
    exerciseCmd dsoRulesCid DsoRules_ExpireFeaturedAppConfigUpdateInstruction with
      instructionCid; sv = sv1

  passTime dsoRules.config.voteRequestTimeout

  -- only SVs can expire it
  submitMustFail (actAs dso) $
    exerciseCmd dsoRulesCid DsoRules_ExpireFeaturedAppConfigUpdateInstruction with
      instructionCid; sv = dso
  _ <- svSubmits app sv2 $ \dsoRulesCid ->
    exerciseCmd dsoRulesCid DsoRules_ExpireFeaturedAppConfigUpdateInstruction with
      instructionCid; sv = sv2

  [] <- query @FeaturedAppConfigUpdateInstruction dso
  pure ()

testFeaturedAppConfigUpdatePatch : Script ()
testFeaturedAppConfigUpdatePatch = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet
  let svs = [sv1, sv2, sv3, sv4]
  provider <- allocateParty "provider"
  ops <- allocateParty "ops"
  (rightCid, right) <- grantFeaturedAppRightForConfigTest app svs provider

  -- two instructions drafted against the same base config, each changing a different field
  let baseConfig = getFeaturedAppConfig right
  kindInstructionCid <- voteFeaturedAppConfigUpdateInstruction app svs provider
    baseConfig (baseConfig with appKind = Some FAK_Asset)
  opsInstructionCid <- voteFeaturedAppConfigUpdateInstruction app svs provider
    baseConfig (baseConfig with opsParties = Some [ops])

  -- meanwhile the weight changes by another route, after the votes were drafted
  initiateAndAcceptVote app svs $ ARC_DsoRules with
    dsoAction = SRARC_UpdateFeaturedAppRight DsoRules_UpdateFeaturedAppRight with
      rightCid
      update = FeaturedAppRight_Update with reason = "tier 1"; newActivityWeight = 1.5

  let executeInstruction instructionCid = do
        [(currentCid, _)] <- query @FeaturedAppRight provider
        svSubmits app sv1 $ \dsoRulesCid ->
          exerciseCmd dsoRulesCid DsoRules_ExecuteFeaturedAppConfigUpdateInstruction with
            instructionCid; rightCid = currentCid; sv = sv1

  -- executing the instructions applies their changes without reverting each other or the weight
  _ <- executeInstruction kindInstructionCid
  _ <- executeInstruction opsInstructionCid

  [(_, finalRight)] <- query @FeaturedAppRight provider
  getFeaturedAppConfig finalRight === FeaturedAppConfig with
    appKind = Some FAK_Asset
    activityWeight = Some 1.5
    opsParties = Some [ops]

  -- an instruction that changes a field from `Some` to `None` resets it to the default
  let resetBaseConfig = getFeaturedAppConfig finalRight
  resetInstructionCid <- voteFeaturedAppConfigUpdateInstruction app svs provider
    resetBaseConfig (resetBaseConfig with activityWeight = None)
  _ <- executeInstruction resetInstructionCid

  [(_, resetRight)] <- query @FeaturedAppRight provider
  getFeaturedAppConfig resetRight === FeaturedAppConfig with
    appKind = Some FAK_Asset
    activityWeight = None
    opsParties = Some [ops]
  [] <- queryFilter @FeaturedAppConfigUpdateInstruction dso (\i -> i.provider == provider)
  pure ()

testGrantFeaturedAppRightWithConfig : Script ()
testGrantFeaturedAppRightWithConfig = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet
  provider <- allocateParty "provider"
  ops <- allocateParty "ops"
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $ ARC_DsoRules with
    dsoAction = SRARC_GrantFeaturedAppRight DsoRules_GrantFeaturedAppRight with
      provider
      activityWeight = Some 2.0
      appKind = Some FAK_AssetMoving
      opsParties = Some [ops]
  [(_, right)] <- query @FeaturedAppRight provider
  right === FeaturedAppRight with
    dso
    provider
    activityWeight = Some 2.0
    appKind = Some FAK_AssetMoving
    opsParties = Some [ops]
  getFeaturedAppConfig right === FeaturedAppConfig with
    appKind = Some FAK_AssetMoving
    activityWeight = Some 2.0
    opsParties = Some [ops]

  -- granting a right with an invalid config fails when the accepted vote is executed
  [(dsoRulesCid, _)] <- query @DsoRules dso
  [(amuletRulesCid, _)] <- query @AmuletRules dso
  let invalidGrants =
        [ (Some (-1.0), None)
        , (None, Some [ops, ops])
        , (None, Some [ops, provider])
        ]
  forA_ invalidGrants $ \(activityWeight, opsParties) -> do
    requestCid <- initiateAndCastVote app [sv1, sv2, sv3, sv4] None $ ARC_DsoRules with
      dsoAction = SRARC_GrantFeaturedAppRight DsoRules_GrantFeaturedAppRight with
        provider; activityWeight; appKind = None; opsParties
    submitMustFail'' (expectMessageContains "Template precondition violated") (actAs sv1 <> readAs dso) $
      exerciseCmd dsoRulesCid DsoRules_CloseVoteRequest with
        requestCid; amuletRulesCid = Some amuletRulesCid; sv = Some sv1
  [_] <- query @FeaturedAppRight provider
  pure ()
