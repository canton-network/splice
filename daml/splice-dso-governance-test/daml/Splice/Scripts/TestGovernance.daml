  submitMustFail (actAs sv1 <> readAs dso) $ exerciseCmd dsoRulesCid DsoRules_CloseVoteRequest with
    requestCid = requestResult.voteRequest
    amuletRulesCid = None
    sv = Some sv1

  passTime(days 7)
  now <- getTime

  -- close the vote request once the voting period is over
