-- | Instruction contracts recording governance decisions to be applied by any SV against whichever
-- contract is current at execution time.
module Splice.DSO.Instruction where

import DA.Assert (assertDeadlineExceeded)

import Splice.Amulet (FeaturedAppRight_UpdateConfig)
import Splice.Types
import Splice.Util

data FeaturedAppConfigUpdateInstruction_ExpireResult = FeaturedAppConfigUpdateInstruction_ExpireResult
  deriving (Serializable)

-- | A governance-approved change to a FeaturedAppRight config.
template FeaturedAppConfigUpdateInstruction with
    dso : Party
    provider : Party -- ^ Provider whose featured app right should be updated.
    update : FeaturedAppRight_UpdateConfig
    expiresAt : Time
  where
    signatory dso

    choice FeaturedAppConfigUpdateInstruction_Expire : FeaturedAppConfigUpdateInstruction_ExpireResult
      controller dso
      do assertDeadlineExceeded "expiresAt" expiresAt
         return FeaturedAppConfigUpdateInstruction_ExpireResult

instance HasCheckedFetch FeaturedAppConfigUpdateInstruction ForDso where
  contractGroupId FeaturedAppConfigUpdateInstruction {..} = ForDso with dso
