{
  "name": "@canton-network/splice-sv-frontend",
  "version": "0.1.0",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@daml/types": "^3.6.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/x-data-grid": "9.16.0",
    "@mui/x-date-pickers": "^8.14.1",
    "@tanstack/react-form": "^1.33.5",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "jose": "^6.2.12",
    "jsondiffpatch": "^0.7.6",
    "oidc-client-ts": "3.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-intersection-observer": "^11.0.1",
    "react-json-pretty": "2.2.0",
    "react-oidc-context": "3.3.1",
    "sonner": "^2.0.8",
    "uuid": "^14.0.3",
    "web-vitals": "4.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@canton-network/splice-common-test-handlers": "^0.1.0",
    "@canton-network/splice-common-test-utils": "^0.1.0",
    "@canton-network/splice-common-test-vite-utils": "^0.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.6",
    "@types/uuid": "8.3.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^5.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "happy-dom": "^21.0.4",
    "html-format": "^1.1.7",
    "msw": "^2.15.0",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "npm run format:check && npm run lint:check",
    "fix": "npm run format:fix && npm run lint:fix",
    "format:check": "prettier --check -- src",
    "format:fix": "prettier --write -- src",
    "lint:check": "eslint --ignore-pattern src/com/* --max-warnings=0 -- src",
    "lint:fix": "eslint --ignore-pattern src/com/* --fix --max-warnings=0 -- src",
    "type:check": "tsc --noEmit",
    "start": "vite --force",
    "test": "PORT=0 vitest",
    "test:sbt": "PORT=0 vitest --run",
    "copy-msw": "cp ../../common/frontend/public/mockServiceWorker.js public/",
    "dev": "npm run copy-msw && vite --mode testing --force"
  },
  "msw": {
    "workerDirectory": "public"
  }
}
