{
  "name": "@canton-network/splice-common-test-utils",
  "version": "0.1.0",
  "private": true,
  "types": ".lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/node": "26.6.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1"
  },
  "scripts": {
    "build": "tsc",
    "check": "npm run format:check && npm run lint:check",
    "fix": "npm run format:fix && npm run lint:fix",
    "format:check": "prettier --check -- src",
    "format:fix": "prettier --write -- src",
    "lint:check": "eslint --ignore-pattern src/com/* --max-warnings=0 -- src",
    "lint:fix": "eslint --ignore-pattern src/com/* --fix --max-warnings=0 -- src",
    "start": "tsc --watch"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "jose": "^6.2.12",
    "jsondiffpatch": "^0.7.6",
    "msw": "^2.15.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
