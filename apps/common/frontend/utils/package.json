{
  "name": "@canton-network/splice-common-frontend-utils",
  "version": "0.1.0",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@tanstack/react-query": "5.104.5",
    "dompurify": "^3.4.16",
    "jose": "^6.2.12",
    "jsondiffpatch": "^0.7.6",
    "msw": "^3.0.1",
    "uuid": "^14.0.3",
    "web-vitals": "6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./*": "./lib/*.js"
  },
  "main": "lib/index.js",
  "peerDependencies": {
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "private": true,
  "scripts": {
    "build": "tsc",
    "check": "npm run format:check && npm run lint:check",
    "fix": "npm run format:fix && npm run lint:fix",
    "format:check": "prettier --check -- src",
    "format:fix": "prettier --write -- src",
    "lint:check": "eslint --ignore-pattern src/com/* --max-warnings=0 -- src",
    "lint:fix": "eslint --ignore-pattern src/com/* --fix --max-warnings=0 -- src",
    "start": "tsc --watch"
  },
  "types": "lib/index.d.ts"
}
