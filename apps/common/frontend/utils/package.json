{
  "name": "@canton-network/splice-common-frontend-utils",
  "version": "0.1.0",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@tanstack/react-query": "5.104.5",
    "dompurify": "^3.4.16",
    "jose": "^6.2.12",
    "jsondiffpatch": "^0.7.6",
    "msw": "^2.15.0",
    "uuid": "^14.0.3",
    "web-vitals": "4.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/node": "26.6.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./*": "./lib/*.js"
  },
  "main": "lib/index.js",
  "peerDependencies": {
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "private": true,
  "scripts": {
    "build": "tsc",
    "check": "npm run format:check && npm run lint:check",
    "fix": "npm run format:fix && npm run lint:fix",
    "format:check": "prettier --check -- src",
    "format:fix": "prettier --write -- src",
    "lint:check": "eslint --ignore-pattern src/com/* --max-warnings=0 -- src",
    "lint:fix": "eslint --ignore-pattern src/com/* --fix --max-warnings=0 -- src",
    "start": "tsc --watch"
  },
  "types": "lib/index.d.ts"
}
